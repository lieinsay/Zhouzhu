2136 | vec4 voxel_cone_trace(texture3D probe, vec3 cell_size, vec3 pos, vec3 direction, float tan_half_angle, float max_distance, float p_bias) {
2137 | 	float dist = p_bias;
2138 | 	vec4 color = vec4(0.0);
2139 | 
2140 | 	while (dist < max_distance && color.a < 0.95) {
2141 | 		float diameter = max(1.0, 2.0 * tan_half_angle * dist);
2142 | 		vec3 uvw_pos = (pos + dist * direction) * cell_size;
2143 | 		float half_diameter = diameter * 0.5;
2144 | 		
2145 | 		if (any(greaterThan(abs(uvw_pos - 0.5), vec3(0.5f + half_diameter * cell_size)))) {
2146 | 			break;
2147 | 		}
2148 | 		vec4 scolor = textureLod(sampler3D(probe, DEFAULT_SAMPLER_LINEAR_WITH_MIPMAPS_CLAMP), uvw_pos, log2(diameter));
2149 | 		float a = (1.0 - color.a);
2150 | 		color += a * scolor;
2151 | 		dist += half_diameter;
2152 | 	}
2153 | 
2154 | 	return color;
2155 | }
2156 | 
2157 | vec4 voxel_cone_trace_45_degrees(texture3D probe, vec3 cell_size, vec3 pos, vec3 direction, float tan_half_angle, float max_distance, float p_bias) {
2158 | 	float dist = p_bias;
2159 | 	vec4 color = vec4(0.0);
2160 | 	float radius = max(0.5, tan_half_angle * dist);
2161 | 	float lod_level = log2(radius * 2.0);
2162 | 
2163 | 	while (dist < max_distance && color.a < 0.95) {
2164 | 		vec3 uvw_pos = (pos + dist * direction) * cell_size;
2165 | 
2166 | 		
2167 | 		if (any(greaterThan(abs(uvw_pos - 0.5), vec3(0.5f + radius * cell_size)))) {
2168 | 			break;
2169 | 		}
2170 | 		vec4 scolor = textureLod(sampler3D(probe, DEFAULT_SAMPLER_LINEAR_WITH_MIPMAPS_CLAMP), uvw_pos, lod_level);
2171 | 		lod_level += 1.0;
2172 | 
2173 | 		float a = (1.0 - color.a);
2174 | 		scolor *= a;
2175 | 		color += scolor;
2176 | 		dist += radius;
2177 | 		radius = max(0.5, tan_half_angle * dist);
2178 | 	}
2179 | 
2180 | 	return color;
2181 | }
