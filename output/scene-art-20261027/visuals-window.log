2033 | void reflection_process(uint ref_index, vec3 vertex, vec3 ref_vec, vec3 normal, float roughness, vec3 ambient_light, vec3 specular_light, inout vec4 ambient_accum, inout vec4 reflection_accum) {
2034 | 	vec3 box_extents = reflections.data[ref_index].box_extents;
2035 | 	vec3 local_pos = (reflections.data[ref_index].local_matrix * vec4(vertex, 1.0)).xyz;
2036 | 
2037 | 	if (any(greaterThan(abs(local_pos), box_extents))) { 
2038 | 		return;
2039 | 	}
2040 | 
2041 | 	float blend = 1.0;
2042 | 	if (reflections.data[ref_index].blend_distance != 0.0) {
2043 | 		vec3 axis_blend_distance = min(vec3(reflections.data[ref_index].blend_distance), box_extents);
2044 | 		vec3 blend_axes = abs(local_pos) - box_extents + axis_blend_distance;
2045 | 		blend_axes /= axis_blend_distance;
2046 | 		blend_axes = clamp(1.0 - blend_axes, vec3(0.0), vec3(1.0));
2047 | 
2048 | 		blend = pow(blend_axes.x * blend_axes.y * blend_axes.z, 2.0);
2049 | 	}
2050 | 
2051 | 	if (reflections.data[ref_index].intensity > 0.0 && reflection_accum.a < 1.0) { 
2052 | 
2053 | 		vec3 local_ref_vec = (reflections.data[ref_index].local_matrix * vec4(ref_vec, 0.0)).xyz;
2054 | 
2055 | 		if (reflections.data[ref_index].box_project) { 
2056 | 
2057 | 			vec3 nrdir = normalize(local_ref_vec);
2058 | 			vec3 rbmax = (box_extents - local_pos) / nrdir;
2059 | 			vec3 rbmin = (-box_extents - local_pos) / nrdir;
2060 | 
2061 | 			vec3 rbminmax = mix(rbmin, rbmax, greaterThan(nrdir, vec3(0.0, 0.0, 0.0)));
2062 | 
2063 | 			float fa = min(min(rbminmax.x, rbminmax.y), rbminmax.z);
2064 | 			vec3 posonbox = local_pos + nrdir * fa;
2065 | 			local_ref_vec = posonbox - reflections.data[ref_index].box_offset;
2066 | 		}
2067 | 
2068 | 		vec4 reflection;
2069 | 		float reflection_blend = max(0.0, blend - reflection_accum.a);
2070 | 
2071 | 		reflection.rgb = textureLod(samplerCubeArray(reflection_atlas, DEFAULT_SAMPLER_LINEAR_WITH_MIPMAPS_CLAMP), vec4(local_ref_vec, reflections.data[ref_index].index), sqrt(roughness) * MAX_ROUGHNESS_LOD).rgb * sc_luminance_multiplier();
2072 | 		reflection.rgb *= reflections.data[ref_index].exposure_normalization;
2073 | 		reflection.a = reflection_blend;
2074 | 
2075 | 		reflection.rgb *= reflections.data[ref_index].intensity;
2076 | 		reflection.rgb *= reflection.a;
2077 | 
2078 | 		reflection_accum += reflection;
2079 | 	}
2080 | 
2081 | 	if (ambient_accum.a >= 1.0) {
2082 | 		return;
2083 | 	}
2084 | 
2085 | 	switch (reflections.data[ref_index].ambient_mode) {
2086 | 		case REFLECTION_AMBIENT_DISABLED: {
2087 | 			
2088 | 		} break;
2089 | 		case REFLECTION_AMBIENT_ENVIRONMENT: {
2090 | 			vec3 local_amb_vec = (reflections.data[ref_index].local_matrix * vec4(normal, 0.0)).xyz;
2091 | 			vec4 ambient_out;
2092 | 			float ambient_blend = max(0.0, blend - ambient_accum.a);
2093 | 
2094 | 			ambient_out.rgb = textureLod(samplerCubeArray(reflection_atlas, DEFAULT_SAMPLER_LINEAR_WITH_MIPMAPS_CLAMP), vec4(local_amb_vec, reflections.data[ref_index].index), MAX_ROUGHNESS_LOD).rgb;
2095 | 			ambient_out.rgb *= reflections.data[ref_index].exposure_normalization;
2096 | 			ambient_out.a = ambient_blend;
2097 | 			ambient_out.rgb *= ambient_out.a;
2098 | 			ambient_accum += ambient_out;
2099 | 		} break;
2100 | 		case REFLECTION_AMBIENT_COLOR: {
2101 | 			vec4 ambient_out;
2102 | 			float ambient_blend = max(0.0, blend - ambient_accum.a);
2103 | 
2104 | 			ambient_out.rgb = reflections.data[ref_index].ambient;
2105 | 			ambient_out.a = ambient_blend;
2106 | 			ambient_out.rgb *= ambient_out.a;
2107 | 			ambient_accum += ambient_out;
2108 | 		} break;
2109 | 	}
2110 | }
