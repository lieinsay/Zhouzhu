 663 | vec4 normal_roughness_compatibility(vec4 p_normal_roughness) {
 664 | 	float roughness = p_normal_roughness.w;
 665 | 	if (roughness > 0.5) {
 666 | 		roughness = 1.0 - roughness;
 667 | 	}
 668 | 	roughness /= (127.0 / 255.0);
 669 | 	return vec4(normalize(p_normal_roughness.xyz * 2.0 - 1.0) * 0.5 + 0.5, roughness);
 670 | }
