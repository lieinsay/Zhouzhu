1085 | float compute_alpha_hash_threshold(vec3 pos, float hash_scale) {
1086 | 	vec3 dx = dFdx(pos);
1087 | 	vec3 dy = dFdy(pos);
1088 | 
1089 | 	float delta_max_sqr = max(length(dx), length(dy));
1090 | 	float pix_scale = 1.0 / (hash_scale * delta_max_sqr);
1091 | 
1092 | 	vec2 pix_scales =
1093 | 			vec2(exp2(floor(log2(pix_scale))), exp2(ceil(log2(pix_scale))));
1094 | 
1095 | 	vec2 a_thresh = vec2(hash_3d(floor(pix_scales.x * pos.xyz)),
1096 | 			hash_3d(floor(pix_scales.y * pos.xyz)));
1097 | 
1098 | 	float lerp_factor = fract(log2(pix_scale));
1099 | 
1100 | 	float a_interp = (1.0 - lerp_factor) * a_thresh.x + lerp_factor * a_thresh.y;
1101 | 
1102 | 	float min_lerp = min(lerp_factor, 1.0 - lerp_factor);
1103 | 
1104 | 	vec3 cases = vec3(a_interp * a_interp / (2.0 * min_lerp * (1.0 - min_lerp)),
1105 | 			(a_interp - 0.5 * min_lerp) / (1.0 - min_lerp),
1106 | 			1.0 - ((1.0 - a_interp) * (1.0 - a_interp) / (2.0 * min_lerp * (1.0 - min_lerp))));
1107 | 
1108 | 	float alpha_hash_threshold =
1109 | 			(a_interp < (1.0 - min_lerp)) ? ((a_interp < min_lerp) ? cases.x : cases.y) : cases.z;
1110 | 
1111 | 	return clamp(alpha_hash_threshold, 0.00001, 1.0);
