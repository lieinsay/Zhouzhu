1372 | #endif
1373 | 		}
1374 | 
1375 | #ifdef USE_SHADOW_TO_OPACITY
1376 | 		alpha = min(alpha, clamp(1.0 - attenuation, 0.0, 1.0));
1377 | #endif
1378 | 	}
1379 | #endif 
