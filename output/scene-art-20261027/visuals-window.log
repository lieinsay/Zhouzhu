2031 | void reflection_process(uint ref_index, vec3 vertex, vec3 ref_vec, vec3 normal, float roughness, vec3 ambient_light, vec3 specular_light, inout vec4 ambient_accum, inout vec4 reflection_accum) {
2032 | 	vec3 box_extents = reflections.data[ref_index].box_extents;
2033 | 	vec3 local_pos = (reflections.data[ref_index].local_matrix * vec4(vertex, 1.0)).xyz;
2034 | 
2035 | 	if (any(greaterThan(abs(local_pos), box_extents))) { 
2036 | 		return;
2037 | 	}
2038 | 
2039 | 	float blend = 1.0;
2040 | 	if (reflections.data[ref_index].blend_distance != 0.0) {
2041 | 		vec3 axis_blend_distance = min(vec3(reflections.data[ref_index].blend_distance), box_extents);
2042 | 		vec3 blend_axes = abs(local_pos) - box_extents + axis_blend_distance;
2043 | 		blend_axes /= axis_blend_distance;
