1546 | void light_process_omni(uint idx, vec3 vertex, vec3 eye_vec, vec3 normal, vec3 vertex_ddx, vec3 vertex_ddy, vec3 f0, uint orms, float taa_frame_count, vec3 albedo, inout float alpha, vec2 screen_uv,
1547 | #ifdef LIGHT_BACKLIGHT_USED
1548 | 		vec3 backlight,
1549 | #endif
1550 | #ifdef LIGHT_TRANSMITTANCE_USED
1551 | 		vec4 transmittance_color,
1552 | 		float transmittance_depth,
1553 | 		float transmittance_boost,
