1345 | #elif defined(SPECULAR_DISABLED)
1346 | 			
1347 | 
1348 | #elif defined(SPECULAR_SCHLICK_GGX)
1349 | 			
1350 | 			float alpha_ggx = roughness * roughness;
1351 | #if defined(LIGHT_ANISOTROPY_USED)
1352 | 			float aspect = sqrt(1.0 - anisotropy * 0.9);
1353 | 			float ax = alpha_ggx / aspect;
1354 | 			float ay = alpha_ggx * aspect;
1355 | 			float XdotH = dot(T, H);
1356 | 			float YdotH = dot(B, H);
1357 | 			float D = D_GGX_anisotropic(cNdotH, ax, ay, XdotH, YdotH);
