1217 | #if defined(LIGHT_CODE_USED)
1218 | 	
1219 | 	mat4 inv_view_matrix = scene_data_block.data.inv_view_matrix;
1220 | 	mat4 read_view_matrix = scene_data_block.data.view_matrix;
1221 | 
1222 | #ifdef USING_MOBILE_RENDERER
1223 | 	mat4 read_model_matrix = instances.data[draw_call.instance_index].transform;
1224 | #else
1225 | 	mat4 read_model_matrix = instances.data[instance_index_interp].transform;
1226 | #endif
1227 | 
1228 | #undef projection_matrix
1229 | #define projection_matrix scene_data_block.data.projection_matrix
1230 | #undef inv_projection_matrix
1231 | #define inv_projection_matrix scene_data_block.data.inv_projection_matrix
1232 | 
1233 | 	vec2 read_viewport_size = scene_data_block.data.viewport_size;
1234 | 	vec3 normal = N;
1235 | 	vec3 light = L;
1236 | 	vec3 view = V;
1237 | 
1238 | #else 
1239 | 	float NdotL = min(A + dot(N, L), 1.0);
1240 | 	float cNdotV = max(dot(N, V), 1e-4);
1241 | 
1242 | #ifdef LIGHT_TRANSMITTANCE_USED
1243 | 	{
1244 | #ifdef SSS_MODE_SKIN
1245 | 		float scale = 8.25 / transmittance_depth;
1246 | 		float d = scale * abs(transmittance_z);
1247 | 		float dd = -d * d;
1248 | 		vec3 profile = vec3(0.233, 0.455, 0.649) * exp(dd / 0.0064) +
1249 | 				vec3(0.1, 0.336, 0.344) * exp(dd / 0.0484) +
1250 | 				vec3(0.118, 0.198, 0.0) * exp(dd / 0.187) +
1251 | 				vec3(0.113, 0.007, 0.007) * exp(dd / 0.567) +
1252 | 				vec3(0.358, 0.004, 0.0) * exp(dd / 1.99) +
1253 | 				vec3(0.078, 0.0, 0.0) * exp(dd / 7.41);
1254 | 
1255 | 		diffuse_light += profile * transmittance_color.a * light_color * clamp(transmittance_boost - NdotL, 0.0, 1.0) * (1.0 / M_PI);
1256 | #else
1257 | 
1258 | 		float scale = 8.25 / transmittance_depth;
1259 | 		float d = scale * abs(transmittance_z);
1260 | 		float dd = -d * d;
1261 | 		diffuse_light += exp(dd) * transmittance_color.rgb * transmittance_color.a * light_color * clamp(transmittance_boost - NdotL, 0.0, 1.0) * (1.0 / M_PI);
1262 | #endif
1263 | 	}
1264 | #endif 
1265 | 
1266 | #if defined(LIGHT_RIM_USED)
1267 | 	
1268 | 	float rim_light = pow(max(1e-4, 1.0 - cNdotV), max(0.0, (1.0 - roughness) * 16.0));
1269 | 	diffuse_light += rim_light * rim * mix(vec3(1.0), albedo, rim_tint) * light_color;
1270 | #endif
1271 | 
1272 | 	
1273 | 	const float EPSILON = 1e-6f;
1274 | 	if (is_directional || attenuation > EPSILON) {
1275 | 		float cNdotL = max(NdotL, 0.0);
1276 | #if defined(DIFFUSE_BURLEY) || defined(SPECULAR_SCHLICK_GGX) || defined(LIGHT_CLEARCOAT_USED)
1277 | 		vec3 H = normalize(V + L);
1278 | #endif
1279 | #if defined(DIFFUSE_BURLEY) || defined(SPECULAR_SCHLICK_GGX) || defined(LIGHT_CLEARCOAT_USED)
1280 | 		float cLdotH = clamp(A + dot(L, H), 0.0, 1.0);
1281 | #endif
1282 | #if defined(LIGHT_CLEARCOAT_USED)
1283 | 		
1284 | 		float ccNdotL = max(min(A + dot(vertex_normal, L), 1.0), 0.0);
1285 | 		float ccNdotH = clamp(A + dot(vertex_normal, H), 0.0, 1.0);
