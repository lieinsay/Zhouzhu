 721 | float w0(float a) {
 722 | 	return (1.0 / 6.0) * (a * (a * (-a + 3.0) - 3.0) + 1.0);
 723 | }
 724 | 
 725 | float w1(float a) {
 726 | 	return (1.0 / 6.0) * (a * a * (3.0 * a - 6.0) + 4.0);
 727 | }
 728 | 
 729 | float w2(float a) {
 730 | 	return (1.0 / 6.0) * (a * (a * (-3.0 * a + 3.0) + 3.0) + 1.0);
 731 | }
 732 | 
 733 | float w3(float a) {
 734 | 	return (1.0 / 6.0) * (a * a * a);
 735 | }
 736 | 
 737 | 
 738 | float g0(float a) {
 739 | 	return w0(a) + w1(a);
 740 | }
 741 | 
 742 | float g1(float a) {
 743 | 	return w2(a) + w3(a);
 744 | }
 745 | 
 746 | 
 747 | float h0(float a) {
 748 | 	return -1.0 + w1(a) / (w0(a) + w1(a));
 749 | }
 750 | 
 751 | float h1(float a) {
 752 | 	return 1.0 + w3(a) / (w2(a) + w3(a));
 753 | }
 754 | 
 755 | vec4 textureArray_bicubic(texture2DArray tex, vec3 uv, vec2 texture_size) {
 756 | 	vec2 texel_size = vec2(1.0) / texture_size;
 757 | 
 758 | 	uv.xy = uv.xy * texture_size + vec2(0.5);
 759 | 
 760 | 	vec2 iuv = floor(uv.xy);
 761 | 	vec2 fuv = fract(uv.xy);
 762 | 
 763 | 	float g0x = g0(fuv.x);
 764 | 	float g1x = g1(fuv.x);
 765 | 	float h0x = h0(fuv.x);
 766 | 	float h1x = h1(fuv.x);
 767 | 	float h0y = h0(fuv.y);
 768 | 	float h1y = h1(fuv.y);
 769 | 
 770 | 	vec2 p0 = (vec2(iuv.x + h0x, iuv.y + h0y) - vec2(0.5)) * texel_size;
 771 | 	vec2 p1 = (vec2(iuv.x + h1x, iuv.y + h0y) - vec2(0.5)) * texel_size;
 772 | 	vec2 p2 = (vec2(iuv.x + h0x, iuv.y + h1y) - vec2(0.5)) * texel_size;
 773 | 	vec2 p3 = (vec2(iuv.x + h1x, iuv.y + h1y) - vec2(0.5)) * texel_size;
 774 | 
 775 | 	return (g0(fuv.y) * (g0x * texture(sampler2DArray(tex, SAMPLER_LINEAR_CLAMP), vec3(p0, uv.z)) + g1x * texture(sampler2DArray(tex, SAMPLER_LINEAR_CLAMP), vec3(p1, uv.z)))) +
 776 | 			(g1(fuv.y) * (g0x * texture(sampler2DArray(tex, SAMPLER_LINEAR_CLAMP), vec3(p2, uv.z)) + g1x * texture(sampler2DArray(tex, SAMPLER_LINEAR_CLAMP), vec3(p3, uv.z))));
 777 | }
 778 | #endif 
