2181 | void voxel_gi_compute(uint index, vec3 position, vec3 normal, vec3 ref_vec, mat3 normal_xform, float roughness, vec3 ambient, vec3 environment, inout vec4 out_spec, inout vec4 out_diff) {
2182 | 	position = (voxel_gi_instances.data[index].xform * vec4(position, 1.0)).xyz;
2183 | 	ref_vec = normalize((voxel_gi_instances.data[index].xform * vec4(ref_vec, 0.0)).xyz);
2184 | 	normal = normalize((voxel_gi_instances.data[index].xform * vec4(normal, 0.0)).xyz);
2185 | 
2186 | 	position += normal * voxel_gi_instances.data[index].normal_bias;
2187 | 
2188 | 	
2189 | 	if (any(bvec2(any(lessThan(position, vec3(0.0))), any(greaterThan(position, voxel_gi_instances.data[index].bounds))))) {
2190 | 		return;
