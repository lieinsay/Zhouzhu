 664 | vec4 normal_roughness_compatibility(vec4 p_normal_roughness) {
 665 | 	float roughness = p_normal_roughness.w;
 666 | 	if (roughness > 0.5) {
 667 | 		roughness = 1.0 - roughness;
 668 | 	}
 669 | 	roughness /= (127.0 / 255.0);
 670 | 	return vec4(normalize(p_normal_roughness.xyz * 2.0 - 1.0) * 0.5 + 0.5, roughness);
 671 | }
