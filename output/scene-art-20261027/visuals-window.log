1685 | 			} else {
1686 | 				
1687 | 				shadow = 1.0;
1688 | 			}
1689 | 		} else {
1690 | 			vec4 uv_rect = base_uv_rect;
1691 | 
1692 | 			vec3 shadow_sample = normalize(shadow_dir + normal_bias);
1693 | 			if (shadow_sample.z >= 0.0) {
