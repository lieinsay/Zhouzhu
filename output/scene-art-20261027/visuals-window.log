2421 | 		float fog_quad_amount = pow(fog_z, scene_data_block.data.fog_depth_curve) * scene_data_block.data.fog_density;
2422 | 		fog_amount = fog_quad_amount;
2423 | 	} else {
2424 | 		fog_amount = 1 - exp(min(0.0, -length(vertex) * scene_data_block.data.fog_density));
2425 | 	}
2426 | 
2427 | 	if (abs(scene_data_block.data.fog_height_density) >= 0.0001) {
2428 | 		float y = (scene_data_block.data.inv_view_matrix * vec4(vertex, 1.0)).y;
2429 | 
2430 | 		float y_dist = y - scene_data_block.data.fog_height;
2431 | 
2432 | 		float vfog_amount = 1.0 - exp(min(0.0, y_dist * scene_data_block.data.fog_height_density));
2433 | 
2434 | 		fog_amount = max(vfog_amount, fog_amount);
2435 | 	}
2436 | 
2437 | 	return vec4(fog_color, fog_amount);
2438 | }
