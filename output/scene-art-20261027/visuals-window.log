2409 | 
2410 | 		for (uint i = 0; i < scene_data_block.data.directional_light_count; i++) {
2411 | 			vec3 light_color = directional_lights.data[i].color * directional_lights.data[i].energy;
2412 | 			float light_amount = pow(max(dot(view, directional_lights.data[i].direction), 0.0), 8.0);
2413 | 			fog_color += light_color * light_amount * scene_data_block.data.fog_sun_scatter;
