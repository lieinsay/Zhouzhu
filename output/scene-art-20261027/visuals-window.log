1536 | float get_omni_attenuation(float distance, float inv_range, float decay) {
1537 | 	float nd = distance * inv_range;
1538 | 	nd *= nd;
1539 | 	nd *= nd; 
1540 | 	nd = max(1.0 - nd, 0.0);
1541 | 	nd *= nd; 
1542 | 	return nd * pow(max(distance, 0.0001), -decay);
1543 | }
