1082 | float compute_alpha_hash_threshold(vec3 pos, float hash_scale) {
1083 | 	vec3 dx = dFdx(pos);
1084 | 	vec3 dy = dFdy(pos);
1085 | 
1086 | 	float delta_max_sqr = max(length(dx), length(dy));
1087 | 	float pix_scale = 1.0 / (hash_scale * delta_max_sqr);
1088 | 
1089 | 	vec2 pix_scales =
1090 | 			vec2(exp2(floor(log2(pix_scale))), exp2(ceil(log2(pix_scale))));
1091 | 
1092 | 	vec2 a_thresh = vec2(hash_3d(floor(pix_scales.x * pos.xyz)),
1093 | 			hash_3d(floor(pix_scales.y * pos.xyz)));
1094 | 
1095 | 	float lerp_factor = fract(log2(pix_scale));
1096 | 
1097 | 	float a_interp = (1.0 - lerp_factor) * a_thresh.x + lerp_factor * a_thresh.y;
1098 | 
1099 | 	float min_lerp = min(lerp_factor, 1.0 - lerp_factor);
1100 | 
1101 | 	vec3 cases = vec3(a_interp * a_interp / (2.0 * min_lerp * (1.0 - min_lerp)),
1102 | 			(a_interp - 0.5 * min_lerp) / (1.0 - min_lerp),
1103 | 			1.0 - ((1.0 - a_interp) * (1.0 - a_interp) / (2.0 * min_lerp * (1.0 - min_lerp))));
1104 | 
1105 | 	float alpha_hash_threshold =
1106 | 			(a_interp < (1.0 - min_lerp)) ? ((a_interp < min_lerp) ? cases.x : cases.y) : cases.z;
1107 | 
1108 | 	return clamp(alpha_hash_threshold, 0.00001, 1.0);
1109 | }
1110 | 
1111 | #endif 
1112 | 
1113 | #ifdef ALPHA_ANTIALIASING_EDGE_USED
1114 | 
1115 | float calc_mip_level(vec2 texture_coord) {
1116 | 	vec2 dx = dFdx(texture_coord);
1117 | 	vec2 dy = dFdy(texture_coord);
1118 | 	float delta_max_sqr = max(dot(dx, dx), dot(dy, dy));
1119 | 	return max(0.0, 0.5 * log2(delta_max_sqr));
1120 | }
1121 | 
1122 | float compute_alpha_antialiasing_edge(float input_alpha, vec2 texture_coord, float alpha_edge) {
1123 | 	input_alpha *= 1.0 + max(0, calc_mip_level(texture_coord)) * 0.25; 
1124 | 	input_alpha = (input_alpha - alpha_edge) / max(fwidth(input_alpha), 0.0001) + 0.5;
1125 | 	return clamp(input_alpha, 0.0, 1.0);
1126 | }
1127 | 
1128 | #endif 
