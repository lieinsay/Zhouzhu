2241 | vec2 octahedron_wrap(vec2 v) {
2242 | 	vec2 signVal;
2243 | 	signVal.x = v.x >= 0.0 ? 1.0 : -1.0;
2244 | 	signVal.y = v.y >= 0.0 ? 1.0 : -1.0;
2245 | 	return (1.0 - abs(v.yx)) * signVal;
2246 | }
2247 | 
2248 | vec2 octahedron_encode(vec3 n) {
2249 | 	
2250 | 	n /= (abs(n.x) + abs(n.y) + abs(n.z));
2251 | 	n.xy = n.z >= 0.0 ? n.xy : octahedron_wrap(n.xy);
2252 | 	n.xy = n.xy * 0.5 + 0.5;
2253 | 	return n.xy;
2254 | }
