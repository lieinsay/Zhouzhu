1423 | 	mat2 disk_rotation;
1424 | 	{
1425 | 		float r = quick_hash(gl_FragCoord.xy + vec2(taa_frame_count * 5.588238)) * 2.0 * M_PI;
1426 | 		float sr = sin(r);
1427 | 		float cr = cos(r);
1428 | 		disk_rotation = mat2(vec2(cr, -sr), vec2(sr, cr));
1429 | 	}
1430 | 
1431 | 	float avg = 0.0;
1432 | 
1433 | 	SPEC_CONSTANT_LOOP_ANNOTATION
1434 | 	for (uint i = 0; i < sc_soft_shadow_samples(); i++) {
1435 | 		avg += textureProj(sampler2DShadow(shadow, shadow_sampler), vec4(pos + shadow_pixel_size * (disk_rotation * scene_data_block.data.soft_shadow_kernel[i].xy), depth, 1.0));
1436 | 	}
