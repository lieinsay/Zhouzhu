2238 | vec2 octahedron_wrap(vec2 v) {
2239 | 	vec2 signVal;
2240 | 	signVal.x = v.x >= 0.0 ? 1.0 : -1.0;
2241 | 	signVal.y = v.y >= 0.0 ? 1.0 : -1.0;
2242 | 	return (1.0 - abs(v.yx)) * signVal;
2243 | }
2244 | 
2245 | vec2 octahedron_encode(vec3 n) {
2246 | 	
2247 | 	n /= (abs(n.x) + abs(n.y) + abs(n.z));
2248 | 	n.xy = n.z >= 0.0 ? n.xy : octahedron_wrap(n.xy);
2249 | 	n.xy = n.xy * 0.5 + 0.5;
2250 | 	return n.xy;
2251 | }
