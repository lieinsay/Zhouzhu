1489 | float sample_directional_soft_shadow(texture2D shadow, vec3 pssm_coord, vec2 tex_scale, float taa_frame_count) {
1490 | 	
1491 | 	float blocker_count = 0.0;
1492 | 	float blocker_average = 0.0;
1493 | 
1494 | 	mat2 disk_rotation;
1495 | 	{
1496 | 		float r = quick_hash(gl_FragCoord.xy + vec2(taa_frame_count * 5.588238)) * 2.0 * M_PI;
1497 | 		float sr = sin(r);
1498 | 		float cr = cos(r);
1499 | 		disk_rotation = mat2(vec2(cr, -sr), vec2(sr, cr));
1500 | 	}
1501 | 
1502 | 	SPEC_CONSTANT_LOOP_ANNOTATION
1503 | 	for (uint i = 0; i < sc_directional_penumbra_shadow_samples(); i++) {
1504 | 		vec2 suv = pssm_coord.xy + (disk_rotation * scene_data_block.data.directional_penumbra_shadow_kernel[i].xy) * tex_scale;
1505 | 		float d = textureLod(sampler2D(shadow, SAMPLER_LINEAR_CLAMP), suv, 0.0).r;
1506 | 		if (d > pssm_coord.z) {
1507 | 			blocker_average += d;
1508 | 			blocker_count += 1.0;
1509 | 		}
1510 | 	}
1511 | 
1512 | 	if (blocker_count > 0.0) {
1513 | 		
1514 | 		blocker_average /= blocker_count;
1515 | 		float penumbra = (-pssm_coord.z + blocker_average) / (1.0 - blocker_average);
1516 | 		tex_scale *= penumbra;
1517 | 
1518 | 		float s = 0.0;
1519 | 
1520 | 		SPEC_CONSTANT_LOOP_ANNOTATION
1521 | 		for (uint i = 0; i < sc_directional_penumbra_shadow_samples(); i++) {
1522 | 			vec2 suv = pssm_coord.xy + (disk_rotation * scene_data_block.data.directional_penumbra_shadow_kernel[i].xy) * tex_scale;
1523 | 			s += textureProj(sampler2DShadow(shadow, shadow_sampler), vec4(suv, pssm_coord.z, 1.0));
1524 | 		}
1525 | 
1526 | 		return s / float(sc_directional_penumbra_shadow_samples());
1527 | 
1528 | 	} else {
1529 | 		
1530 | 		return 1.0;
1531 | 	}
1532 | }
1533 | 
