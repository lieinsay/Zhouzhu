 758 | vec4 textureArray_bicubic(texture2DArray tex, vec3 uv, vec2 texture_size) {
 759 | 	vec2 texel_size = vec2(1.0) / texture_size;
 760 | 
 761 | 	uv.xy = uv.xy * texture_size + vec2(0.5);
 762 | 
 763 | 	vec2 iuv = floor(uv.xy);
 764 | 	vec2 fuv = fract(uv.xy);
 765 | 
 766 | 	float g0x = g0(fuv.x);
 767 | 	float g1x = g1(fuv.x);
 768 | 	float h0x = h0(fuv.x);
 769 | 	float h1x = h1(fuv.x);
 770 | 	float h0y = h0(fuv.y);
 771 | 	float h1y = h1(fuv.y);
 772 | 
 773 | 	vec2 p0 = (vec2(iuv.x + h0x, iuv.y + h0y) - vec2(0.5)) * texel_size;
 774 | 	vec2 p1 = (vec2(iuv.x + h1x, iuv.y + h0y) - vec2(0.5)) * texel_size;
 775 | 	vec2 p2 = (vec2(iuv.x + h0x, iuv.y + h1y) - vec2(0.5)) * texel_size;
 776 | 	vec2 p3 = (vec2(iuv.x + h1x, iuv.y + h1y) - vec2(0.5)) * texel_size;
 777 | 
 778 | 	return (g0(fuv.y) * (g0x * texture(sampler2DArray(tex, SAMPLER_LINEAR_CLAMP), vec3(p0, uv.z)) + g1x * texture(sampler2DArray(tex, SAMPLER_LINEAR_CLAMP), vec3(p1, uv.z)))) +
 779 | 			(g1(fuv.y) * (g0x * texture(sampler2DArray(tex, SAMPLER_LINEAR_CLAMP), vec3(p2, uv.z)) + g1x * texture(sampler2DArray(tex, SAMPLER_LINEAR_CLAMP), vec3(p3, uv.z))));
