1583 | 		base_uv_rect.xy += texel_size;
1584 | 		base_uv_rect.zw -= texel_size * 2.0;
1585 | 
1586 | 		
1587 | 		vec2 flip_offset = omni_lights.data[idx].direction.xy;
1588 | 
