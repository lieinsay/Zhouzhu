1437 | 	SPEC_CONSTANT_LOOP_ANNOTATION
1438 | 	for (uint i = 0; i < sc_soft_shadow_samples(); i++) {
1439 | 		avg += textureProj(sampler2DShadow(shadow, shadow_sampler), vec4(pos + shadow_pixel_size * (disk_rotation * scene_data_block.data.soft_shadow_kernel[i].xy), depth, 1.0));
