2135 | vec4 voxel_cone_trace(texture3D probe, vec3 cell_size, vec3 pos, vec3 direction, float tan_half_angle, float max_distance, float p_bias) {
2136 | 	float dist = p_bias;
2137 | 	vec4 color = vec4(0.0);
2138 | 
2139 | 	while (dist < max_distance && color.a < 0.95) {
2140 | 		float diameter = max(1.0, 2.0 * tan_half_angle * dist);
2141 | 		vec3 uvw_pos = (pos + dist * direction) * cell_size;
2142 | 		float half_diameter = diameter * 0.5;
2143 | 		
2144 | 		if (any(greaterThan(abs(uvw_pos - 0.5), vec3(0.5f + half_diameter * cell_size)))) {
2145 | 			break;
2146 | 		}
2147 | 		vec4 scolor = textureLod(sampler3D(probe, DEFAULT_SAMPLER_LINEAR_WITH_MIPMAPS_CLAMP), uvw_pos, log2(diameter));
2148 | 		float a = (1.0 - color.a);
2149 | 		color += a * scolor;
2150 | 		dist += half_diameter;
2151 | 	}
2152 | 
2153 | 	return color;
2154 | }
2155 | 
2156 | vec4 voxel_cone_trace_45_degrees(texture3D probe, vec3 cell_size, vec3 pos, vec3 direction, float tan_half_angle, float max_distance, float p_bias) {
2157 | 	float dist = p_bias;
2158 | 	vec4 color = vec4(0.0);
2159 | 	float radius = max(0.5, tan_half_angle * dist);
2160 | 	float lod_level = log2(radius * 2.0);
2161 | 
2162 | 	while (dist < max_distance && color.a < 0.95) {
2163 | 		vec3 uvw_pos = (pos + dist * direction) * cell_size;
2164 | 
2165 | 		
2166 | 		if (any(greaterThan(abs(uvw_pos - 0.5), vec3(0.5f + radius * cell_size)))) {
2167 | 			break;
2168 | 		}
2169 | 		vec4 scolor = textureLod(sampler3D(probe, DEFAULT_SAMPLER_LINEAR_WITH_MIPMAPS_CLAMP), uvw_pos, lod_level);
2170 | 		lod_level += 1.0;
2171 | 
2172 | 		float a = (1.0 - color.a);
2173 | 		scolor *= a;
2174 | 		color += scolor;
2175 | 		dist += radius;
2176 | 		radius = max(0.5, tan_half_angle * dist);
2177 | 	}
2178 | 
2179 | 	return color;
2180 | }
