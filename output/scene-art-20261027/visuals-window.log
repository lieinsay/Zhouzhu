1152 | 
1153 | float D_GGX(float cos_theta_m, float alpha) {
1154 | 	float a = cos_theta_m * alpha;
1155 | 	float k = alpha / (1.0 - cos_theta_m * cos_theta_m + a * a);
1156 | 	return k * k * (1.0 / M_PI);
1157 | }
1158 | 
1159 | 
1160 | float V_GGX(float NdotL, float NdotV, float alpha) {
1161 | 	return 0.5 / mix(2.0 * NdotL * NdotV, NdotL + NdotV, alpha);
1162 | }
1163 | 
1164 | float D_GGX_anisotropic(float cos_theta_m, float alpha_x, float alpha_y, float cos_phi, float sin_phi) {
1165 | 	float alpha2 = alpha_x * alpha_y;
1166 | 	highp vec3 v = vec3(alpha_y * cos_phi, alpha_x * sin_phi, alpha2 * cos_theta_m);
1167 | 	highp float v2 = dot(v, v);
1168 | 	float w2 = alpha2 / v2;
1169 | 	float D = alpha2 * w2 * w2 * (1.0 / M_PI);
1170 | 	return D;
1171 | }
1172 | 
1173 | float V_GGX_anisotropic(float alpha_x, float alpha_y, float TdotV, float TdotL, float BdotV, float BdotL, float NdotV, float NdotL) {
1174 | 	float Lambda_V = NdotL * length(vec3(alpha_x * TdotV, alpha_y * BdotV, NdotV));
1175 | 	float Lambda_L = NdotV * length(vec3(alpha_x * TdotL, alpha_y * BdotL, NdotL));
1176 | 	return 0.5 / (Lambda_V + Lambda_L);
1177 | }
1178 | 
1179 | float SchlickFresnel(float u) {
1180 | 	float m = 1.0 - u;
1181 | 	float m2 = m * m;
1182 | 	return m2 * m2 * m; 
1183 | }
1184 | 
1185 | vec3 F0(float metallic, float specular, vec3 albedo) {
1186 | 	float dielectric = 0.16 * specular * specular;
1187 | 	
1188 | 	
1189 | 	return mix(vec3(dielectric), albedo, vec3(metallic));
1190 | }
