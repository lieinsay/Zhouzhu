2195 | 	
2196 | 
2197 | 	float max_distance = length(voxel_gi_instances.data[index].bounds);
2198 | 	vec3 cell_size = 1.0 / voxel_gi_instances.data[index].bounds;
2199 | 
2200 | 	
2201 | 
2202 | #define MAX_CONE_DIRS 4
2203 | 
2204 | 	vec3 cone_dirs[MAX_CONE_DIRS] = vec3[](
2205 | 			vec3(0.707107, 0.0, 0.707107),
2206 | 			vec3(0.0, 0.707107, 0.707107),
2207 | 			vec3(-0.707107, 0.0, 0.707107),
2208 | 			vec3(0.0, -0.707107, 0.707107));
2209 | 
2210 | 	float cone_weights[MAX_CONE_DIRS] = float[](0.25, 0.25, 0.25, 0.25);
2211 | 	float cone_angle_tan = 0.98269;
2212 | 
2213 | 	vec3 light = vec3(0.0);
2214 | 
2215 | 	for (int i = 0; i < MAX_CONE_DIRS; i++) {
2216 | 		vec3 dir = normalize((voxel_gi_instances.data[index].xform * vec4(normal_xform * cone_dirs[i], 0.0)).xyz);
2217 | 
2218 | 		vec4 cone_light = voxel_cone_trace_45_degrees(voxel_gi_textures[index], cell_size, position, dir, cone_angle_tan, max_distance, voxel_gi_instances.data[index].bias);
2219 | 
2220 | 		if (voxel_gi_instances.data[index].blend_ambient) {
2221 | 			cone_light.rgb = mix(ambient, cone_light.rgb, min(1.0, cone_light.a / 0.95));
2222 | 		}
2223 | 
2224 | 		light += cone_weights[i] * cone_light.rgb;
2225 | 	}
2226 | 
2227 | 	light *= voxel_gi_instances.data[index].dynamic_range * voxel_gi_instances.data[index].exposure_normalization;
2228 | 	out_diff += vec4(light * blend, blend);
2229 | 
2230 | 	
2231 | 	vec4 irr_light = voxel_cone_trace(voxel_gi_textures[index], cell_size, position, ref_vec, tan(roughness * 0.5 * M_PI * 0.99), max_distance, voxel_gi_instances.data[index].bias);
2232 | 	if (voxel_gi_instances.data[index].blend_ambient) {
2233 | 		irr_light.rgb = mix(environment, irr_light.rgb, min(1.0, irr_light.a / 0.95));
2234 | 	}
2235 | 	irr_light.rgb *= voxel_gi_instances.data[index].dynamic_range * voxel_gi_instances.data[index].exposure_normalization;
2236 | 	
2237 | 
2238 | 	out_spec += vec4(irr_light.rgb * blend, blend);
2239 | }
