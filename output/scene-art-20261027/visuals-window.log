1293 | 
1294 | 		specular_light += clearcoat_specular_brdf_NL * light_color * attenuation * specular_amount;
1295 | 
1296 | 		
1297 | 		
1298 | #endif 
1299 | 
1300 | 		if (metallic < 1.0) {
1301 | 			float diffuse_brdf_NL; 
1302 | 
1303 | #if defined(DIFFUSE_LAMBERT_WRAP)
1304 | 			
1305 | 			
1306 | 			diffuse_brdf_NL = max(0.0, (NdotL + roughness) / ((1.0 + roughness) * (1.0 + roughness))) * (1.0 / M_PI);
1307 | #elif defined(DIFFUSE_TOON)
1308 | 
1309 | 			diffuse_brdf_NL = smoothstep(-roughness, max(roughness, 0.01), NdotL) * (1.0 / M_PI);
1310 | 
1311 | #elif defined(DIFFUSE_BURLEY)
1312 | 			{
1313 | 				float FD90_minus_1 = 2.0 * cLdotH * cLdotH * roughness - 0.5;
1314 | 				float FdV = 1.0 + FD90_minus_1 * SchlickFresnel(cNdotV);
1315 | 				float FdL = 1.0 + FD90_minus_1 * SchlickFresnel(cNdotL);
1316 | 				diffuse_brdf_NL = (1.0 / M_PI) * FdV * FdL * cNdotL;
1317 | 			}
1318 | #else
1319 | 			
1320 | 			diffuse_brdf_NL = cNdotL * (1.0 / M_PI);
1321 | #endif
1322 | 
1323 | 			diffuse_light += light_color * diffuse_brdf_NL * attenuation;
1324 | 
1325 | #if defined(LIGHT_BACKLIGHT_USED)
1326 | 			diffuse_light += light_color * (vec3(1.0 / M_PI) - diffuse_brdf_NL) * backlight * attenuation;
1327 | #endif
1328 | 		}
1329 | 
1330 | 		if (roughness > 0.0) {
1331 | #if defined(SPECULAR_SCHLICK_GGX)
1332 | 			float cNdotH = clamp(A + dot(N, H), 0.0, 1.0);
1333 | #endif
1334 | 			
1335 | 			
1336 | #if defined(SPECULAR_TOON)
1337 | 			vec3 R = normalize(-reflect(L, N));
1338 | 			float RdotV = dot(R, V);
1339 | 			float mid = 1.0 - roughness;
1340 | 			mid *= mid;
1341 | 			float intensity = smoothstep(mid - roughness * 0.5, mid + roughness * 0.5, RdotV) * mid;
1342 | 			diffuse_light += light_color * intensity * attenuation * specular_amount; 
1343 | 
1344 | #elif defined(SPECULAR_DISABLED)
1345 | 			
1346 | 
1347 | #elif defined(SPECULAR_SCHLICK_GGX)
1348 | 			
1349 | 			float alpha_ggx = roughness * roughness;
1350 | #if defined(LIGHT_ANISOTROPY_USED)
1351 | 			float aspect = sqrt(1.0 - anisotropy * 0.9);
1352 | 			float ax = alpha_ggx / aspect;
1353 | 			float ay = alpha_ggx * aspect;
1354 | 			float XdotH = dot(T, H);
1355 | 			float YdotH = dot(B, H);
1356 | 			float D = D_GGX_anisotropic(cNdotH, ax, ay, XdotH, YdotH);
1357 | 			float G = V_GGX_anisotropic(ax, ay, dot(T, V), dot(T, L), dot(B, V), dot(B, L), cNdotV, cNdotL);
1358 | #else 
1359 | 			float D = D_GGX(cNdotH, alpha_ggx);
1360 | 			float G = V_GGX(cNdotL, cNdotV, alpha_ggx);
1361 | #endif 
1362 | 	   
1363 | #if !defined(LIGHT_CLEARCOAT_USED)
1364 | 			float cLdotH5 = SchlickFresnel(cLdotH);
1365 | #endif
1366 | 			
1367 | 			
1368 | 			float f90 = clamp(dot(f0, vec3(50.0 * 0.33)), metallic, 1.0);
1369 | 			vec3 F = f0 + (f90 - f0) * cLdotH5;
