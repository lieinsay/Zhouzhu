2386 | vec4 fog_process(vec3 vertex) {
2387 | 	vec3 fog_color = scene_data_block.data.fog_light_color;
2388 | 
2389 | 	if (scene_data_block.data.fog_aerial_perspective > 0.0) {
2390 | 		vec3 sky_fog_color = vec3(0.0);
2391 | 		vec3 cube_view = scene_data_block.data.radiance_inverse_xform * vertex;
2392 | 		
2393 | 		float mip_level = mix(1.0 / MAX_ROUGHNESS_LOD, 1.0, 1.0 - (abs(vertex.z) - scene_data_block.data.z_near) / (scene_data_block.data.z_far - scene_data_block.data.z_near));
2394 | #ifdef USE_RADIANCE_CUBEMAP_ARRAY
2395 | 		float lod, blend;
2396 | 		blend = modf(mip_level * MAX_ROUGHNESS_LOD, lod);
2397 | 		sky_fog_color = texture(samplerCubeArray(radiance_cubemap, DEFAULT_SAMPLER_LINEAR_WITH_MIPMAPS_CLAMP), vec4(cube_view, lod)).rgb;
2398 | 		sky_fog_color = mix(sky_fog_color, texture(samplerCubeArray(radiance_cubemap, DEFAULT_SAMPLER_LINEAR_WITH_MIPMAPS_CLAMP), vec4(cube_view, lod + 1)).rgb, blend);
2399 | #else
2400 | 		sky_fog_color = textureLod(samplerCube(radiance_cubemap, DEFAULT_SAMPLER_LINEAR_WITH_MIPMAPS_CLAMP), cube_view, mip_level * MAX_ROUGHNESS_LOD).rgb;
2401 | #endif 
2402 | 		fog_color = mix(fog_color, sky_fog_color, scene_data_block.data.fog_aerial_perspective);
2403 | 	}
2404 | 
2405 | 	if (scene_data_block.data.fog_sun_scatter > 0.001) {
2406 | 		vec4 sun_scatter = vec4(0.0);
2407 | 		float sun_total = 0.0;
2408 | 		vec3 view = normalize(vertex);
2409 | 
2410 | 		for (uint i = 0; i < scene_data_block.data.directional_light_count; i++) {
2411 | 			vec3 light_color = directional_lights.data[i].color * directional_lights.data[i].energy;
2412 | 			float light_amount = pow(max(dot(view, directional_lights.data[i].direction), 0.0), 8.0);
2413 | 			fog_color += light_color * light_amount * scene_data_block.data.fog_sun_scatter;
2414 | 		}
2415 | 	}
2416 | 
2417 | 	float fog_amount = 0.0;
2418 | 
2419 | 	if (sc_use_depth_fog()) {
