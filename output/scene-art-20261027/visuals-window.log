 719 | float w0(float a) {
 720 | 	return (1.0 / 6.0) * (a * (a * (-a + 3.0) - 3.0) + 1.0);
 721 | }
 722 | 
 723 | float w1(float a) {
 724 | 	return (1.0 / 6.0) * (a * a * (3.0 * a - 6.0) + 4.0);
 725 | }
 726 | 
 727 | float w2(float a) {
 728 | 	return (1.0 / 6.0) * (a * (a * (-3.0 * a + 3.0) + 3.0) + 1.0);
 729 | }
 730 | 
 731 | float w3(float a) {
 732 | 	return (1.0 / 6.0) * (a * a * a);
 733 | }
 734 | 
 735 | 
 736 | float g0(float a) {
 737 | 	return w0(a) + w1(a);
 738 | }
 739 | 
 740 | float g1(float a) {
 741 | 	return w2(a) + w3(a);
 742 | }
 743 | 
 744 | 
 745 | float h0(float a) {
 746 | 	return -1.0 + w1(a) / (w0(a) + w1(a));
 747 | }
 748 | 
 749 | float h1(float a) {
 750 | 	return 1.0 + w3(a) / (w2(a) + w3(a));
 751 | }
 752 | 
 753 | vec4 textureArray_bicubic(texture2DArray tex, vec3 uv, vec2 texture_size) {
 754 | 	vec2 texel_size = vec2(1.0) / texture_size;
 755 | 
 756 | 	uv.xy = uv.xy * texture_size + vec2(0.5);
 757 | 
 758 | 	vec2 iuv = floor(uv.xy);
 759 | 	vec2 fuv = fract(uv.xy);
 760 | 
 761 | 	float g0x = g0(fuv.x);
 762 | 	float g1x = g1(fuv.x);
 763 | 	float h0x = h0(fuv.x);
 764 | 	float h1x = h1(fuv.x);
 765 | 	float h0y = h0(fuv.y);
 766 | 	float h1y = h1(fuv.y);
 767 | 
 768 | 	vec2 p0 = (vec2(iuv.x + h0x, iuv.y + h0y) - vec2(0.5)) * texel_size;
 769 | 	vec2 p1 = (vec2(iuv.x + h1x, iuv.y + h0y) - vec2(0.5)) * texel_size;
 770 | 	vec2 p2 = (vec2(iuv.x + h0x, iuv.y + h1y) - vec2(0.5)) * texel_size;
 771 | 	vec2 p3 = (vec2(iuv.x + h1x, iuv.y + h1y) - vec2(0.5)) * texel_size;
 772 | 
 773 | 	return (g0(fuv.y) * (g0x * texture(sampler2DArray(tex, SAMPLER_LINEAR_CLAMP), vec3(p0, uv.z)) + g1x * texture(sampler2DArray(tex, SAMPLER_LINEAR_CLAMP), vec3(p1, uv.z)))) +
 774 | 			(g1(fuv.y) * (g0x * texture(sampler2DArray(tex, SAMPLER_LINEAR_CLAMP), vec3(p2, uv.z)) + g1x * texture(sampler2DArray(tex, SAMPLER_LINEAR_CLAMP), vec3(p3, uv.z))));
 775 | }
 776 | #endif 
