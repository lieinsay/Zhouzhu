2253 | void sdfgi_process(uint cascade, vec3 cascade_pos, vec3 cam_pos, vec3 cam_normal, vec3 cam_specular_normal, bool use_specular, float roughness, out vec3 diffuse_light, out vec3 specular_light, out float blend) {
2254 | 	cascade_pos += cam_normal * sdfgi.normal_bias;
2255 | 
2256 | 	vec3 base_pos = floor(cascade_pos);
2257 | 	
2258 | 	ivec3 probe_base_pos = ivec3(base_pos);
2259 | 
2260 | 	vec4 diffuse_accum = vec4(0.0);
2261 | 	vec3 specular_accum;
2262 | 
2263 | 	ivec3 tex_pos = ivec3(probe_base_pos.xy, int(cascade));
2264 | 	tex_pos.x += probe_base_pos.z * sdfgi.probe_axis_size;
2265 | 	tex_pos.xy = tex_pos.xy * (SDFGI_OCT_SIZE + 2) + ivec2(1);
2266 | 
2267 | 	vec3 diffuse_posf = (vec3(tex_pos) + vec3(octahedron_encode(cam_normal) * float(SDFGI_OCT_SIZE), 0.0)) * sdfgi.lightprobe_tex_pixel_size;
2268 | 
2269 | 	vec3 specular_posf;
2270 | 
2271 | 	if (use_specular) {
2272 | 		specular_accum = vec3(0.0);
2273 | 		specular_posf = (vec3(tex_pos) + vec3(octahedron_encode(cam_specular_normal) * float(SDFGI_OCT_SIZE), 0.0)) * sdfgi.lightprobe_tex_pixel_size;
2274 | 	}
2275 | 
2276 | 	vec4 light_accum = vec4(0.0);
2277 | 	float weight_accum = 0.0;
2278 | 
2279 | 	for (uint j = 0; j < 8; j++) {
2280 | 		ivec3 offset = (ivec3(j) >> ivec3(0, 1, 2)) & ivec3(1, 1, 1);
2281 | 		ivec3 probe_posi = probe_base_pos;
2282 | 		probe_posi += offset;
2283 | 
2284 | 		
2285 | 
2286 | 		vec3 probe_pos = vec3(probe_posi);
2287 | 		vec3 probe_to_pos = cascade_pos - probe_pos;
2288 | 		vec3 probe_dir = normalize(-probe_to_pos);
2289 | 
2290 | 		vec3 trilinear = vec3(1.0) - abs(probe_to_pos);
2291 | 		float weight = trilinear.x * trilinear.y * trilinear.z * max(0.005, dot(cam_normal, probe_dir));
2292 | 
2293 | 		
2294 | 
2295 | 		if (sdfgi.use_occlusion) {
2296 | 			ivec3 occ_indexv = abs((sdfgi.cascades[cascade].probe_world_offset + probe_posi) & ivec3(1, 1, 1)) * ivec3(1, 2, 4);
2297 | 			vec4 occ_mask = mix(vec4(0.0), vec4(1.0), equal(ivec4(occ_indexv.x | occ_indexv.y), ivec4(0, 1, 2, 3)));
2298 | 
2299 | 			vec3 occ_pos = clamp(cascade_pos, probe_pos - sdfgi.occlusion_clamp, probe_pos + sdfgi.occlusion_clamp) * sdfgi.probe_to_uvw;
2300 | 			occ_pos.z += float(cascade);
2301 | 			if (occ_indexv.z != 0) { 
2302 | 				occ_pos.x += 1.0;
2303 | 			}
2304 | 
2305 | 			occ_pos *= sdfgi.occlusion_renormalize;
2306 | 			float occlusion = dot(textureLod(sampler3D(sdfgi_occlusion_cascades, SAMPLER_LINEAR_CLAMP), occ_pos, 0.0), occ_mask);
2307 | 
2308 | 			weight *= max(occlusion, 0.01);
2309 | 		}
2310 | 
2311 | 		
2312 | 
2313 | 		vec3 diffuse;
2314 | 		vec3 pos_uvw = diffuse_posf;
2315 | 		pos_uvw.xy += vec2(offset.xy) * sdfgi.lightprobe_uv_offset.xy;
2316 | 		pos_uvw.x += float(offset.z) * sdfgi.lightprobe_uv_offset.z;
2317 | 		diffuse = textureLod(sampler2DArray(sdfgi_lightprobe_texture, SAMPLER_LINEAR_CLAMP), pos_uvw, 0.0).rgb;
2318 | 
2319 | 		diffuse_accum += vec4(diffuse * weight * sdfgi.cascades[cascade].exposure_normalization, weight);
2320 | 
2321 | 		if (use_specular) {
2322 | 			vec3 specular = vec3(0.0);
2323 | 			vec3 pos_uvw = specular_posf;
2324 | 			pos_uvw.xy += vec2(offset.xy) * sdfgi.lightprobe_uv_offset.xy;
2325 | 			pos_uvw.x += float(offset.z) * sdfgi.lightprobe_uv_offset.z;
2326 | 			if (roughness < 0.99) {
2327 | 				specular = textureLod(sampler2DArray(sdfgi_lightprobe_texture, SAMPLER_LINEAR_CLAMP), pos_uvw + vec3(0, 0, float(sdfgi.max_cascades)), 0.0).rgb;
2328 | 			}
2329 | 			if (roughness > 0.5) {
2330 | 				specular = mix(specular, textureLod(sampler2DArray(sdfgi_lightprobe_texture, SAMPLER_LINEAR_CLAMP), pos_uvw, 0.0).rgb, (roughness - 0.5) * 2.0);
2331 | 			}
2332 | 
2333 | 			specular_accum += specular * weight * sdfgi.cascades[cascade].exposure_normalization;
2334 | 		}
2335 | 	}
2336 | 
2337 | 	if (diffuse_accum.a > 0.0) {
2338 | 		diffuse_accum.rgb /= diffuse_accum.a;
2339 | 	}
2340 | 
2341 | 	diffuse_light = diffuse_accum.rgb;
2342 | 
2343 | 	if (use_specular) {
2344 | 		if (diffuse_accum.a > 0.0) {
2345 | 			specular_accum /= diffuse_accum.a;
2346 | 		}
2347 | 
2348 | 		specular_light = specular_accum;
2349 | 	}
2350 | 
2351 | 	{
2352 | 		
2353 | 		float blend_from = (float(sdfgi.probe_axis_size - 1) / 2.0) - 2.5;
2354 | 		float blend_to = blend_from + 2.0;
2355 | 
2356 | 		vec3 inner_pos = cam_pos * sdfgi.cascades[cascade].to_probe;
2357 | 
2358 | 		float len = length(inner_pos);
2359 | 
2360 | 		inner_pos = abs(normalize(inner_pos));
2361 | 		len *= max(inner_pos.x, max(inner_pos.y, inner_pos.z));
2362 | 
2363 | 		if (len >= blend_from) {
2364 | 			blend = smoothstep(blend_from, blend_to, len);
2365 | 		} else {
2366 | 			blend = 0.0;
2367 | 		}
2368 | 	}
2369 | }
