2243 | vec2 octahedron_wrap(vec2 v) {
2244 | 	vec2 signVal;
2245 | 	signVal.x = v.x >= 0.0 ? 1.0 : -1.0;
2246 | 	signVal.y = v.y >= 0.0 ? 1.0 : -1.0;
2247 | 	return (1.0 - abs(v.yx)) * signVal;
2248 | }
2249 | 
2250 | vec2 octahedron_encode(vec3 n) {
2251 | 	
2252 | 	n /= (abs(n.x) + abs(n.y) + abs(n.z));
2253 | 	n.xy = n.z >= 0.0 ? n.xy : octahedron_wrap(n.xy);
2254 | 	n.xy = n.xy * 0.5 + 0.5;
2255 | 	return n.xy;
2256 | }
