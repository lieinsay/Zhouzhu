1668 | 					pos = normalize(pos);
1669 | 					pos = normalize(pos + normal_bias);
1670 | 
1671 | 					vec4 uv_rect = base_uv_rect;
1672 | 
1673 | 					if (pos.z >= 0.0) {
1674 | 						uv_rect.xy += flip_offset;
1675 | 					}
1676 | 
1677 | 					pos.z = 1.0 + abs(pos.z);
1678 | 					pos.xy /= pos.z;
1679 | 
1680 | 					pos.xy = pos.xy * 0.5 + 0.5;
