1620 | 			bitangent *= omni_lights.data[idx].soft_shadow_size * omni_lights.data[idx].soft_shadow_scale;
1621 | 
1622 | 			SPEC_CONSTANT_LOOP_ANNOTATION
1623 | 			for (uint i = 0; i < sc_penumbra_shadow_samples(); i++) {
1624 | 				vec2 disk = disk_rotation * scene_data_block.data.penumbra_shadow_kernel[i].xy;
1625 | 
1626 | 				vec3 pos = local_vert + tangent * disk.x + bitangent * disk.y;
1627 | 
1628 | 				pos = normalize(pos);
1629 | 
1630 | 				vec4 uv_rect = base_uv_rect;
1631 | 
1632 | 				if (pos.z >= 0.0) {
