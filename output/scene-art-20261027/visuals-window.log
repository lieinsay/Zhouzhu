1635 | 
1636 | 				pos.z = 1.0 + abs(pos.z);
1637 | 				pos.xy /= pos.z;
1638 | 
1639 | 				pos.xy = pos.xy * 0.5 + 0.5;
1640 | 				pos.xy = uv_rect.xy + pos.xy * uv_rect.zw;
1641 | 
1642 | 				float d = textureLod(sampler2D(shadow_atlas, SAMPLER_LINEAR_CLAMP), pos.xy, 0.0).r;
