1665 | 
1666 | 					pos = normalize(pos);
1667 | 					pos = normalize(pos + normal_bias);
1668 | 
1669 | 					vec4 uv_rect = base_uv_rect;
1670 | 
1671 | 					if (pos.z >= 0.0) {
1672 | 						uv_rect.xy += flip_offset;
1673 | 					}
1674 | 
1675 | 					pos.z = 1.0 + abs(pos.z);
1676 | 					pos.xy /= pos.z;
1677 | 
1678 | 					pos.xy = pos.xy * 0.5 + 0.5;
1679 | 					pos.xy = uv_rect.xy + pos.xy * uv_rect.zw;
