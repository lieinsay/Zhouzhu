1534 | float get_omni_attenuation(float distance, float inv_range, float decay) {
1535 | 	float nd = distance * inv_range;
1536 | 	nd *= nd;
1537 | 	nd *= nd; 
1538 | 	nd = max(1.0 - nd, 0.0);
1539 | 	nd *= nd; 
1540 | 	return nd * pow(max(distance, 0.0001), -decay);
1541 | }
