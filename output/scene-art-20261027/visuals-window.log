1445 | 
1446 | float sample_omni_pcf_shadow(texture2D shadow, float blur_scale, vec2 coord, vec4 uv_rect, vec2 flip_offset, float depth, float taa_frame_count) {
1447 | 	
1448 | 	if (sc_soft_shadow_samples() == 0) {
1449 | 		vec2 pos = coord * 0.5 + 0.5;
1450 | 		pos = uv_rect.xy + pos * uv_rect.zw;
1451 | 		return textureProj(sampler2DShadow(shadow, shadow_sampler), vec4(pos, depth, 1.0));
1452 | 	}
1453 | 
1454 | 	mat2 disk_rotation;
1455 | 	{
1456 | 		float r = quick_hash(gl_FragCoord.xy + vec2(taa_frame_count * 5.588238)) * 2.0 * M_PI;
1457 | 		float sr = sin(r);
1458 | 		float cr = cos(r);
1459 | 		disk_rotation = mat2(vec2(cr, -sr), vec2(sr, cr));
1460 | 	}
1461 | 
1462 | 	float avg = 0.0;
1463 | 	vec2 offset_scale = blur_scale * 2.0 * scene_data_block.data.shadow_atlas_pixel_size / uv_rect.zw;
1464 | 
1465 | 	SPEC_CONSTANT_LOOP_ANNOTATION
1466 | 	for (uint i = 0; i < sc_soft_shadow_samples(); i++) {
1467 | 		vec2 offset = offset_scale * (disk_rotation * scene_data_block.data.soft_shadow_kernel[i].xy);
1468 | 		vec2 sample_coord = coord + offset;
1469 | 
1470 | 		float sample_coord_length_squared = dot(sample_coord, sample_coord);
1471 | 		bool do_flip = sample_coord_length_squared > 1.0;
1472 | 
1473 | 		if (do_flip) {
1474 | 			float len = sqrt(sample_coord_length_squared);
1475 | 			sample_coord = sample_coord * (2.0 / len - 1.0);
1476 | 		}
1477 | 
1478 | 		sample_coord = sample_coord * 0.5 + 0.5;
1479 | 		sample_coord = uv_rect.xy + sample_coord * uv_rect.zw;
1480 | 
1481 | 		if (do_flip) {
1482 | 			sample_coord += flip_offset;
1483 | 		}
1484 | 		avg += textureProj(sampler2DShadow(shadow, shadow_sampler), vec4(sample_coord, depth, 1.0));
1485 | 	}
1486 | 
1487 | 	return avg * (1.0 / float(sc_soft_shadow_samples()));
1488 | }
1489 | 
1490 | float sample_directional_soft_shadow(texture2D shadow, vec3 pssm_coord, vec2 tex_scale, float taa_frame_count) {
1491 | 	
1492 | 	float blocker_count = 0.0;
1493 | 	float blocker_average = 0.0;
1494 | 
1495 | 	mat2 disk_rotation;
1496 | 	{
1497 | 		float r = quick_hash(gl_FragCoord.xy + vec2(taa_frame_count * 5.588238)) * 2.0 * M_PI;
1498 | 		float sr = sin(r);
1499 | 		float cr = cos(r);
1500 | 		disk_rotation = mat2(vec2(cr, -sr), vec2(sr, cr));
1501 | 	}
1502 | 
1503 | 	SPEC_CONSTANT_LOOP_ANNOTATION
1504 | 	for (uint i = 0; i < sc_directional_penumbra_shadow_samples(); i++) {
1505 | 		vec2 suv = pssm_coord.xy + (disk_rotation * scene_data_block.data.directional_penumbra_shadow_kernel[i].xy) * tex_scale;
1506 | 		float d = textureLod(sampler2D(shadow, SAMPLER_LINEAR_CLAMP), suv, 0.0).r;
1507 | 		if (d > pssm_coord.z) {
1508 | 			blocker_average += d;
1509 | 			blocker_count += 1.0;
1510 | 		}
1511 | 	}
1512 | 
1513 | 	if (blocker_count > 0.0) {
1514 | 		
1515 | 		blocker_average /= blocker_count;
1516 | 		float penumbra = (-pssm_coord.z + blocker_average) / (1.0 - blocker_average);
1517 | 		tex_scale *= penumbra;
1518 | 
1519 | 		float s = 0.0;
1520 | 
1521 | 		SPEC_CONSTANT_LOOP_ANNOTATION
1522 | 		for (uint i = 0; i < sc_directional_penumbra_shadow_samples(); i++) {
1523 | 			vec2 suv = pssm_coord.xy + (disk_rotation * scene_data_block.data.directional_penumbra_shadow_kernel[i].xy) * tex_scale;
1524 | 			s += textureProj(sampler2DShadow(shadow, shadow_sampler), vec4(suv, pssm_coord.z, 1.0));
1525 | 		}
1526 | 
1527 | 		return s / float(sc_directional_penumbra_shadow_samples());
1528 | 
1529 | 	} else {
1530 | 		
1531 | 		return 1.0;
1532 | 	}
1533 | }
1534 | 
1535 | #endif 
