 723 | float w0(float a) {
 724 | 	return (1.0 / 6.0) * (a * (a * (-a + 3.0) - 3.0) + 1.0);
 725 | }
 726 | 
 727 | float w1(float a) {
 728 | 	return (1.0 / 6.0) * (a * a * (3.0 * a - 6.0) + 4.0);
 729 | }
 730 | 
 731 | float w2(float a) {
 732 | 	return (1.0 / 6.0) * (a * (a * (-3.0 * a + 3.0) + 3.0) + 1.0);
 733 | }
 734 | 
 735 | float w3(float a) {
 736 | 	return (1.0 / 6.0) * (a * a * a);
 737 | }
 738 | 
 739 | 
 740 | float g0(float a) {
 741 | 	return w0(a) + w1(a);
 742 | }
 743 | 
 744 | float g1(float a) {
 745 | 	return w2(a) + w3(a);
 746 | }
 747 | 
 748 | 
 749 | float h0(float a) {
 750 | 	return -1.0 + w1(a) / (w0(a) + w1(a));
 751 | }
 752 | 
 753 | float h1(float a) {
 754 | 	return 1.0 + w3(a) / (w2(a) + w3(a));
 755 | }
 756 | 
 757 | vec4 textureArray_bicubic(texture2DArray tex, vec3 uv, vec2 texture_size) {
 758 | 	vec2 texel_size = vec2(1.0) / texture_size;
 759 | 
 760 | 	uv.xy = uv.xy * texture_size + vec2(0.5);
 761 | 
 762 | 	vec2 iuv = floor(uv.xy);
 763 | 	vec2 fuv = fract(uv.xy);
 764 | 
 765 | 	float g0x = g0(fuv.x);
 766 | 	float g1x = g1(fuv.x);
 767 | 	float h0x = h0(fuv.x);
 768 | 	float h1x = h1(fuv.x);
 769 | 	float h0y = h0(fuv.y);
 770 | 	float h1y = h1(fuv.y);
 771 | 
 772 | 	vec2 p0 = (vec2(iuv.x + h0x, iuv.y + h0y) - vec2(0.5)) * texel_size;
 773 | 	vec2 p1 = (vec2(iuv.x + h1x, iuv.y + h0y) - vec2(0.5)) * texel_size;
 774 | 	vec2 p2 = (vec2(iuv.x + h0x, iuv.y + h1y) - vec2(0.5)) * texel_size;
 775 | 	vec2 p3 = (vec2(iuv.x + h1x, iuv.y + h1y) - vec2(0.5)) * texel_size;
 776 | 
 777 | 	return (g0(fuv.y) * (g0x * texture(sampler2DArray(tex, SAMPLER_LINEAR_CLAMP), vec3(p0, uv.z)) + g1x * texture(sampler2DArray(tex, SAMPLER_LINEAR_CLAMP), vec3(p1, uv.z)))) +
 778 | 			(g1(fuv.y) * (g0x * texture(sampler2DArray(tex, SAMPLER_LINEAR_CLAMP), vec3(p2, uv.z)) + g1x * texture(sampler2DArray(tex, SAMPLER_LINEAR_CLAMP), vec3(p3, uv.z))));
 779 | }
 780 | #endif 
