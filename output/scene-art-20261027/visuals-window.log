1444 | float sample_omni_pcf_shadow(texture2D shadow, float blur_scale, vec2 coord, vec4 uv_rect, vec2 flip_offset, float depth, float taa_frame_count) {
1445 | 	
1446 | 	if (sc_soft_shadow_samples() == 0) {
1447 | 		vec2 pos = coord * 0.5 + 0.5;
1448 | 		pos = uv_rect.xy + pos * uv_rect.zw;
1449 | 		return textureProj(sampler2DShadow(shadow, shadow_sampler), vec4(pos, depth, 1.0));
1450 | 	}
1451 | 
1452 | 	mat2 disk_rotation;
1453 | 	{
1454 | 		float r = quick_hash(gl_FragCoord.xy + vec2(taa_frame_count * 5.588238)) * 2.0 * M_PI;
1455 | 		float sr = sin(r);
1456 | 		float cr = cos(r);
1457 | 		disk_rotation = mat2(vec2(cr, -sr), vec2(sr, cr));
1458 | 	}
1459 | 
1460 | 	float avg = 0.0;
1461 | 	vec2 offset_scale = blur_scale * 2.0 * scene_data_block.data.shadow_atlas_pixel_size / uv_rect.zw;
1462 | 
1463 | 	SPEC_CONSTANT_LOOP_ANNOTATION
1464 | 	for (uint i = 0; i < sc_soft_shadow_samples(); i++) {
1465 | 		vec2 offset = offset_scale * (disk_rotation * scene_data_block.data.soft_shadow_kernel[i].xy);
1466 | 		vec2 sample_coord = coord + offset;
1467 | 
1468 | 		float sample_coord_length_squared = dot(sample_coord, sample_coord);
1469 | 		bool do_flip = sample_coord_length_squared > 1.0;
1470 | 
1471 | 		if (do_flip) {
1472 | 			float len = sqrt(sample_coord_length_squared);
1473 | 			sample_coord = sample_coord * (2.0 / len - 1.0);
1474 | 		}
1475 | 
1476 | 		sample_coord = sample_coord * 0.5 + 0.5;
1477 | 		sample_coord = uv_rect.xy + sample_coord * uv_rect.zw;
1478 | 
1479 | 		if (do_flip) {
1480 | 			sample_coord += flip_offset;
1481 | 		}
1482 | 		avg += textureProj(sampler2DShadow(shadow, shadow_sampler), vec4(sample_coord, depth, 1.0));
1483 | 	}
1484 | 
1485 | 	return avg * (1.0 / float(sc_soft_shadow_samples()));
1486 | }
1487 | 
1488 | float sample_directional_soft_shadow(texture2D shadow, vec3 pssm_coord, vec2 tex_scale, float taa_frame_count) {
1489 | 	
1490 | 	float blocker_count = 0.0;
1491 | 	float blocker_average = 0.0;
1492 | 
1493 | 	mat2 disk_rotation;
1494 | 	{
1495 | 		float r = quick_hash(gl_FragCoord.xy + vec2(taa_frame_count * 5.588238)) * 2.0 * M_PI;
1496 | 		float sr = sin(r);
1497 | 		float cr = cos(r);
1498 | 		disk_rotation = mat2(vec2(cr, -sr), vec2(sr, cr));
1499 | 	}
1500 | 
1501 | 	SPEC_CONSTANT_LOOP_ANNOTATION
1502 | 	for (uint i = 0; i < sc_directional_penumbra_shadow_samples(); i++) {
1503 | 		vec2 suv = pssm_coord.xy + (disk_rotation * scene_data_block.data.directional_penumbra_shadow_kernel[i].xy) * tex_scale;
1504 | 		float d = textureLod(sampler2D(shadow, SAMPLER_LINEAR_CLAMP), suv, 0.0).r;
1505 | 		if (d > pssm_coord.z) {
1506 | 			blocker_average += d;
1507 | 			blocker_count += 1.0;
1508 | 		}
1509 | 	}
1510 | 
1511 | 	if (blocker_count > 0.0) {
1512 | 		
1513 | 		blocker_average /= blocker_count;
1514 | 		float penumbra = (-pssm_coord.z + blocker_average) / (1.0 - blocker_average);
1515 | 		tex_scale *= penumbra;
1516 | 
1517 | 		float s = 0.0;
1518 | 
1519 | 		SPEC_CONSTANT_LOOP_ANNOTATION
1520 | 		for (uint i = 0; i < sc_directional_penumbra_shadow_samples(); i++) {
1521 | 			vec2 suv = pssm_coord.xy + (disk_rotation * scene_data_block.data.directional_penumbra_shadow_kernel[i].xy) * tex_scale;
1522 | 			s += textureProj(sampler2DShadow(shadow, shadow_sampler), vec4(suv, pssm_coord.z, 1.0));
1523 | 		}
1524 | 
1525 | 		return s / float(sc_directional_penumbra_shadow_samples());
1526 | 
1527 | 	} else {
1528 | 		
1529 | 		return 1.0;
1530 | 	}
1531 | }
1532 | 
1533 | #endif 
1534 | 
1535 | float get_omni_attenuation(float distance, float inv_range, float decay) {
1536 | 	float nd = distance * inv_range;
1537 | 	nd *= nd;
1538 | 	nd *= nd; 
1539 | 	nd = max(1.0 - nd, 0.0);
1540 | 	nd *= nd; 
1541 | 	return nd * pow(max(distance, 0.0001), -decay);
1542 | }
