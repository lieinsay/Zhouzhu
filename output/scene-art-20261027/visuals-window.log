1383 | 
1384 | float quick_hash(vec2 pos) {
1385 | 	const vec3 magic = vec3(0.06711056f, 0.00583715f, 52.9829189f);
1386 | 	return fract(magic.z * fract(dot(pos, magic.xy)));
1387 | }
1388 | 
1389 | float sample_directional_pcf_shadow(texture2D shadow, vec2 shadow_pixel_size, vec4 coord, float taa_frame_count) {
1390 | 	vec2 pos = coord.xy;
1391 | 	float depth = coord.z;
1392 | 
1393 | 	
1394 | 	if (sc_directional_soft_shadow_samples() == 0) {
1395 | 		return textureProj(sampler2DShadow(shadow, shadow_sampler), vec4(pos, depth, 1.0));
1396 | 	}
1397 | 
1398 | 	mat2 disk_rotation;
1399 | 	{
1400 | 		float r = quick_hash(gl_FragCoord.xy + vec2(taa_frame_count * 5.588238)) * 2.0 * M_PI;
1401 | 		float sr = sin(r);
1402 | 		float cr = cos(r);
1403 | 		disk_rotation = mat2(vec2(cr, -sr), vec2(sr, cr));
1404 | 	}
1405 | 
1406 | 	float avg = 0.0;
1407 | 
1408 | 	SPEC_CONSTANT_LOOP_ANNOTATION
1409 | 	for (uint i = 0; i < sc_directional_soft_shadow_samples(); i++) {
1410 | 		avg += textureProj(sampler2DShadow(shadow, shadow_sampler), vec4(pos + shadow_pixel_size * (disk_rotation * scene_data_block.data.directional_soft_shadow_kernel[i].xy), depth, 1.0));
1411 | 	}
1412 | 
1413 | 	return avg * (1.0 / float(sc_directional_soft_shadow_samples()));
1414 | }
1415 | 
1416 | float sample_pcf_shadow(texture2D shadow, vec2 shadow_pixel_size, vec3 coord, float taa_frame_count) {
1417 | 	vec2 pos = coord.xy;
1418 | 	float depth = coord.z;
1419 | 
1420 | 	
1421 | 	if (sc_soft_shadow_samples() == 0) {
1422 | 		return textureProj(sampler2DShadow(shadow, shadow_sampler), vec4(pos, depth, 1.0));
1423 | 	}
1424 | 
1425 | 	mat2 disk_rotation;
1426 | 	{
1427 | 		float r = quick_hash(gl_FragCoord.xy + vec2(taa_frame_count * 5.588238)) * 2.0 * M_PI;
1428 | 		float sr = sin(r);
1429 | 		float cr = cos(r);
1430 | 		disk_rotation = mat2(vec2(cr, -sr), vec2(sr, cr));
1431 | 	}
1432 | 
1433 | 	float avg = 0.0;
1434 | 
1435 | 	SPEC_CONSTANT_LOOP_ANNOTATION
1436 | 	for (uint i = 0; i < sc_soft_shadow_samples(); i++) {
1437 | 		avg += textureProj(sampler2DShadow(shadow, shadow_sampler), vec4(pos + shadow_pixel_size * (disk_rotation * scene_data_block.data.soft_shadow_kernel[i].xy), depth, 1.0));
1438 | 	}
1439 | 
1440 | 	return avg * (1.0 / float(sc_soft_shadow_samples()));
1441 | }
1442 | 
1443 | float sample_omni_pcf_shadow(texture2D shadow, float blur_scale, vec2 coord, vec4 uv_rect, vec2 flip_offset, float depth, float taa_frame_count) {
1444 | 	
1445 | 	if (sc_soft_shadow_samples() == 0) {
1446 | 		vec2 pos = coord * 0.5 + 0.5;
1447 | 		pos = uv_rect.xy + pos * uv_rect.zw;
1448 | 		return textureProj(sampler2DShadow(shadow, shadow_sampler), vec4(pos, depth, 1.0));
1449 | 	}
1450 | 
1451 | 	mat2 disk_rotation;
1452 | 	{
1453 | 		float r = quick_hash(gl_FragCoord.xy + vec2(taa_frame_count * 5.588238)) * 2.0 * M_PI;
1454 | 		float sr = sin(r);
1455 | 		float cr = cos(r);
1456 | 		disk_rotation = mat2(vec2(cr, -sr), vec2(sr, cr));
1457 | 	}
1458 | 
1459 | 	float avg = 0.0;
1460 | 	vec2 offset_scale = blur_scale * 2.0 * scene_data_block.data.shadow_atlas_pixel_size / uv_rect.zw;
1461 | 
1462 | 	SPEC_CONSTANT_LOOP_ANNOTATION
1463 | 	for (uint i = 0; i < sc_soft_shadow_samples(); i++) {
1464 | 		vec2 offset = offset_scale * (disk_rotation * scene_data_block.data.soft_shadow_kernel[i].xy);
1465 | 		vec2 sample_coord = coord + offset;
1466 | 
1467 | 		float sample_coord_length_squared = dot(sample_coord, sample_coord);
1468 | 		bool do_flip = sample_coord_length_squared > 1.0;
1469 | 
1470 | 		if (do_flip) {
1471 | 			float len = sqrt(sample_coord_length_squared);
1472 | 			sample_coord = sample_coord * (2.0 / len - 1.0);
1473 | 		}
1474 | 
1475 | 		sample_coord = sample_coord * 0.5 + 0.5;
1476 | 		sample_coord = uv_rect.xy + sample_coord * uv_rect.zw;
1477 | 
1478 | 		if (do_flip) {
1479 | 			sample_coord += flip_offset;
1480 | 		}
1481 | 		avg += textureProj(sampler2DShadow(shadow, shadow_sampler), vec4(sample_coord, depth, 1.0));
1482 | 	}
1483 | 
1484 | 	return avg * (1.0 / float(sc_soft_shadow_samples()));
1485 | }
1486 | 
1487 | float sample_directional_soft_shadow(texture2D shadow, vec3 pssm_coord, vec2 tex_scale, float taa_frame_count) {
1488 | 	
1489 | 	float blocker_count = 0.0;
1490 | 	float blocker_average = 0.0;
1491 | 
1492 | 	mat2 disk_rotation;
1493 | 	{
1494 | 		float r = quick_hash(gl_FragCoord.xy + vec2(taa_frame_count * 5.588238)) * 2.0 * M_PI;
1495 | 		float sr = sin(r);
1496 | 		float cr = cos(r);
1497 | 		disk_rotation = mat2(vec2(cr, -sr), vec2(sr, cr));
1498 | 	}
1499 | 
1500 | 	SPEC_CONSTANT_LOOP_ANNOTATION
1501 | 	for (uint i = 0; i < sc_directional_penumbra_shadow_samples(); i++) {
1502 | 		vec2 suv = pssm_coord.xy + (disk_rotation * scene_data_block.data.directional_penumbra_shadow_kernel[i].xy) * tex_scale;
1503 | 		float d = textureLod(sampler2D(shadow, SAMPLER_LINEAR_CLAMP), suv, 0.0).r;
1504 | 		if (d > pssm_coord.z) {
1505 | 			blocker_average += d;
1506 | 			blocker_count += 1.0;
1507 | 		}
1508 | 	}
1509 | 
1510 | 	if (blocker_count > 0.0) {
1511 | 		
1512 | 		blocker_average /= blocker_count;
1513 | 		float penumbra = (-pssm_coord.z + blocker_average) / (1.0 - blocker_average);
1514 | 		tex_scale *= penumbra;
1515 | 
1516 | 		float s = 0.0;
1517 | 
