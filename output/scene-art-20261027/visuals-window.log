1370 | #endif
1371 | 		}
1372 | 
1373 | #ifdef USE_SHADOW_TO_OPACITY
1374 | 		alpha = min(alpha, clamp(1.0 - attenuation, 0.0, 1.0));
1375 | #endif
1376 | 	}
1377 | #endif 
