1080 | float compute_alpha_hash_threshold(vec3 pos, float hash_scale) {
1081 | 	vec3 dx = dFdx(pos);
1082 | 	vec3 dy = dFdy(pos);
1083 | 
1084 | 	float delta_max_sqr = max(length(dx), length(dy));
1085 | 	float pix_scale = 1.0 / (hash_scale * delta_max_sqr);
1086 | 
1087 | 	vec2 pix_scales =
1088 | 			vec2(exp2(floor(log2(pix_scale))), exp2(ceil(log2(pix_scale))));
1089 | 
1090 | 	vec2 a_thresh = vec2(hash_3d(floor(pix_scales.x * pos.xyz)),
1091 | 			hash_3d(floor(pix_scales.y * pos.xyz)));
1092 | 
1093 | 	float lerp_factor = fract(log2(pix_scale));
1094 | 
1095 | 	float a_interp = (1.0 - lerp_factor) * a_thresh.x + lerp_factor * a_thresh.y;
1096 | 
1097 | 	float min_lerp = min(lerp_factor, 1.0 - lerp_factor);
1098 | 
1099 | 	vec3 cases = vec3(a_interp * a_interp / (2.0 * min_lerp * (1.0 - min_lerp)),
1100 | 			(a_interp - 0.5 * min_lerp) / (1.0 - min_lerp),
1101 | 			1.0 - ((1.0 - a_interp) * (1.0 - a_interp) / (2.0 * min_lerp * (1.0 - min_lerp))));
1102 | 
1103 | 	float alpha_hash_threshold =
1104 | 			(a_interp < (1.0 - min_lerp)) ? ((a_interp < min_lerp) ? cases.x : cases.y) : cases.z;
1105 | 
1106 | 	return clamp(alpha_hash_threshold, 0.00001, 1.0);
1107 | }
