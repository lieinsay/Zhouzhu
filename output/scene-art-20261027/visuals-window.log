1597 | 
1598 | 		if (sc_use_light_soft_shadows() && omni_lights.data[idx].soft_shadow_size > 0.0) {
1599 | 			
1600 | 
1601 | 			
1602 | 
1603 | 			float blocker_count = 0.0;
1604 | 			float blocker_average = 0.0;
1605 | 
1606 | 			mat2 disk_rotation;
1607 | 			{
1608 | 				float r = quick_hash(gl_FragCoord.xy + vec2(taa_frame_count * 5.588238)) * 2.0 * M_PI;
1609 | 				float sr = sin(r);
1610 | 				float cr = cos(r);
1611 | 				disk_rotation = mat2(vec2(cr, -sr), vec2(sr, cr));
