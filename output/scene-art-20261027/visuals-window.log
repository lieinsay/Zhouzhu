1116 | float calc_mip_level(vec2 texture_coord) {
1117 | 	vec2 dx = dFdx(texture_coord);
1118 | 	vec2 dy = dFdy(texture_coord);
1119 | 	float delta_max_sqr = max(dot(dx, dx), dot(dy, dy));
1120 | 	return max(0.0, 0.5 * log2(delta_max_sqr));
1121 | }
1122 | 
1123 | float compute_alpha_antialiasing_edge(float input_alpha, vec2 texture_coord, float alpha_edge) {
1124 | 	input_alpha *= 1.0 + max(0, calc_mip_level(texture_coord)) * 0.25; 
1125 | 	input_alpha = (input_alpha - alpha_edge) / max(fwidth(input_alpha), 0.0001) + 0.5;
1126 | 	return clamp(input_alpha, 0.0, 1.0);
1127 | }
