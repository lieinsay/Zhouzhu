2034 | void reflection_process(uint ref_index, vec3 vertex, vec3 ref_vec, vec3 normal, float roughness, vec3 ambient_light, vec3 specular_light, inout vec4 ambient_accum, inout vec4 reflection_accum) {
2035 | 	vec3 box_extents = reflections.data[ref_index].box_extents;
2036 | 	vec3 local_pos = (reflections.data[ref_index].local_matrix * vec4(vertex, 1.0)).xyz;
2037 | 
2038 | 	if (any(greaterThan(abs(local_pos), box_extents))) { 
2039 | 		return;
2040 | 	}
2041 | 
2042 | 	float blend = 1.0;
2043 | 	if (reflections.data[ref_index].blend_distance != 0.0) {
2044 | 		vec3 axis_blend_distance = min(vec3(reflections.data[ref_index].blend_distance), box_extents);
2045 | 		vec3 blend_axes = abs(local_pos) - box_extents + axis_blend_distance;
2046 | 		blend_axes /= axis_blend_distance;
2047 | 		blend_axes = clamp(1.0 - blend_axes, vec3(0.0), vec3(1.0));
2048 | 
2049 | 		blend = pow(blend_axes.x * blend_axes.y * blend_axes.z, 2.0);
2050 | 	}
2051 | 
2052 | 	if (reflections.data[ref_index].intensity > 0.0 && reflection_accum.a < 1.0) { 
2053 | 
2054 | 		vec3 local_ref_vec = (reflections.data[ref_index].local_matrix * vec4(ref_vec, 0.0)).xyz;
2055 | 
2056 | 		if (reflections.data[ref_index].box_project) { 
2057 | 
2058 | 			vec3 nrdir = normalize(local_ref_vec);
2059 | 			vec3 rbmax = (box_extents - local_pos) / nrdir;
2060 | 			vec3 rbmin = (-box_extents - local_pos) / nrdir;
2061 | 
2062 | 			vec3 rbminmax = mix(rbmin, rbmax, greaterThan(nrdir, vec3(0.0, 0.0, 0.0)));
2063 | 
2064 | 			float fa = min(min(rbminmax.x, rbminmax.y), rbminmax.z);
2065 | 			vec3 posonbox = local_pos + nrdir * fa;
2066 | 			local_ref_vec = posonbox - reflections.data[ref_index].box_offset;
2067 | 		}
2068 | 
2069 | 		vec4 reflection;
2070 | 		float reflection_blend = max(0.0, blend - reflection_accum.a);
2071 | 
2072 | 		reflection.rgb = textureLod(samplerCubeArray(reflection_atlas, DEFAULT_SAMPLER_LINEAR_WITH_MIPMAPS_CLAMP), vec4(local_ref_vec, reflections.data[ref_index].index), sqrt(roughness) * MAX_ROUGHNESS_LOD).rgb * sc_luminance_multiplier();
2073 | 		reflection.rgb *= reflections.data[ref_index].exposure_normalization;
2074 | 		reflection.a = reflection_blend;
2075 | 
2076 | 		reflection.rgb *= reflections.data[ref_index].intensity;
2077 | 		reflection.rgb *= reflection.a;
2078 | 
2079 | 		reflection_accum += reflection;
2080 | 	}
2081 | 
2082 | 	if (ambient_accum.a >= 1.0) {
2083 | 		return;
2084 | 	}
2085 | 
2086 | 	switch (reflections.data[ref_index].ambient_mode) {
2087 | 		case REFLECTION_AMBIENT_DISABLED: {
2088 | 			
2089 | 		} break;
2090 | 		case REFLECTION_AMBIENT_ENVIRONMENT: {
2091 | 			vec3 local_amb_vec = (reflections.data[ref_index].local_matrix * vec4(normal, 0.0)).xyz;
2092 | 			vec4 ambient_out;
2093 | 			float ambient_blend = max(0.0, blend - ambient_accum.a);
2094 | 
2095 | 			ambient_out.rgb = textureLod(samplerCubeArray(reflection_atlas, DEFAULT_SAMPLER_LINEAR_WITH_MIPMAPS_CLAMP), vec4(local_amb_vec, reflections.data[ref_index].index), MAX_ROUGHNESS_LOD).rgb;
2096 | 			ambient_out.rgb *= reflections.data[ref_index].exposure_normalization;
2097 | 			ambient_out.a = ambient_blend;
2098 | 			ambient_out.rgb *= ambient_out.a;
2099 | 			ambient_accum += ambient_out;
2100 | 		} break;
2101 | 		case REFLECTION_AMBIENT_COLOR: {
2102 | 			vec4 ambient_out;
2103 | 			float ambient_blend = max(0.0, blend - ambient_accum.a);
2104 | 
2105 | 			ambient_out.rgb = reflections.data[ref_index].ambient;
2106 | 			ambient_out.a = ambient_blend;
2107 | 			ambient_out.rgb *= ambient_out.a;
2108 | 			ambient_accum += ambient_out;
2109 | 		} break;
2110 | 	}
2111 | }
