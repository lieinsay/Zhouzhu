2242 | vec2 octahedron_wrap(vec2 v) {
2243 | 	vec2 signVal;
2244 | 	signVal.x = v.x >= 0.0 ? 1.0 : -1.0;
2245 | 	signVal.y = v.y >= 0.0 ? 1.0 : -1.0;
2246 | 	return (1.0 - abs(v.yx)) * signVal;
2247 | }
