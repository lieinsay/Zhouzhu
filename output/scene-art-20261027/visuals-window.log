2034 | void reflection_process(uint ref_index, vec3 vertex, vec3 ref_vec, vec3 normal, float roughness, vec3 ambient_light, vec3 specular_light, inout vec4 ambient_accum, inout vec4 reflection_accum) {
2035 | 	vec3 box_extents = reflections.data[ref_index].box_extents;
2036 | 	vec3 local_pos = (reflections.data[ref_index].local_matrix * vec4(vertex, 1.0)).xyz;
2037 | 
2038 | 	if (any(greaterThan(abs(local_pos), box_extents))) { 
2039 | 		return;
2040 | 	}
2041 | 
2042 | 	float blend = 1.0;
2043 | 	if (reflections.data[ref_index].blend_distance != 0.0) {
