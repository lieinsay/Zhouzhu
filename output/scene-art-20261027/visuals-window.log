2029 | void reflection_process(uint ref_index, vec3 vertex, vec3 ref_vec, vec3 normal, float roughness, vec3 ambient_light, vec3 specular_light, inout vec4 ambient_accum, inout vec4 reflection_accum) {
2030 | 	vec3 box_extents = reflections.data[ref_index].box_extents;
2031 | 	vec3 local_pos = (reflections.data[ref_index].local_matrix * vec4(vertex, 1.0)).xyz;
2032 | 
2033 | 	if (any(greaterThan(abs(local_pos), box_extents))) { 
2034 | 		return;
2035 | 	}
2036 | 
2037 | 	float blend = 1.0;
2038 | 	if (reflections.data[ref_index].blend_distance != 0.0) {
2039 | 		vec3 axis_blend_distance = min(vec3(reflections.data[ref_index].blend_distance), box_extents);
2040 | 		vec3 blend_axes = abs(local_pos) - box_extents + axis_blend_distance;
2041 | 		blend_axes /= axis_blend_distance;
2042 | 		blend_axes = clamp(1.0 - blend_axes, vec3(0.0), vec3(1.0));
2043 | 
2044 | 		blend = pow(blend_axes.x * blend_axes.y * blend_axes.z, 2.0);
2045 | 	}
2046 | 
2047 | 	if (reflections.data[ref_index].intensity > 0.0 && reflection_accum.a < 1.0) { 
2048 | 
2049 | 		vec3 local_ref_vec = (reflections.data[ref_index].local_matrix * vec4(ref_vec, 0.0)).xyz;
2050 | 
2051 | 		if (reflections.data[ref_index].box_project) { 
2052 | 
2053 | 			vec3 nrdir = normalize(local_ref_vec);
2054 | 			vec3 rbmax = (box_extents - local_pos) / nrdir;
2055 | 			vec3 rbmin = (-box_extents - local_pos) / nrdir;
2056 | 
2057 | 			vec3 rbminmax = mix(rbmin, rbmax, greaterThan(nrdir, vec3(0.0, 0.0, 0.0)));
2058 | 
2059 | 			float fa = min(min(rbminmax.x, rbminmax.y), rbminmax.z);
2060 | 			vec3 posonbox = local_pos + nrdir * fa;
2061 | 			local_ref_vec = posonbox - reflections.data[ref_index].box_offset;
2062 | 		}
2063 | 
2064 | 		vec4 reflection;
2065 | 		float reflection_blend = max(0.0, blend - reflection_accum.a);
2066 | 
2067 | 		reflection.rgb = textureLod(samplerCubeArray(reflection_atlas, DEFAULT_SAMPLER_LINEAR_WITH_MIPMAPS_CLAMP), vec4(local_ref_vec, reflections.data[ref_index].index), sqrt(roughness) * MAX_ROUGHNESS_LOD).rgb * sc_luminance_multiplier();
2068 | 		reflection.rgb *= reflections.data[ref_index].exposure_normalization;
2069 | 		reflection.a = reflection_blend;
2070 | 
2071 | 		reflection.rgb *= reflections.data[ref_index].intensity;
2072 | 		reflection.rgb *= reflection.a;
2073 | 
2074 | 		reflection_accum += reflection;
2075 | 	}
2076 | 
2077 | 	if (ambient_accum.a >= 1.0) {
2078 | 		return;
2079 | 	}
2080 | 
2081 | 	switch (reflections.data[ref_index].ambient_mode) {
2082 | 		case REFLECTION_AMBIENT_DISABLED: {
2083 | 			
2084 | 		} break;
2085 | 		case REFLECTION_AMBIENT_ENVIRONMENT: {
2086 | 			vec3 local_amb_vec = (reflections.data[ref_index].local_matrix * vec4(normal, 0.0)).xyz;
2087 | 			vec4 ambient_out;
2088 | 			float ambient_blend = max(0.0, blend - ambient_accum.a);
2089 | 
2090 | 			ambient_out.rgb = textureLod(samplerCubeArray(reflection_atlas, DEFAULT_SAMPLER_LINEAR_WITH_MIPMAPS_CLAMP), vec4(local_amb_vec, reflections.data[ref_index].index), MAX_ROUGHNESS_LOD).rgb;
2091 | 			ambient_out.rgb *= reflections.data[ref_index].exposure_normalization;
2092 | 			ambient_out.a = ambient_blend;
2093 | 			ambient_out.rgb *= ambient_out.a;
2094 | 			ambient_accum += ambient_out;
2095 | 		} break;
2096 | 		case REFLECTION_AMBIENT_COLOR: {
2097 | 			vec4 ambient_out;
2098 | 			float ambient_blend = max(0.0, blend - ambient_accum.a);
2099 | 
2100 | 			ambient_out.rgb = reflections.data[ref_index].ambient;
2101 | 			ambient_out.a = ambient_blend;
2102 | 			ambient_out.rgb *= ambient_out.a;
2103 | 			ambient_accum += ambient_out;
2104 | 		} break;
2105 | 	}
2106 | }
