1396 | 	}
1397 | 
1398 | 	mat2 disk_rotation;
1399 | 	{
1400 | 		float r = quick_hash(gl_FragCoord.xy + vec2(taa_frame_count * 5.588238)) * 2.0 * M_PI;
1401 | 		float sr = sin(r);
1402 | 		float cr = cos(r);
1403 | 		disk_rotation = mat2(vec2(cr, -sr), vec2(sr, cr));
1404 | 	}
1405 | 
1406 | 	float avg = 0.0;
1407 | 
1408 | 	SPEC_CONSTANT_LOOP_ANNOTATION
1409 | 	for (uint i = 0; i < sc_directional_soft_shadow_samples(); i++) {
1410 | 		avg += textureProj(sampler2DShadow(shadow, shadow_sampler), vec4(pos + shadow_pixel_size * (disk_rotation * scene_data_block.data.directional_soft_shadow_kernel[i].xy), depth, 1.0));
1411 | 	}
1412 | 
1413 | 	return avg * (1.0 / float(sc_directional_soft_shadow_samples()));
1414 | }
