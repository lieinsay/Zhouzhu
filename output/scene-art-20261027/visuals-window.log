1647 | 			}
1648 | 
1649 | 			if (blocker_count > 0.0) {
1650 | 				
1651 | 				blocker_average /= blocker_count;
1652 | 				float penumbra = (-z_norm + blocker_average) / (1.0 - blocker_average);
1653 | 				tangent *= penumbra;
1654 | 				bitangent *= penumbra;
