1155 | float D_GGX(float cos_theta_m, float alpha) {
1156 | 	float a = cos_theta_m * alpha;
1157 | 	float k = alpha / (1.0 - cos_theta_m * cos_theta_m + a * a);
1158 | 	return k * k * (1.0 / M_PI);
1159 | }
1160 | 
1161 | 
1162 | float V_GGX(float NdotL, float NdotV, float alpha) {
1163 | 	return 0.5 / mix(2.0 * NdotL * NdotV, NdotL + NdotV, alpha);
1164 | }
1165 | 
1166 | float D_GGX_anisotropic(float cos_theta_m, float alpha_x, float alpha_y, float cos_phi, float sin_phi) {
1167 | 	float alpha2 = alpha_x * alpha_y;
1168 | 	highp vec3 v = vec3(alpha_y * cos_phi, alpha_x * sin_phi, alpha2 * cos_theta_m);
1169 | 	highp float v2 = dot(v, v);
1170 | 	float w2 = alpha2 / v2;
1171 | 	float D = alpha2 * w2 * w2 * (1.0 / M_PI);
1172 | 	return D;
1173 | }
1174 | 
1175 | float V_GGX_anisotropic(float alpha_x, float alpha_y, float TdotV, float TdotL, float BdotV, float BdotL, float NdotV, float NdotL) {
1176 | 	float Lambda_V = NdotL * length(vec3(alpha_x * TdotV, alpha_y * BdotV, NdotV));
1177 | 	float Lambda_L = NdotV * length(vec3(alpha_x * TdotL, alpha_y * BdotL, NdotL));
1178 | 	return 0.5 / (Lambda_V + Lambda_L);
1179 | }
