1138 | 
1139 | #extension GL_EXT_control_flow_attributes : require
1140 | 
1141 | 
1142 | 
1143 | 
1144 | #ifdef UBERSHADER
1145 | 
1146 | #define SPEC_CONSTANT_LOOP_ANNOTATION [[dont_unroll]]
1147 | #else
1148 | 
1149 | #define SPEC_CONSTANT_LOOP_ANNOTATION
1150 | #endif
1151 | 
1152 | float D_GGX(float cos_theta_m, float alpha) {
1153 | 	float a = cos_theta_m * alpha;
1154 | 	float k = alpha / (1.0 - cos_theta_m * cos_theta_m + a * a);
1155 | 	return k * k * (1.0 / M_PI);
1156 | }
1157 | 
1158 | 
1159 | float V_GGX(float NdotL, float NdotV, float alpha) {
1160 | 	return 0.5 / mix(2.0 * NdotL * NdotV, NdotL + NdotV, alpha);
1161 | }
1162 | 
1163 | float D_GGX_anisotropic(float cos_theta_m, float alpha_x, float alpha_y, float cos_phi, float sin_phi) {
1164 | 	float alpha2 = alpha_x * alpha_y;
1165 | 	highp vec3 v = vec3(alpha_y * cos_phi, alpha_x * sin_phi, alpha2 * cos_theta_m);
1166 | 	highp float v2 = dot(v, v);
1167 | 	float w2 = alpha2 / v2;
1168 | 	float D = alpha2 * w2 * w2 * (1.0 / M_PI);
1169 | 	return D;
1170 | }
1171 | 
1172 | float V_GGX_anisotropic(float alpha_x, float alpha_y, float TdotV, float TdotL, float BdotV, float BdotL, float NdotV, float NdotL) {
1173 | 	float Lambda_V = NdotL * length(vec3(alpha_x * TdotV, alpha_y * BdotV, NdotV));
1174 | 	float Lambda_L = NdotV * length(vec3(alpha_x * TdotL, alpha_y * BdotL, NdotL));
1175 | 	return 0.5 / (Lambda_V + Lambda_L);
1176 | }
1177 | 
1178 | float SchlickFresnel(float u) {
1179 | 	float m = 1.0 - u;
1180 | 	float m2 = m * m;
1181 | 	return m2 * m2 * m; 
1182 | }
1183 | 
1184 | vec3 F0(float metallic, float specular, vec3 albedo) {
1185 | 	float dielectric = 0.16 * specular * specular;
1186 | 	
1187 | 	
1188 | 	return mix(vec3(dielectric), albedo, vec3(metallic));
1189 | }
