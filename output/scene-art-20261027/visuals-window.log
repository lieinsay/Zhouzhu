2180 | void voxel_gi_compute(uint index, vec3 position, vec3 normal, vec3 ref_vec, mat3 normal_xform, float roughness, vec3 ambient, vec3 environment, inout vec4 out_spec, inout vec4 out_diff) {
2181 | 	position = (voxel_gi_instances.data[index].xform * vec4(position, 1.0)).xyz;
2182 | 	ref_vec = normalize((voxel_gi_instances.data[index].xform * vec4(ref_vec, 0.0)).xyz);
2183 | 	normal = normalize((voxel_gi_instances.data[index].xform * vec4(normal, 0.0)).xyz);
2184 | 
2185 | 	position += normal * voxel_gi_instances.data[index].normal_bias;
2186 | 
2187 | 	
2188 | 	if (any(bvec2(any(lessThan(position, vec3(0.0))), any(greaterThan(position, voxel_gi_instances.data[index].bounds))))) {
2189 | 		return;
2190 | 	}
2191 | 
2192 | 	vec3 blendv = abs(position / voxel_gi_instances.data[index].bounds * 2.0 - 1.0);
2193 | 	float blend = clamp(1.0 - max(blendv.x, max(blendv.y, blendv.z)), 0.0, 1.0);
2194 | 	
2195 | 
2196 | 	float max_distance = length(voxel_gi_instances.data[index].bounds);
2197 | 	vec3 cell_size = 1.0 / voxel_gi_instances.data[index].bounds;
2198 | 
2199 | 	
2200 | 
2201 | #define MAX_CONE_DIRS 4
2202 | 
2203 | 	vec3 cone_dirs[MAX_CONE_DIRS] = vec3[](
2204 | 			vec3(0.707107, 0.0, 0.707107),
2205 | 			vec3(0.0, 0.707107, 0.707107),
2206 | 			vec3(-0.707107, 0.0, 0.707107),
2207 | 			vec3(0.0, -0.707107, 0.707107));
2208 | 
2209 | 	float cone_weights[MAX_CONE_DIRS] = float[](0.25, 0.25, 0.25, 0.25);
2210 | 	float cone_angle_tan = 0.98269;
2211 | 
2212 | 	vec3 light = vec3(0.0);
2213 | 
2214 | 	for (int i = 0; i < MAX_CONE_DIRS; i++) {
2215 | 		vec3 dir = normalize((voxel_gi_instances.data[index].xform * vec4(normal_xform * cone_dirs[i], 0.0)).xyz);
2216 | 
2217 | 		vec4 cone_light = voxel_cone_trace_45_degrees(voxel_gi_textures[index], cell_size, position, dir, cone_angle_tan, max_distance, voxel_gi_instances.data[index].bias);
2218 | 
2219 | 		if (voxel_gi_instances.data[index].blend_ambient) {
2220 | 			cone_light.rgb = mix(ambient, cone_light.rgb, min(1.0, cone_light.a / 0.95));
2221 | 		}
2222 | 
2223 | 		light += cone_weights[i] * cone_light.rgb;
2224 | 	}
2225 | 
2226 | 	light *= voxel_gi_instances.data[index].dynamic_range * voxel_gi_instances.data[index].exposure_normalization;
2227 | 	out_diff += vec4(light * blend, blend);
2228 | 
2229 | 	
2230 | 	vec4 irr_light = voxel_cone_trace(voxel_gi_textures[index], cell_size, position, ref_vec, tan(roughness * 0.5 * M_PI * 0.99), max_distance, voxel_gi_instances.data[index].bias);
2231 | 	if (voxel_gi_instances.data[index].blend_ambient) {
2232 | 		irr_light.rgb = mix(environment, irr_light.rgb, min(1.0, irr_light.a / 0.95));
2233 | 	}
2234 | 	irr_light.rgb *= voxel_gi_instances.data[index].dynamic_range * voxel_gi_instances.data[index].exposure_normalization;
2235 | 	
2236 | 
2237 | 	out_spec += vec4(irr_light.rgb * blend, blend);
2238 | }
