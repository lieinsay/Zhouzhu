1224 | 	mat4 read_model_matrix = instances.data[instance_index_interp].transform;
1225 | #endif
1226 | 
1227 | #undef projection_matrix
1228 | #define projection_matrix scene_data_block.data.projection_matrix
1229 | #undef inv_projection_matrix
1230 | #define inv_projection_matrix scene_data_block.data.inv_projection_matrix
