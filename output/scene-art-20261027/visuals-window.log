1138 | 
1139 | #extension GL_EXT_control_flow_attributes : require
1140 | 
1141 | 
1142 | 
1143 | 
1144 | #ifdef UBERSHADER
1145 | 
1146 | #define SPEC_CONSTANT_LOOP_ANNOTATION [[dont_unroll]]
1147 | #else
1148 | 
1149 | #define SPEC_CONSTANT_LOOP_ANNOTATION
1150 | #endif
1151 | 
1152 | float D_GGX(float cos_theta_m, float alpha) {
1153 | 	float a = cos_theta_m * alpha;
1154 | 	float k = alpha / (1.0 - cos_theta_m * cos_theta_m + a * a);
1155 | 	return k * k * (1.0 / M_PI);
1156 | }
1157 | 
1158 | 
1159 | float V_GGX(float NdotL, float NdotV, float alpha) {
1160 | 	return 0.5 / mix(2.0 * NdotL * NdotV, NdotL + NdotV, alpha);
1161 | }
1162 | 
1163 | float D_GGX_anisotropic(float cos_theta_m, float alpha_x, float alpha_y, float cos_phi, float sin_phi) {
1164 | 	float alpha2 = alpha_x * alpha_y;
1165 | 	highp vec3 v = vec3(alpha_y * cos_phi, alpha_x * sin_phi, alpha2 * cos_theta_m);
1166 | 	highp float v2 = dot(v, v);
1167 | 	float w2 = alpha2 / v2;
1168 | 	float D = alpha2 * w2 * w2 * (1.0 / M_PI);
1169 | 	return D;
1170 | }
1171 | 
1172 | float V_GGX_anisotropic(float alpha_x, float alpha_y, float TdotV, float TdotL, float BdotV, float BdotL, float NdotV, float NdotL) {
1173 | 	float Lambda_V = NdotL * length(vec3(alpha_x * TdotV, alpha_y * BdotV, NdotV));
1174 | 	float Lambda_L = NdotV * length(vec3(alpha_x * TdotL, alpha_y * BdotL, NdotL));
1175 | 	return 0.5 / (Lambda_V + Lambda_L);
1176 | }
1177 | 
1178 | float SchlickFresnel(float u) {
1179 | 	float m = 1.0 - u;
1180 | 	float m2 = m * m;
1181 | 	return m2 * m2 * m; 
1182 | }
1183 | 
1184 | vec3 F0(float metallic, float specular, vec3 albedo) {
1185 | 	float dielectric = 0.16 * specular * specular;
1186 | 	
1187 | 	
1188 | 	return mix(vec3(dielectric), albedo, vec3(metallic));
1189 | }
1190 | 
1191 | void light_compute(vec3 N, vec3 L, vec3 V, float A, vec3 light_color, bool is_directional, float attenuation, vec3 f0, uint orms, float specular_amount, vec3 albedo, inout float alpha, vec2 screen_uv,
1192 | #ifdef LIGHT_BACKLIGHT_USED
1193 | 		vec3 backlight,
1194 | #endif
1195 | #ifdef LIGHT_TRANSMITTANCE_USED
1196 | 		vec4 transmittance_color,
1197 | 		float transmittance_depth,
1198 | 		float transmittance_boost,
1199 | 		float transmittance_z,
1200 | #endif
1201 | #ifdef LIGHT_RIM_USED
1202 | 		float rim, float rim_tint,
1203 | #endif
1204 | #ifdef LIGHT_CLEARCOAT_USED
1205 | 		float clearcoat, float clearcoat_roughness, vec3 vertex_normal,
1206 | #endif
1207 | #ifdef LIGHT_ANISOTROPY_USED
1208 | 		vec3 B, vec3 T, float anisotropy,
1209 | #endif
1210 | 		inout vec3 diffuse_light, inout vec3 specular_light) {
1211 | 	vec4 orms_unpacked = unpackUnorm4x8(orms);
1212 | 	float roughness = orms_unpacked.y;
1213 | 	float metallic = orms_unpacked.z;
1214 | 
1215 | #if defined(LIGHT_CODE_USED)
1216 | 	
1217 | 	mat4 inv_view_matrix = scene_data_block.data.inv_view_matrix;
1218 | 	mat4 read_view_matrix = scene_data_block.data.view_matrix;
1219 | 
1220 | #ifdef USING_MOBILE_RENDERER
1221 | 	mat4 read_model_matrix = instances.data[draw_call.instance_index].transform;
1222 | #else
1223 | 	mat4 read_model_matrix = instances.data[instance_index_interp].transform;
1224 | #endif
1225 | 
1226 | #undef projection_matrix
1227 | #define projection_matrix scene_data_block.data.projection_matrix
1228 | #undef inv_projection_matrix
1229 | #define inv_projection_matrix scene_data_block.data.inv_projection_matrix
1230 | 
1231 | 	vec2 read_viewport_size = scene_data_block.data.viewport_size;
1232 | 	vec3 normal = N;
1233 | 	vec3 light = L;
1234 | 	vec3 view = V;
1235 | 
1236 | #else 
1237 | 	float NdotL = min(A + dot(N, L), 1.0);
1238 | 	float cNdotV = max(dot(N, V), 1e-4);
1239 | 
1240 | #ifdef LIGHT_TRANSMITTANCE_USED
1241 | 	{
1242 | #ifdef SSS_MODE_SKIN
1243 | 		float scale = 8.25 / transmittance_depth;
1244 | 		float d = scale * abs(transmittance_z);
1245 | 		float dd = -d * d;
1246 | 		vec3 profile = vec3(0.233, 0.455, 0.649) * exp(dd / 0.0064) +
1247 | 				vec3(0.1, 0.336, 0.344) * exp(dd / 0.0484) +
1248 | 				vec3(0.118, 0.198, 0.0) * exp(dd / 0.187) +
1249 | 				vec3(0.113, 0.007, 0.007) * exp(dd / 0.567) +
1250 | 				vec3(0.358, 0.004, 0.0) * exp(dd / 1.99) +
1251 | 				vec3(0.078, 0.0, 0.0) * exp(dd / 7.41);
1252 | 
1253 | 		diffuse_light += profile * transmittance_color.a * light_color * clamp(transmittance_boost - NdotL, 0.0, 1.0) * (1.0 / M_PI);
1254 | #else
1255 | 
1256 | 		float scale = 8.25 / transmittance_depth;
1257 | 		float d = scale * abs(transmittance_z);
1258 | 		float dd = -d * d;
1259 | 		diffuse_light += exp(dd) * transmittance_color.rgb * transmittance_color.a * light_color * clamp(transmittance_boost - NdotL, 0.0, 1.0) * (1.0 / M_PI);
1260 | #endif
1261 | 	}
1262 | #endif 
1263 | 
1264 | #if defined(LIGHT_RIM_USED)
1265 | 	
1266 | 	float rim_light = pow(max(1e-4, 1.0 - cNdotV), max(0.0, (1.0 - roughness) * 16.0));
1267 | 	diffuse_light += rim_light * rim * mix(vec3(1.0), albedo, rim_tint) * light_color;
1268 | #endif
1269 | 
1270 | 	
1271 | 	const float EPSILON = 1e-6f;
1272 | 	if (is_directional || attenuation > EPSILON) {
1273 | 		float cNdotL = max(NdotL, 0.0);
1274 | #if defined(DIFFUSE_BURLEY) || defined(SPECULAR_SCHLICK_GGX) || defined(LIGHT_CLEARCOAT_USED)
1275 | 		vec3 H = normalize(V + L);
1276 | #endif
1277 | #if defined(DIFFUSE_BURLEY) || defined(SPECULAR_SCHLICK_GGX) || defined(LIGHT_CLEARCOAT_USED)
1278 | 		float cLdotH = clamp(A + dot(L, H), 0.0, 1.0);
1279 | #endif
1280 | #if defined(LIGHT_CLEARCOAT_USED)
1281 | 		
1282 | 		float ccNdotL = max(min(A + dot(vertex_normal, L), 1.0), 0.0);
1283 | 		float ccNdotH = clamp(A + dot(vertex_normal, H), 0.0, 1.0);
1284 | 		float ccNdotV = max(dot(vertex_normal, V), 1e-4);
1285 | 		float cLdotH5 = SchlickFresnel(cLdotH);
1286 | 
1287 | 		float Dr = D_GGX(ccNdotH, mix(0.001, 0.1, clearcoat_roughness));
1288 | 		float Gr = 0.25 / (cLdotH * cLdotH);
1289 | 		float Fr = mix(.04, 1.0, cLdotH5);
1290 | 		float clearcoat_specular_brdf_NL = clearcoat * Gr * Fr * Dr * cNdotL;
1291 | 
1292 | 		specular_light += clearcoat_specular_brdf_NL * light_color * attenuation * specular_amount;
1293 | 
1294 | 		
1295 | 		
1296 | #endif 
1297 | 
1298 | 		if (metallic < 1.0) {
1299 | 			float diffuse_brdf_NL; 
1300 | 
1301 | #if defined(DIFFUSE_LAMBERT_WRAP)
1302 | 			
1303 | 			
1304 | 			diffuse_brdf_NL = max(0.0, (NdotL + roughness) / ((1.0 + roughness) * (1.0 + roughness))) * (1.0 / M_PI);
1305 | #elif defined(DIFFUSE_TOON)
1306 | 
1307 | 			diffuse_brdf_NL = smoothstep(-roughness, max(roughness, 0.01), NdotL) * (1.0 / M_PI);
1308 | 
1309 | #elif defined(DIFFUSE_BURLEY)
1310 | 			{
1311 | 				float FD90_minus_1 = 2.0 * cLdotH * cLdotH * roughness - 0.5;
1312 | 				float FdV = 1.0 + FD90_minus_1 * SchlickFresnel(cNdotV);
1313 | 				float FdL = 1.0 + FD90_minus_1 * SchlickFresnel(cNdotL);
1314 | 				diffuse_brdf_NL = (1.0 / M_PI) * FdV * FdL * cNdotL;
1315 | 			}
1316 | #else
1317 | 			
1318 | 			diffuse_brdf_NL = cNdotL * (1.0 / M_PI);
1319 | #endif
1320 | 
1321 | 			diffuse_light += light_color * diffuse_brdf_NL * attenuation;
1322 | 
1323 | #if defined(LIGHT_BACKLIGHT_USED)
1324 | 			diffuse_light += light_color * (vec3(1.0 / M_PI) - diffuse_brdf_NL) * backlight * attenuation;
1325 | #endif
1326 | 		}
1327 | 
1328 | 		if (roughness > 0.0) {
1329 | #if defined(SPECULAR_SCHLICK_GGX)
1330 | 			float cNdotH = clamp(A + dot(N, H), 0.0, 1.0);
1331 | #endif
1332 | 			
1333 | 			
1334 | #if defined(SPECULAR_TOON)
1335 | 			vec3 R = normalize(-reflect(L, N));
1336 | 			float RdotV = dot(R, V);
1337 | 			float mid = 1.0 - roughness;
1338 | 			mid *= mid;
1339 | 			float intensity = smoothstep(mid - roughness * 0.5, mid + roughness * 0.5, RdotV) * mid;
1340 | 			diffuse_light += light_color * intensity * attenuation * specular_amount; 
1341 | 
1342 | #elif defined(SPECULAR_DISABLED)
1343 | 			
1344 | 
1345 | #elif defined(SPECULAR_SCHLICK_GGX)
1346 | 			
1347 | 			float alpha_ggx = roughness * roughness;
1348 | #if defined(LIGHT_ANISOTROPY_USED)
1349 | 			float aspect = sqrt(1.0 - anisotropy * 0.9);
1350 | 			float ax = alpha_ggx / aspect;
1351 | 			float ay = alpha_ggx * aspect;
1352 | 			float XdotH = dot(T, H);
1353 | 			float YdotH = dot(B, H);
1354 | 			float D = D_GGX_anisotropic(cNdotH, ax, ay, XdotH, YdotH);
1355 | 			float G = V_GGX_anisotropic(ax, ay, dot(T, V), dot(T, L), dot(B, V), dot(B, L), cNdotV, cNdotL);
1356 | #else 
1357 | 			float D = D_GGX(cNdotH, alpha_ggx);
1358 | 			float G = V_GGX(cNdotL, cNdotV, alpha_ggx);
1359 | #endif 
1360 | 	   
1361 | #if !defined(LIGHT_CLEARCOAT_USED)
1362 | 			float cLdotH5 = SchlickFresnel(cLdotH);
1363 | #endif
1364 | 			
1365 | 			
1366 | 			float f90 = clamp(dot(f0, vec3(50.0 * 0.33)), metallic, 1.0);
1367 | 			vec3 F = f0 + (f90 - f0) * cLdotH5;
1368 | 			vec3 specular_brdf_NL = cNdotL * D * F * G;
1369 | 			specular_light += specular_brdf_NL * light_color * attenuation * specular_amount;
1370 | #endif
1371 | 		}
1372 | 
1373 | #ifdef USE_SHADOW_TO_OPACITY
1374 | 		alpha = min(alpha, clamp(1.0 - attenuation, 0.0, 1.0));
1375 | #endif
1376 | 	}
1377 | #endif 
1378 | }
