1544 | void light_process_omni(uint idx, vec3 vertex, vec3 eye_vec, vec3 normal, vec3 vertex_ddx, vec3 vertex_ddy, vec3 f0, uint orms, float taa_frame_count, vec3 albedo, inout float alpha, vec2 screen_uv,
1545 | #ifdef LIGHT_BACKLIGHT_USED
1546 | 		vec3 backlight,
1547 | #endif
1548 | #ifdef LIGHT_TRANSMITTANCE_USED
1549 | 		vec4 transmittance_color,
1550 | 		float transmittance_depth,
1551 | 		float transmittance_boost,
1552 | #endif
1553 | #ifdef LIGHT_RIM_USED
1554 | 		float rim, float rim_tint,
1555 | #endif
1556 | #ifdef LIGHT_CLEARCOAT_USED
1557 | 		float clearcoat, float clearcoat_roughness, vec3 vertex_normal,
