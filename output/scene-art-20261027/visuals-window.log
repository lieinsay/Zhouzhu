2255 | void sdfgi_process(uint cascade, vec3 cascade_pos, vec3 cam_pos, vec3 cam_normal, vec3 cam_specular_normal, bool use_specular, float roughness, out vec3 diffuse_light, out vec3 specular_light, out float blend) {
2256 | 	cascade_pos += cam_normal * sdfgi.normal_bias;
2257 | 
2258 | 	vec3 base_pos = floor(cascade_pos);
2259 | 	
2260 | 	ivec3 probe_base_pos = ivec3(base_pos);
2261 | 
2262 | 	vec4 diffuse_accum = vec4(0.0);
2263 | 	vec3 specular_accum;
2264 | 
2265 | 	ivec3 tex_pos = ivec3(probe_base_pos.xy, int(cascade));
2266 | 	tex_pos.x += probe_base_pos.z * sdfgi.probe_axis_size;
2267 | 	tex_pos.xy = tex_pos.xy * (SDFGI_OCT_SIZE + 2) + ivec2(1);
2268 | 
2269 | 	vec3 diffuse_posf = (vec3(tex_pos) + vec3(octahedron_encode(cam_normal) * float(SDFGI_OCT_SIZE), 0.0)) * sdfgi.lightprobe_tex_pixel_size;
2270 | 
2271 | 	vec3 specular_posf;
2272 | 
2273 | 	if (use_specular) {
2274 | 		specular_accum = vec3(0.0);
2275 | 		specular_posf = (vec3(tex_pos) + vec3(octahedron_encode(cam_specular_normal) * float(SDFGI_OCT_SIZE), 0.0)) * sdfgi.lightprobe_tex_pixel_size;
2276 | 	}
2277 | 
2278 | 	vec4 light_accum = vec4(0.0);
2279 | 	float weight_accum = 0.0;
2280 | 
2281 | 	for (uint j = 0; j < 8; j++) {
2282 | 		ivec3 offset = (ivec3(j) >> ivec3(0, 1, 2)) & ivec3(1, 1, 1);
2283 | 		ivec3 probe_posi = probe_base_pos;
2284 | 		probe_posi += offset;
2285 | 
2286 | 		
2287 | 
2288 | 		vec3 probe_pos = vec3(probe_posi);
2289 | 		vec3 probe_to_pos = cascade_pos - probe_pos;
2290 | 		vec3 probe_dir = normalize(-probe_to_pos);
2291 | 
2292 | 		vec3 trilinear = vec3(1.0) - abs(probe_to_pos);
2293 | 		float weight = trilinear.x * trilinear.y * trilinear.z * max(0.005, dot(cam_normal, probe_dir));
2294 | 
2295 | 		
2296 | 
2297 | 		if (sdfgi.use_occlusion) {
2298 | 			ivec3 occ_indexv = abs((sdfgi.cascades[cascade].probe_world_offset + probe_posi) & ivec3(1, 1, 1)) * ivec3(1, 2, 4);
2299 | 			vec4 occ_mask = mix(vec4(0.0), vec4(1.0), equal(ivec4(occ_indexv.x | occ_indexv.y), ivec4(0, 1, 2, 3)));
2300 | 
2301 | 			vec3 occ_pos = clamp(cascade_pos, probe_pos - sdfgi.occlusion_clamp, probe_pos + sdfgi.occlusion_clamp) * sdfgi.probe_to_uvw;
2302 | 			occ_pos.z += float(cascade);
2303 | 			if (occ_indexv.z != 0) { 
2304 | 				occ_pos.x += 1.0;
2305 | 			}
2306 | 
2307 | 			occ_pos *= sdfgi.occlusion_renormalize;
2308 | 			float occlusion = dot(textureLod(sampler3D(sdfgi_occlusion_cascades, SAMPLER_LINEAR_CLAMP), occ_pos, 0.0), occ_mask);
2309 | 
2310 | 			weight *= max(occlusion, 0.01);
2311 | 		}
2312 | 
2313 | 		
2314 | 
2315 | 		vec3 diffuse;
2316 | 		vec3 pos_uvw = diffuse_posf;
2317 | 		pos_uvw.xy += vec2(offset.xy) * sdfgi.lightprobe_uv_offset.xy;
2318 | 		pos_uvw.x += float(offset.z) * sdfgi.lightprobe_uv_offset.z;
2319 | 		diffuse = textureLod(sampler2DArray(sdfgi_lightprobe_texture, SAMPLER_LINEAR_CLAMP), pos_uvw, 0.0).rgb;
2320 | 
2321 | 		diffuse_accum += vec4(diffuse * weight * sdfgi.cascades[cascade].exposure_normalization, weight);
2322 | 
2323 | 		if (use_specular) {
2324 | 			vec3 specular = vec3(0.0);
2325 | 			vec3 pos_uvw = specular_posf;
2326 | 			pos_uvw.xy += vec2(offset.xy) * sdfgi.lightprobe_uv_offset.xy;
2327 | 			pos_uvw.x += float(offset.z) * sdfgi.lightprobe_uv_offset.z;
2328 | 			if (roughness < 0.99) {
2329 | 				specular = textureLod(sampler2DArray(sdfgi_lightprobe_texture, SAMPLER_LINEAR_CLAMP), pos_uvw + vec3(0, 0, float(sdfgi.max_cascades)), 0.0).rgb;
2330 | 			}
2331 | 			if (roughness > 0.5) {
2332 | 				specular = mix(specular, textureLod(sampler2DArray(sdfgi_lightprobe_texture, SAMPLER_LINEAR_CLAMP), pos_uvw, 0.0).rgb, (roughness - 0.5) * 2.0);
2333 | 			}
2334 | 
2335 | 			specular_accum += specular * weight * sdfgi.cascades[cascade].exposure_normalization;
2336 | 		}
2337 | 	}
2338 | 
2339 | 	if (diffuse_accum.a > 0.0) {
2340 | 		diffuse_accum.rgb /= diffuse_accum.a;
2341 | 	}
2342 | 
2343 | 	diffuse_light = diffuse_accum.rgb;
2344 | 
2345 | 	if (use_specular) {
2346 | 		if (diffuse_accum.a > 0.0) {
2347 | 			specular_accum /= diffuse_accum.a;
2348 | 		}
2349 | 
2350 | 		specular_light = specular_accum;
2351 | 	}
2352 | 
2353 | 	{
2354 | 		
2355 | 		float blend_from = (float(sdfgi.probe_axis_size - 1) / 2.0) - 2.5;
2356 | 		float blend_to = blend_from + 2.0;
2357 | 
2358 | 		vec3 inner_pos = cam_pos * sdfgi.cascades[cascade].to_probe;
2359 | 
2360 | 		float len = length(inner_pos);
2361 | 
2362 | 		inner_pos = abs(normalize(inner_pos));
2363 | 		len *= max(inner_pos.x, max(inner_pos.y, inner_pos.z));
2364 | 
2365 | 		if (len >= blend_from) {
2366 | 			blend = smoothstep(blend_from, blend_to, len);
2367 | 		} else {
2368 | 			blend = 0.0;
2369 | 		}
2370 | 	}
2371 | }
2372 | 
