1392 | float sample_directional_pcf_shadow(texture2D shadow, vec2 shadow_pixel_size, vec4 coord, float taa_frame_count) {
1393 | 	vec2 pos = coord.xy;
1394 | 	float depth = coord.z;
1395 | 
1396 | 	
1397 | 	if (sc_directional_soft_shadow_samples() == 0) {
1398 | 		return textureProj(sampler2DShadow(shadow, shadow_sampler), vec4(pos, depth, 1.0));
1399 | 	}
1400 | 
1401 | 	mat2 disk_rotation;
1402 | 	{
1403 | 		float r = quick_hash(gl_FragCoord.xy + vec2(taa_frame_count * 5.588238)) * 2.0 * M_PI;
1404 | 		float sr = sin(r);
1405 | 		float cr = cos(r);
1406 | 		disk_rotation = mat2(vec2(cr, -sr), vec2(sr, cr));
1407 | 	}
1408 | 
1409 | 	float avg = 0.0;
1410 | 
1411 | 	SPEC_CONSTANT_LOOP_ANNOTATION
1412 | 	for (uint i = 0; i < sc_directional_soft_shadow_samples(); i++) {
1413 | 		avg += textureProj(sampler2DShadow(shadow, shadow_sampler), vec4(pos + shadow_pixel_size * (disk_rotation * scene_data_block.data.directional_soft_shadow_kernel[i].xy), depth, 1.0));
1414 | 	}
1415 | 
1416 | 	return avg * (1.0 / float(sc_directional_soft_shadow_samples()));
1417 | }
1418 | 
1419 | float sample_pcf_shadow(texture2D shadow, vec2 shadow_pixel_size, vec3 coord, float taa_frame_count) {
1420 | 	vec2 pos = coord.xy;
1421 | 	float depth = coord.z;
1422 | 
1423 | 	
1424 | 	if (sc_soft_shadow_samples() == 0) {
1425 | 		return textureProj(sampler2DShadow(shadow, shadow_sampler), vec4(pos, depth, 1.0));
1426 | 	}
1427 | 
1428 | 	mat2 disk_rotation;
1429 | 	{
1430 | 		float r = quick_hash(gl_FragCoord.xy + vec2(taa_frame_count * 5.588238)) * 2.0 * M_PI;
1431 | 		float sr = sin(r);
1432 | 		float cr = cos(r);
1433 | 		disk_rotation = mat2(vec2(cr, -sr), vec2(sr, cr));
1434 | 	}
1435 | 
1436 | 	float avg = 0.0;
1437 | 
1438 | 	SPEC_CONSTANT_LOOP_ANNOTATION
1439 | 	for (uint i = 0; i < sc_soft_shadow_samples(); i++) {
1440 | 		avg += textureProj(sampler2DShadow(shadow, shadow_sampler), vec4(pos + shadow_pixel_size * (disk_rotation * scene_data_block.data.soft_shadow_kernel[i].xy), depth, 1.0));
1441 | 	}
1442 | 
1443 | 	return avg * (1.0 / float(sc_soft_shadow_samples()));
