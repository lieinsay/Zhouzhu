2201 | 	vec3 cone_dirs[MAX_CONE_DIRS] = vec3[](
2202 | 			vec3(0.707107, 0.0, 0.707107),
2203 | 			vec3(0.0, 0.707107, 0.707107),
2204 | 			vec3(-0.707107, 0.0, 0.707107),
2205 | 			vec3(0.0, -0.707107, 0.707107));
