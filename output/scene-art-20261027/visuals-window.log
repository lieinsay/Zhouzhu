2136 | 		float diameter = max(1.0, 2.0 * tan_half_angle * dist);
2137 | 		vec3 uvw_pos = (pos + dist * direction) * cell_size;
2138 | 		float half_diameter = diameter * 0.5;
2139 | 		
2140 | 		if (any(greaterThan(abs(uvw_pos - 0.5), vec3(0.5f + half_diameter * cell_size)))) {
2141 | 			break;
2142 | 		}
2143 | 		vec4 scolor = textureLod(sampler3D(probe, DEFAULT_SAMPLER_LINEAR_WITH_MIPMAPS_CLAMP), uvw_pos, log2(diameter));
2144 | 		float a = (1.0 - color.a);
2145 | 		color += a * scolor;
2146 | 		dist += half_diameter;
2147 | 	}
2148 | 
2149 | 	return color;
