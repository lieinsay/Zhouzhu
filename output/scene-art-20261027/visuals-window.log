2133 | vec4 voxel_cone_trace(texture3D probe, vec3 cell_size, vec3 pos, vec3 direction, float tan_half_angle, float max_distance, float p_bias) {
2134 | 	float dist = p_bias;
2135 | 	vec4 color = vec4(0.0);
2136 | 
2137 | 	while (dist < max_distance && color.a < 0.95) {
2138 | 		float diameter = max(1.0, 2.0 * tan_half_angle * dist);
2139 | 		vec3 uvw_pos = (pos + dist * direction) * cell_size;
2140 | 		float half_diameter = diameter * 0.5;
2141 | 		
2142 | 		if (any(greaterThan(abs(uvw_pos - 0.5), vec3(0.5f + half_diameter * cell_size)))) {
2143 | 			break;
2144 | 		}
2145 | 		vec4 scolor = textureLod(sampler3D(probe, DEFAULT_SAMPLER_LINEAR_WITH_MIPMAPS_CLAMP), uvw_pos, log2(diameter));
2146 | 		float a = (1.0 - color.a);
2147 | 		color += a * scolor;
2148 | 		dist += half_diameter;
2149 | 	}
2150 | 
2151 | 	return color;
2152 | }
