1150 | float D_GGX(float cos_theta_m, float alpha) {
1151 | 	float a = cos_theta_m * alpha;
1152 | 	float k = alpha / (1.0 - cos_theta_m * cos_theta_m + a * a);
1153 | 	return k * k * (1.0 / M_PI);
1154 | }
1155 | 
1156 | 
1157 | float V_GGX(float NdotL, float NdotV, float alpha) {
1158 | 	return 0.5 / mix(2.0 * NdotL * NdotV, NdotL + NdotV, alpha);
1159 | }
1160 | 
1161 | float D_GGX_anisotropic(float cos_theta_m, float alpha_x, float alpha_y, float cos_phi, float sin_phi) {
1162 | 	float alpha2 = alpha_x * alpha_y;
1163 | 	highp vec3 v = vec3(alpha_y * cos_phi, alpha_x * sin_phi, alpha2 * cos_theta_m);
1164 | 	highp float v2 = dot(v, v);
1165 | 	float w2 = alpha2 / v2;
1166 | 	float D = alpha2 * w2 * w2 * (1.0 / M_PI);
1167 | 	return D;
1168 | }
1169 | 
1170 | float V_GGX_anisotropic(float alpha_x, float alpha_y, float TdotV, float TdotL, float BdotV, float BdotL, float NdotV, float NdotL) {
1171 | 	float Lambda_V = NdotL * length(vec3(alpha_x * TdotV, alpha_y * BdotV, NdotV));
1172 | 	float Lambda_L = NdotV * length(vec3(alpha_x * TdotL, alpha_y * BdotL, NdotL));
1173 | 	return 0.5 / (Lambda_V + Lambda_L);
1174 | }
1175 | 
1176 | float SchlickFresnel(float u) {
1177 | 	float m = 1.0 - u;
1178 | 	float m2 = m * m;
1179 | 	return m2 * m2 * m; 
1180 | }
