1254 | 		diffuse_light += profile * transmittance_color.a * light_color * clamp(transmittance_boost - NdotL, 0.0, 1.0) * (1.0 / M_PI);
1255 | #else
1256 | 
1257 | 		float scale = 8.25 / transmittance_depth;
1258 | 		float d = scale * abs(transmittance_z);
1259 | 		float dd = -d * d;
1260 | 		diffuse_light += exp(dd) * transmittance_color.rgb * transmittance_color.a * light_color * clamp(transmittance_boost - NdotL, 0.0, 1.0) * (1.0 / M_PI);
1261 | #endif
1262 | 	}
1263 | #endif 
1264 | 
1265 | #if defined(LIGHT_RIM_USED)
1266 | 	
1267 | 	float rim_light = pow(max(1e-4, 1.0 - cNdotV), max(0.0, (1.0 - roughness) * 16.0));
