1294 | 
1295 | 		
1296 | 		
1297 | #endif 
1298 | 
1299 | 		if (metallic < 1.0) {
1300 | 			float diffuse_brdf_NL; 
1301 | 
1302 | #if defined(DIFFUSE_LAMBERT_WRAP)
1303 | 			
1304 | 			
1305 | 			diffuse_brdf_NL = max(0.0, (NdotL + roughness) / ((1.0 + roughness) * (1.0 + roughness))) * (1.0 / M_PI);
1306 | #elif defined(DIFFUSE_TOON)
