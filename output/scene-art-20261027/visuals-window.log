 721 | 
 722 | float w0(float a) {
 723 | 	return (1.0 / 6.0) * (a * (a * (-a + 3.0) - 3.0) + 1.0);
 724 | }
 725 | 
 726 | float w1(float a) {
 727 | 	return (1.0 / 6.0) * (a * a * (3.0 * a - 6.0) + 4.0);
 728 | }
 729 | 
 730 | float w2(float a) {
 731 | 	return (1.0 / 6.0) * (a * (a * (-3.0 * a + 3.0) + 3.0) + 1.0);
 732 | }
 733 | 
 734 | float w3(float a) {
 735 | 	return (1.0 / 6.0) * (a * a * a);
 736 | }
 737 | 
 738 | 
 739 | float g0(float a) {
 740 | 	return w0(a) + w1(a);
 741 | }
 742 | 
 743 | float g1(float a) {
 744 | 	return w2(a) + w3(a);
 745 | }
 746 | 
 747 | 
 748 | float h0(float a) {
 749 | 	return -1.0 + w1(a) / (w0(a) + w1(a));
 750 | }
 751 | 
 752 | float h1(float a) {
 753 | 	return 1.0 + w3(a) / (w2(a) + w3(a));
 754 | }
 755 | 
 756 | vec4 textureArray_bicubic(texture2DArray tex, vec3 uv, vec2 texture_size) {
 757 | 	vec2 texel_size = vec2(1.0) / texture_size;
 758 | 
 759 | 	uv.xy = uv.xy * texture_size + vec2(0.5);
 760 | 
 761 | 	vec2 iuv = floor(uv.xy);
 762 | 	vec2 fuv = fract(uv.xy);
 763 | 
 764 | 	float g0x = g0(fuv.x);
 765 | 	float g1x = g1(fuv.x);
 766 | 	float h0x = h0(fuv.x);
 767 | 	float h1x = h1(fuv.x);
 768 | 	float h0y = h0(fuv.y);
