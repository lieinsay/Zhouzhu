2388 | vec4 fog_process(vec3 vertex) {
2389 | 	vec3 fog_color = scene_data_block.data.fog_light_color;
2390 | 
2391 | 	if (scene_data_block.data.fog_aerial_perspective > 0.0) {
2392 | 		vec3 sky_fog_color = vec3(0.0);
2393 | 		vec3 cube_view = scene_data_block.data.radiance_inverse_xform * vertex;
2394 | 		
2395 | 		float mip_level = mix(1.0 / MAX_ROUGHNESS_LOD, 1.0, 1.0 - (abs(vertex.z) - scene_data_block.data.z_near) / (scene_data_block.data.z_far - scene_data_block.data.z_near));
2396 | #ifdef USE_RADIANCE_CUBEMAP_ARRAY
2397 | 		float lod, blend;
2398 | 		blend = modf(mip_level * MAX_ROUGHNESS_LOD, lod);
2399 | 		sky_fog_color = texture(samplerCubeArray(radiance_cubemap, DEFAULT_SAMPLER_LINEAR_WITH_MIPMAPS_CLAMP), vec4(cube_view, lod)).rgb;
2400 | 		sky_fog_color = mix(sky_fog_color, texture(samplerCubeArray(radiance_cubemap, DEFAULT_SAMPLER_LINEAR_WITH_MIPMAPS_CLAMP), vec4(cube_view, lod + 1)).rgb, blend);
2401 | #else
2402 | 		sky_fog_color = textureLod(samplerCube(radiance_cubemap, DEFAULT_SAMPLER_LINEAR_WITH_MIPMAPS_CLAMP), cube_view, mip_level * MAX_ROUGHNESS_LOD).rgb;
2403 | #endif 
2404 | 		fog_color = mix(fog_color, sky_fog_color, scene_data_block.data.fog_aerial_perspective);
2405 | 	}
2406 | 
2407 | 	if (scene_data_block.data.fog_sun_scatter > 0.001) {
2408 | 		vec4 sun_scatter = vec4(0.0);
2409 | 		float sun_total = 0.0;
2410 | 		vec3 view = normalize(vertex);
2411 | 
2412 | 		for (uint i = 0; i < scene_data_block.data.directional_light_count; i++) {
2413 | 			vec3 light_color = directional_lights.data[i].color * directional_lights.data[i].energy;
2414 | 			float light_amount = pow(max(dot(view, directional_lights.data[i].direction), 0.0), 8.0);
2415 | 			fog_color += light_color * light_amount * scene_data_block.data.fog_sun_scatter;
2416 | 		}
2417 | 	}
2418 | 
2419 | 	float fog_amount = 0.0;
2420 | 
2421 | 	if (sc_use_depth_fog()) {
2422 | 		float fog_z = smoothstep(scene_data_block.data.fog_depth_begin, scene_data_block.data.fog_depth_end, length(vertex));
2423 | 		float fog_quad_amount = pow(fog_z, scene_data_block.data.fog_depth_curve) * scene_data_block.data.fog_density;
2424 | 		fog_amount = fog_quad_amount;
2425 | 	} else {
2426 | 		fog_amount = 1 - exp(min(0.0, -length(vertex) * scene_data_block.data.fog_density));
2427 | 	}
2428 | 
2429 | 	if (abs(scene_data_block.data.fog_height_density) >= 0.0001) {
2430 | 		float y = (scene_data_block.data.inv_view_matrix * vec4(vertex, 1.0)).y;
2431 | 
2432 | 		float y_dist = y - scene_data_block.data.fog_height;
2433 | 
2434 | 		float vfog_amount = 1.0 - exp(min(0.0, y_dist * scene_data_block.data.fog_height_density));
2435 | 
2436 | 		fog_amount = max(vfog_amount, fog_amount);
2437 | 	}
2438 | 
2439 | 	return vec4(fog_color, fog_amount);
2440 | }
