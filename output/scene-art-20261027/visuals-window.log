1240 | 
1241 | #ifdef LIGHT_TRANSMITTANCE_USED
1242 | 	{
1243 | #ifdef SSS_MODE_SKIN
1244 | 		float scale = 8.25 / transmittance_depth;
1245 | 		float d = scale * abs(transmittance_z);
1246 | 		float dd = -d * d;
1247 | 		vec3 profile = vec3(0.233, 0.455, 0.649) * exp(dd / 0.0064) +
1248 | 				vec3(0.1, 0.336, 0.344) * exp(dd / 0.0484) +
1249 | 				vec3(0.118, 0.198, 0.0) * exp(dd / 0.187) +
1250 | 				vec3(0.113, 0.007, 0.007) * exp(dd / 0.567) +
1251 | 				vec3(0.358, 0.004, 0.0) * exp(dd / 1.99) +
1252 | 				vec3(0.078, 0.0, 0.0) * exp(dd / 7.41);
