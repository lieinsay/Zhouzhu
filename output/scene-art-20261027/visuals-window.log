1420 | 
1421 | 	
1422 | 	if (sc_soft_shadow_samples() == 0) {
1423 | 		return textureProj(sampler2DShadow(shadow, shadow_sampler), vec4(pos, depth, 1.0));
1424 | 	}
1425 | 
1426 | 	mat2 disk_rotation;
1427 | 	{
1428 | 		float r = quick_hash(gl_FragCoord.xy + vec2(taa_frame_count * 5.588238)) * 2.0 * M_PI;
1429 | 		float sr = sin(r);
1430 | 		float cr = cos(r);
1431 | 		disk_rotation = mat2(vec2(cr, -sr), vec2(sr, cr));
1432 | 	}
1433 | 
1434 | 	float avg = 0.0;
1435 | 
1436 | 	SPEC_CONSTANT_LOOP_ANNOTATION
1437 | 	for (uint i = 0; i < sc_soft_shadow_samples(); i++) {
1438 | 		avg += textureProj(sampler2DShadow(shadow, shadow_sampler), vec4(pos + shadow_pixel_size * (disk_rotation * scene_data_block.data.soft_shadow_kernel[i].xy), depth, 1.0));
1439 | 	}
1440 | 
1441 | 	return avg * (1.0 / float(sc_soft_shadow_samples()));
