 719 | float w0(float a) {
 720 | 	return (1.0 / 6.0) * (a * (a * (-a + 3.0) - 3.0) + 1.0);
 721 | }
 722 | 
 723 | float w1(float a) {
 724 | 	return (1.0 / 6.0) * (a * a * (3.0 * a - 6.0) + 4.0);
 725 | }
 726 | 
 727 | float w2(float a) {
 728 | 	return (1.0 / 6.0) * (a * (a * (-3.0 * a + 3.0) + 3.0) + 1.0);
 729 | }
 730 | 
 731 | float w3(float a) {
 732 | 	return (1.0 / 6.0) * (a * a * a);
 733 | }
 734 | 
 735 | 
 736 | float g0(float a) {
 737 | 	return w0(a) + w1(a);
 738 | }
 739 | 
 740 | float g1(float a) {
 741 | 	return w2(a) + w3(a);
 742 | }
 743 | 
 744 | 
 745 | float h0(float a) {
 746 | 	return -1.0 + w1(a) / (w0(a) + w1(a));
 747 | }
 748 | 
 749 | float h1(float a) {
 750 | 	return 1.0 + w3(a) / (w2(a) + w3(a));
 751 | }
