1420 | 
1421 | 	
1422 | 	if (sc_soft_shadow_samples() == 0) {
1423 | 		return textureProj(sampler2DShadow(shadow, shadow_sampler), vec4(pos, depth, 1.0));
1424 | 	}
1425 | 
1426 | 	mat2 disk_rotation;
1427 | 	{
1428 | 		float r = quick_hash(gl_FragCoord.xy + vec2(taa_frame_count * 5.588238)) * 2.0 * M_PI;
1429 | 		float sr = sin(r);
1430 | 		float cr = cos(r);
1431 | 		disk_rotation = mat2(vec2(cr, -sr), vec2(sr, cr));
1432 | 	}
1433 | 
1434 | 	float avg = 0.0;
1435 | 
1436 | 	SPEC_CONSTANT_LOOP_ANNOTATION
1437 | 	for (uint i = 0; i < sc_soft_shadow_samples(); i++) {
1438 | 		avg += textureProj(sampler2DShadow(shadow, shadow_sampler), vec4(pos + shadow_pixel_size * (disk_rotation * scene_data_block.data.soft_shadow_kernel[i].xy), depth, 1.0));
1439 | 	}
1440 | 
1441 | 	return avg * (1.0 / float(sc_soft_shadow_samples()));
1442 | }
1443 | 
1444 | float sample_omni_pcf_shadow(texture2D shadow, float blur_scale, vec2 coord, vec4 uv_rect, vec2 flip_offset, float depth, float taa_frame_count) {
1445 | 	
1446 | 	if (sc_soft_shadow_samples() == 0) {
1447 | 		vec2 pos = coord * 0.5 + 0.5;
1448 | 		pos = uv_rect.xy + pos * uv_rect.zw;
1449 | 		return textureProj(sampler2DShadow(shadow, shadow_sampler), vec4(pos, depth, 1.0));
1450 | 	}
1451 | 
1452 | 	mat2 disk_rotation;
1453 | 	{
1454 | 		float r = quick_hash(gl_FragCoord.xy + vec2(taa_frame_count * 5.588238)) * 2.0 * M_PI;
1455 | 		float sr = sin(r);
1456 | 		float cr = cos(r);
1457 | 		disk_rotation = mat2(vec2(cr, -sr), vec2(sr, cr));
1458 | 	}
1459 | 
1460 | 	float avg = 0.0;
1461 | 	vec2 offset_scale = blur_scale * 2.0 * scene_data_block.data.shadow_atlas_pixel_size / uv_rect.zw;
1462 | 
1463 | 	SPEC_CONSTANT_LOOP_ANNOTATION
1464 | 	for (uint i = 0; i < sc_soft_shadow_samples(); i++) {
1465 | 		vec2 offset = offset_scale * (disk_rotation * scene_data_block.data.soft_shadow_kernel[i].xy);
1466 | 		vec2 sample_coord = coord + offset;
1467 | 
1468 | 		float sample_coord_length_squared = dot(sample_coord, sample_coord);
1469 | 		bool do_flip = sample_coord_length_squared > 1.0;
1470 | 
1471 | 		if (do_flip) {
1472 | 			float len = sqrt(sample_coord_length_squared);
1473 | 			sample_coord = sample_coord * (2.0 / len - 1.0);
1474 | 		}
1475 | 
1476 | 		sample_coord = sample_coord * 0.5 + 0.5;
1477 | 		sample_coord = uv_rect.xy + sample_coord * uv_rect.zw;
1478 | 
1479 | 		if (do_flip) {
1480 | 			sample_coord += flip_offset;
1481 | 		}
1482 | 		avg += textureProj(sampler2DShadow(shadow, shadow_sampler), vec4(sample_coord, depth, 1.0));
1483 | 	}
1484 | 
1485 | 	return avg * (1.0 / float(sc_soft_shadow_samples()));
1486 | }
