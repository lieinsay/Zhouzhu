2242 | vec2 octahedron_wrap(vec2 v) {
2243 | 	vec2 signVal;
2244 | 	signVal.x = v.x >= 0.0 ? 1.0 : -1.0;
2245 | 	signVal.y = v.y >= 0.0 ? 1.0 : -1.0;
2246 | 	return (1.0 - abs(v.yx)) * signVal;
2247 | }
2248 | 
2249 | vec2 octahedron_encode(vec3 n) {
2250 | 	
2251 | 	n /= (abs(n.x) + abs(n.y) + abs(n.z));
2252 | 	n.xy = n.z >= 0.0 ? n.xy : octahedron_wrap(n.xy);
2253 | 	n.xy = n.xy * 0.5 + 0.5;
2254 | 	return n.xy;
2255 | }
