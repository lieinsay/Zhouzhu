 661 | vec4 normal_roughness_compatibility(vec4 p_normal_roughness) {
 662 | 	float roughness = p_normal_roughness.w;
 663 | 	if (roughness > 0.5) {
 664 | 		roughness = 1.0 - roughness;
 665 | 	}
 666 | 	roughness /= (127.0 / 255.0);
 667 | 	return vec4(normalize(p_normal_roughness.xyz * 2.0 - 1.0) * 0.5 + 0.5, roughness);
 668 | }
