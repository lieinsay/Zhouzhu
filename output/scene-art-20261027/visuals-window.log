1073 | 
1074 | float hash_2d(vec2 p) {
1075 | 	return fract(1.0e4 * sin(17.0 * p.x + 0.1 * p.y) *
1076 | 			(0.1 + abs(sin(13.0 * p.y + p.x))));
1077 | }
1078 | 
1079 | float hash_3d(vec3 p) {
1080 | 	return hash_2d(vec2(hash_2d(p.xy), p.z));
1081 | }
1082 | 
1083 | float compute_alpha_hash_threshold(vec3 pos, float hash_scale) {
1084 | 	vec3 dx = dFdx(pos);
1085 | 	vec3 dy = dFdy(pos);
1086 | 
1087 | 	float delta_max_sqr = max(length(dx), length(dy));
1088 | 	float pix_scale = 1.0 / (hash_scale * delta_max_sqr);
1089 | 
1090 | 	vec2 pix_scales =
1091 | 			vec2(exp2(floor(log2(pix_scale))), exp2(ceil(log2(pix_scale))));
1092 | 
1093 | 	vec2 a_thresh = vec2(hash_3d(floor(pix_scales.x * pos.xyz)),
1094 | 			hash_3d(floor(pix_scales.y * pos.xyz)));
1095 | 
1096 | 	float lerp_factor = fract(log2(pix_scale));
1097 | 
1098 | 	float a_interp = (1.0 - lerp_factor) * a_thresh.x + lerp_factor * a_thresh.y;
1099 | 
1100 | 	float min_lerp = min(lerp_factor, 1.0 - lerp_factor);
1101 | 
1102 | 	vec3 cases = vec3(a_interp * a_interp / (2.0 * min_lerp * (1.0 - min_lerp)),
1103 | 			(a_interp - 0.5 * min_lerp) / (1.0 - min_lerp),
1104 | 			1.0 - ((1.0 - a_interp) * (1.0 - a_interp) / (2.0 * min_lerp * (1.0 - min_lerp))));
1105 | 
1106 | 	float alpha_hash_threshold =
1107 | 			(a_interp < (1.0 - min_lerp)) ? ((a_interp < min_lerp) ? cases.x : cases.y) : cases.z;
1108 | 
1109 | 	return clamp(alpha_hash_threshold, 0.00001, 1.0);
1110 | }
1111 | 
1112 | #endif 
