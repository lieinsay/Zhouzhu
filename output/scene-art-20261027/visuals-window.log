1441 | float sample_omni_pcf_shadow(texture2D shadow, float blur_scale, vec2 coord, vec4 uv_rect, vec2 flip_offset, float depth, float taa_frame_count) {
1442 | 	
1443 | 	if (sc_soft_shadow_samples() == 0) {
1444 | 		vec2 pos = coord * 0.5 + 0.5;
1445 | 		pos = uv_rect.xy + pos * uv_rect.zw;
1446 | 		return textureProj(sampler2DShadow(shadow, shadow_sampler), vec4(pos, depth, 1.0));
1447 | 	}
1448 | 
1449 | 	mat2 disk_rotation;
1450 | 	{
1451 | 		float r = quick_hash(gl_FragCoord.xy + vec2(taa_frame_count * 5.588238)) * 2.0 * M_PI;
1452 | 		float sr = sin(r);
1453 | 		float cr = cos(r);
1454 | 		disk_rotation = mat2(vec2(cr, -sr), vec2(sr, cr));
1455 | 	}
1456 | 
1457 | 	float avg = 0.0;
1458 | 	vec2 offset_scale = blur_scale * 2.0 * scene_data_block.data.shadow_atlas_pixel_size / uv_rect.zw;
1459 | 
1460 | 	SPEC_CONSTANT_LOOP_ANNOTATION
1461 | 	for (uint i = 0; i < sc_soft_shadow_samples(); i++) {
1462 | 		vec2 offset = offset_scale * (disk_rotation * scene_data_block.data.soft_shadow_kernel[i].xy);
1463 | 		vec2 sample_coord = coord + offset;
1464 | 
1465 | 		float sample_coord_length_squared = dot(sample_coord, sample_coord);
1466 | 		bool do_flip = sample_coord_length_squared > 1.0;
1467 | 
1468 | 		if (do_flip) {
1469 | 			float len = sqrt(sample_coord_length_squared);
1470 | 			sample_coord = sample_coord * (2.0 / len - 1.0);
1471 | 		}
1472 | 
1473 | 		sample_coord = sample_coord * 0.5 + 0.5;
1474 | 		sample_coord = uv_rect.xy + sample_coord * uv_rect.zw;
1475 | 
1476 | 		if (do_flip) {
1477 | 			sample_coord += flip_offset;
1478 | 		}
1479 | 		avg += textureProj(sampler2DShadow(shadow, shadow_sampler), vec4(sample_coord, depth, 1.0));
1480 | 	}
1481 | 
1482 | 	return avg * (1.0 / float(sc_soft_shadow_samples()));
1483 | }
