1327 | 		}
1328 | 
1329 | 		if (roughness > 0.0) {
1330 | #if defined(SPECULAR_SCHLICK_GGX)
1331 | 			float cNdotH = clamp(A + dot(N, H), 0.0, 1.0);
1332 | #endif
1333 | 			
1334 | 			
1335 | #if defined(SPECULAR_TOON)
1336 | 			vec3 R = normalize(-reflect(L, N));
1337 | 			float RdotV = dot(R, V);
1338 | 			float mid = 1.0 - roughness;
1339 | 			mid *= mid;
1340 | 			float intensity = smoothstep(mid - roughness * 0.5, mid + roughness * 0.5, RdotV) * mid;
1341 | 			diffuse_light += light_color * intensity * attenuation * specular_amount; 
1342 | 
1343 | #elif defined(SPECULAR_DISABLED)
1344 | 			
1345 | 
1346 | #elif defined(SPECULAR_SCHLICK_GGX)
1347 | 			
1348 | 			float alpha_ggx = roughness * roughness;
1349 | #if defined(LIGHT_ANISOTROPY_USED)
1350 | 			float aspect = sqrt(1.0 - anisotropy * 0.9);
1351 | 			float ax = alpha_ggx / aspect;
1352 | 			float ay = alpha_ggx * aspect;
