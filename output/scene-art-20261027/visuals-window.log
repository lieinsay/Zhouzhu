1555 | #ifdef LIGHT_RIM_USED
1556 | 		float rim, float rim_tint,
1557 | #endif
1558 | #ifdef LIGHT_CLEARCOAT_USED
1559 | 		float clearcoat, float clearcoat_roughness, vec3 vertex_normal,
