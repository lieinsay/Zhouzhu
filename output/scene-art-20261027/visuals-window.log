2046 | 		blend = pow(blend_axes.x * blend_axes.y * blend_axes.z, 2.0);
2047 | 	}
2048 | 
2049 | 	if (reflections.data[ref_index].intensity > 0.0 && reflection_accum.a < 1.0) { 
2050 | 
2051 | 		vec3 local_ref_vec = (reflections.data[ref_index].local_matrix * vec4(ref_vec, 0.0)).xyz;
2052 | 
2053 | 		if (reflections.data[ref_index].box_project) { 
2054 | 
2055 | 			vec3 nrdir = normalize(local_ref_vec);
2056 | 			vec3 rbmax = (box_extents - local_pos) / nrdir;
2057 | 			vec3 rbmin = (-box_extents - local_pos) / nrdir;
2058 | 
2059 | 			vec3 rbminmax = mix(rbmin, rbmax, greaterThan(nrdir, vec3(0.0, 0.0, 0.0)));
2060 | 
2061 | 			float fa = min(min(rbminmax.x, rbminmax.y), rbminmax.z);
2062 | 			vec3 posonbox = local_pos + nrdir * fa;
2063 | 			local_ref_vec = posonbox - reflections.data[ref_index].box_offset;
2064 | 		}
2065 | 
2066 | 		vec4 reflection;
2067 | 		float reflection_blend = max(0.0, blend - reflection_accum.a);
2068 | 
2069 | 		reflection.rgb = textureLod(samplerCubeArray(reflection_atlas, DEFAULT_SAMPLER_LINEAR_WITH_MIPMAPS_CLAMP), vec4(local_ref_vec, reflections.data[ref_index].index), sqrt(roughness) * MAX_ROUGHNESS_LOD).rgb * sc_luminance_multiplier();
2070 | 		reflection.rgb *= reflections.data[ref_index].exposure_normalization;
2071 | 		reflection.a = reflection_blend;
2072 | 
2073 | 		reflection.rgb *= reflections.data[ref_index].intensity;
2074 | 		reflection.rgb *= reflection.a;
2075 | 
2076 | 		reflection_accum += reflection;
2077 | 	}
2078 | 
2079 | 	if (ambient_accum.a >= 1.0) {
2080 | 		return;
2081 | 	}
2082 | 
2083 | 	switch (reflections.data[ref_index].ambient_mode) {
2084 | 		case REFLECTION_AMBIENT_DISABLED: {
2085 | 			
2086 | 		} break;
2087 | 		case REFLECTION_AMBIENT_ENVIRONMENT: {
2088 | 			vec3 local_amb_vec = (reflections.data[ref_index].local_matrix * vec4(normal, 0.0)).xyz;
2089 | 			vec4 ambient_out;
2090 | 			float ambient_blend = max(0.0, blend - ambient_accum.a);
2091 | 
2092 | 			ambient_out.rgb = textureLod(samplerCubeArray(reflection_atlas, DEFAULT_SAMPLER_LINEAR_WITH_MIPMAPS_CLAMP), vec4(local_amb_vec, reflections.data[ref_index].index), MAX_ROUGHNESS_LOD).rgb;
2093 | 			ambient_out.rgb *= reflections.data[ref_index].exposure_normalization;
2094 | 			ambient_out.a = ambient_blend;
2095 | 			ambient_out.rgb *= ambient_out.a;
2096 | 			ambient_accum += ambient_out;
2097 | 		} break;
2098 | 		case REFLECTION_AMBIENT_COLOR: {
2099 | 			vec4 ambient_out;
2100 | 			float ambient_blend = max(0.0, blend - ambient_accum.a);
2101 | 
2102 | 			ambient_out.rgb = reflections.data[ref_index].ambient;
2103 | 			ambient_out.a = ambient_blend;
2104 | 			ambient_out.rgb *= ambient_out.a;
2105 | 			ambient_accum += ambient_out;
2106 | 		} break;
2107 | 	}
2108 | }
