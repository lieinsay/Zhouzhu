1421 | 
1422 | 	
1423 | 	if (sc_soft_shadow_samples() == 0) {
1424 | 		return textureProj(sampler2DShadow(shadow, shadow_sampler), vec4(pos, depth, 1.0));
1425 | 	}
1426 | 
1427 | 	mat2 disk_rotation;
1428 | 	{
1429 | 		float r = quick_hash(gl_FragCoord.xy + vec2(taa_frame_count * 5.588238)) * 2.0 * M_PI;
1430 | 		float sr = sin(r);
1431 | 		float cr = cos(r);
1432 | 		disk_rotation = mat2(vec2(cr, -sr), vec2(sr, cr));
1433 | 	}
1434 | 
1435 | 	float avg = 0.0;
1436 | 
1437 | 	SPEC_CONSTANT_LOOP_ANNOTATION
1438 | 	for (uint i = 0; i < sc_soft_shadow_samples(); i++) {
1439 | 		avg += textureProj(sampler2DShadow(shadow, shadow_sampler), vec4(pos + shadow_pixel_size * (disk_rotation * scene_data_block.data.soft_shadow_kernel[i].xy), depth, 1.0));
1440 | 	}
1441 | 
1442 | 	return avg * (1.0 / float(sc_soft_shadow_samples()));
