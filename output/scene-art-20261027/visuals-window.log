1426 | 
1427 | 	mat2 disk_rotation;
1428 | 	{
1429 | 		float r = quick_hash(gl_FragCoord.xy + vec2(taa_frame_count * 5.588238)) * 2.0 * M_PI;
1430 | 		float sr = sin(r);
1431 | 		float cr = cos(r);
