1660 | 
1661 | 				SPEC_CONSTANT_LOOP_ANNOTATION
1662 | 				for (uint i = 0; i < sc_penumbra_shadow_samples(); i++) {
1663 | 					vec2 disk = disk_rotation * scene_data_block.data.penumbra_shadow_kernel[i].xy;
