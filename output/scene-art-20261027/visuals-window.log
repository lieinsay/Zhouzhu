1543 | void light_process_omni(uint idx, vec3 vertex, vec3 eye_vec, vec3 normal, vec3 vertex_ddx, vec3 vertex_ddy, vec3 f0, uint orms, float taa_frame_count, vec3 albedo, inout float alpha, vec2 screen_uv,
1544 | #ifdef LIGHT_BACKLIGHT_USED
1545 | 		vec3 backlight,
1546 | #endif
1547 | #ifdef LIGHT_TRANSMITTANCE_USED
1548 | 		vec4 transmittance_color,
1549 | 		float transmittance_depth,
1550 | 		float transmittance_boost,
1551 | #endif
1552 | #ifdef LIGHT_RIM_USED
1553 | 		float rim, float rim_tint,
1554 | #endif
1555 | #ifdef LIGHT_CLEARCOAT_USED
1556 | 		float clearcoat, float clearcoat_roughness, vec3 vertex_normal,
1557 | #endif
1558 | #ifdef LIGHT_ANISOTROPY_USED
