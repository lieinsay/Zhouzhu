1420 | 	
1421 | 	if (sc_soft_shadow_samples() == 0) {
1422 | 		return textureProj(sampler2DShadow(shadow, shadow_sampler), vec4(pos, depth, 1.0));
1423 | 	}
1424 | 
1425 | 	mat2 disk_rotation;
1426 | 	{
1427 | 		float r = quick_hash(gl_FragCoord.xy + vec2(taa_frame_count * 5.588238)) * 2.0 * M_PI;
1428 | 		float sr = sin(r);
1429 | 		float cr = cos(r);
1430 | 		disk_rotation = mat2(vec2(cr, -sr), vec2(sr, cr));
1431 | 	}
1432 | 
1433 | 	float avg = 0.0;
1434 | 
1435 | 	SPEC_CONSTANT_LOOP_ANNOTATION
1436 | 	for (uint i = 0; i < sc_soft_shadow_samples(); i++) {
1437 | 		avg += textureProj(sampler2DShadow(shadow, shadow_sampler), vec4(pos + shadow_pixel_size * (disk_rotation * scene_data_block.data.soft_shadow_kernel[i].xy), depth, 1.0));
1438 | 	}
1439 | 
1440 | 	return avg * (1.0 / float(sc_soft_shadow_samples()));
