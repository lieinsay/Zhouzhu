1445 | float sample_omni_pcf_shadow(texture2D shadow, float blur_scale, vec2 coord, vec4 uv_rect, vec2 flip_offset, float depth, float taa_frame_count) {
1446 | 	
1447 | 	if (sc_soft_shadow_samples() == 0) {
1448 | 		vec2 pos = coord * 0.5 + 0.5;
1449 | 		pos = uv_rect.xy + pos * uv_rect.zw;
1450 | 		return textureProj(sampler2DShadow(shadow, shadow_sampler), vec4(pos, depth, 1.0));
1451 | 	}
1452 | 
1453 | 	mat2 disk_rotation;
1454 | 	{
1455 | 		float r = quick_hash(gl_FragCoord.xy + vec2(taa_frame_count * 5.588238)) * 2.0 * M_PI;
1456 | 		float sr = sin(r);
1457 | 		float cr = cos(r);
1458 | 		disk_rotation = mat2(vec2(cr, -sr), vec2(sr, cr));
1459 | 	}
1460 | 
1461 | 	float avg = 0.0;
1462 | 	vec2 offset_scale = blur_scale * 2.0 * scene_data_block.data.shadow_atlas_pixel_size / uv_rect.zw;
1463 | 
1464 | 	SPEC_CONSTANT_LOOP_ANNOTATION
1465 | 	for (uint i = 0; i < sc_soft_shadow_samples(); i++) {
1466 | 		vec2 offset = offset_scale * (disk_rotation * scene_data_block.data.soft_shadow_kernel[i].xy);
1467 | 		vec2 sample_coord = coord + offset;
1468 | 
1469 | 		float sample_coord_length_squared = dot(sample_coord, sample_coord);
1470 | 		bool do_flip = sample_coord_length_squared > 1.0;
1471 | 
1472 | 		if (do_flip) {
1473 | 			float len = sqrt(sample_coord_length_squared);
1474 | 			sample_coord = sample_coord * (2.0 / len - 1.0);
1475 | 		}
1476 | 
1477 | 		sample_coord = sample_coord * 0.5 + 0.5;
1478 | 		sample_coord = uv_rect.xy + sample_coord * uv_rect.zw;
1479 | 
1480 | 		if (do_flip) {
1481 | 			sample_coord += flip_offset;
1482 | 		}
1483 | 		avg += textureProj(sampler2DShadow(shadow, shadow_sampler), vec4(sample_coord, depth, 1.0));
1484 | 	}
1485 | 
1486 | 	return avg * (1.0 / float(sc_soft_shadow_samples()));
1487 | }
