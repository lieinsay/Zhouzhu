 665 | vec4 normal_roughness_compatibility(vec4 p_normal_roughness) {
 666 | 	float roughness = p_normal_roughness.w;
 667 | 	if (roughness > 0.5) {
 668 | 		roughness = 1.0 - roughness;
 669 | 	}
 670 | 	roughness /= (127.0 / 255.0);
 671 | 	return vec4(normalize(p_normal_roughness.xyz * 2.0 - 1.0) * 0.5 + 0.5, roughness);
 672 | }
