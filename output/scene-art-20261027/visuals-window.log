1584 | 		base_uv_rect.xy += texel_size;
1585 | 		base_uv_rect.zw -= texel_size * 2.0;
1586 | 
1587 | 		
1588 | 		vec2 flip_offset = omni_lights.data[idx].direction.xy;
1589 | 
1590 | 		vec3 local_vert = (omni_lights.data[idx].shadow_matrix * vec4(vertex, 1.0)).xyz;
1591 | 
1592 | 		float shadow_len = length(local_vert); 
