1120 | float compute_alpha_antialiasing_edge(float input_alpha, vec2 texture_coord, float alpha_edge) {
1121 | 	input_alpha *= 1.0 + max(0, calc_mip_level(texture_coord)) * 0.25; 
1122 | 	input_alpha = (input_alpha - alpha_edge) / max(fwidth(input_alpha), 0.0001) + 0.5;
1123 | 	return clamp(input_alpha, 0.0, 1.0);
