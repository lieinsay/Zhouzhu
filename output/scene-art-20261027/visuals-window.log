 666 | vec4 normal_roughness_compatibility(vec4 p_normal_roughness) {
 667 | 	float roughness = p_normal_roughness.w;
 668 | 	if (roughness > 0.5) {
 669 | 		roughness = 1.0 - roughness;
 670 | 	}
 671 | 	roughness /= (127.0 / 255.0);
 672 | 	return vec4(normalize(p_normal_roughness.xyz * 2.0 - 1.0) * 0.5 + 0.5, roughness);
 673 | }
