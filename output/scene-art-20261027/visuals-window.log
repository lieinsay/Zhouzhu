2134 | vec4 voxel_cone_trace(texture3D probe, vec3 cell_size, vec3 pos, vec3 direction, float tan_half_angle, float max_distance, float p_bias) {
2135 | 	float dist = p_bias;
2136 | 	vec4 color = vec4(0.0);
2137 | 
2138 | 	while (dist < max_distance && color.a < 0.95) {
2139 | 		float diameter = max(1.0, 2.0 * tan_half_angle * dist);
2140 | 		vec3 uvw_pos = (pos + dist * direction) * cell_size;
2141 | 		float half_diameter = diameter * 0.5;
2142 | 		
2143 | 		if (any(greaterThan(abs(uvw_pos - 0.5), vec3(0.5f + half_diameter * cell_size)))) {
2144 | 			break;
2145 | 		}
2146 | 		vec4 scolor = textureLod(sampler3D(probe, DEFAULT_SAMPLER_LINEAR_WITH_MIPMAPS_CLAMP), uvw_pos, log2(diameter));
2147 | 		float a = (1.0 - color.a);
2148 | 		color += a * scolor;
2149 | 		dist += half_diameter;
2150 | 	}
2151 | 
2152 | 	return color;
2153 | }
2154 | 
2155 | vec4 voxel_cone_trace_45_degrees(texture3D probe, vec3 cell_size, vec3 pos, vec3 direction, float tan_half_angle, float max_distance, float p_bias) {
2156 | 	float dist = p_bias;
2157 | 	vec4 color = vec4(0.0);
2158 | 	float radius = max(0.5, tan_half_angle * dist);
2159 | 	float lod_level = log2(radius * 2.0);
2160 | 
2161 | 	while (dist < max_distance && color.a < 0.95) {
2162 | 		vec3 uvw_pos = (pos + dist * direction) * cell_size;
2163 | 
2164 | 		
2165 | 		if (any(greaterThan(abs(uvw_pos - 0.5), vec3(0.5f + radius * cell_size)))) {
2166 | 			break;
2167 | 		}
2168 | 		vec4 scolor = textureLod(sampler3D(probe, DEFAULT_SAMPLER_LINEAR_WITH_MIPMAPS_CLAMP), uvw_pos, lod_level);
2169 | 		lod_level += 1.0;
2170 | 
2171 | 		float a = (1.0 - color.a);
2172 | 		scolor *= a;
2173 | 		color += scolor;
2174 | 		dist += radius;
2175 | 		radius = max(0.5, tan_half_angle * dist);
2176 | 	}
2177 | 
2178 | 	return color;
2179 | }
