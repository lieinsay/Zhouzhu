2183 | void voxel_gi_compute(uint index, vec3 position, vec3 normal, vec3 ref_vec, mat3 normal_xform, float roughness, vec3 ambient, vec3 environment, inout vec4 out_spec, inout vec4 out_diff) {
2184 | 	position = (voxel_gi_instances.data[index].xform * vec4(position, 1.0)).xyz;
2185 | 	ref_vec = normalize((voxel_gi_instances.data[index].xform * vec4(ref_vec, 0.0)).xyz);
2186 | 	normal = normalize((voxel_gi_instances.data[index].xform * vec4(normal, 0.0)).xyz);
2187 | 
2188 | 	position += normal * voxel_gi_instances.data[index].normal_bias;
2189 | 
2190 | 	
2191 | 	if (any(bvec2(any(lessThan(position, vec3(0.0))), any(greaterThan(position, voxel_gi_instances.data[index].bounds))))) {
2192 | 		return;
2193 | 	}
2194 | 
2195 | 	vec3 blendv = abs(position / voxel_gi_instances.data[index].bounds * 2.0 - 1.0);
2196 | 	float blend = clamp(1.0 - max(blendv.x, max(blendv.y, blendv.z)), 0.0, 1.0);
2197 | 	
2198 | 
2199 | 	float max_distance = length(voxel_gi_instances.data[index].bounds);
2200 | 	vec3 cell_size = 1.0 / voxel_gi_instances.data[index].bounds;
2201 | 
2202 | 	
2203 | 
2204 | #define MAX_CONE_DIRS 4
2205 | 
2206 | 	vec3 cone_dirs[MAX_CONE_DIRS] = vec3[](
2207 | 			vec3(0.707107, 0.0, 0.707107),
2208 | 			vec3(0.0, 0.707107, 0.707107),
2209 | 			vec3(-0.707107, 0.0, 0.707107),
2210 | 			vec3(0.0, -0.707107, 0.707107));
2211 | 
2212 | 	float cone_weights[MAX_CONE_DIRS] = float[](0.25, 0.25, 0.25, 0.25);
2213 | 	float cone_angle_tan = 0.98269;
2214 | 
2215 | 	vec3 light = vec3(0.0);
2216 | 
2217 | 	for (int i = 0; i < MAX_CONE_DIRS; i++) {
2218 | 		vec3 dir = normalize((voxel_gi_instances.data[index].xform * vec4(normal_xform * cone_dirs[i], 0.0)).xyz);
2219 | 
2220 | 		vec4 cone_light = voxel_cone_trace_45_degrees(voxel_gi_textures[index], cell_size, position, dir, cone_angle_tan, max_distance, voxel_gi_instances.data[index].bias);
2221 | 
2222 | 		if (voxel_gi_instances.data[index].blend_ambient) {
2223 | 			cone_light.rgb = mix(ambient, cone_light.rgb, min(1.0, cone_light.a / 0.95));
2224 | 		}
2225 | 
2226 | 		light += cone_weights[i] * cone_light.rgb;
2227 | 	}
2228 | 
2229 | 	light *= voxel_gi_instances.data[index].dynamic_range * voxel_gi_instances.data[index].exposure_normalization;
2230 | 	out_diff += vec4(light * blend, blend);
2231 | 
2232 | 	
2233 | 	vec4 irr_light = voxel_cone_trace(voxel_gi_textures[index], cell_size, position, ref_vec, tan(roughness * 0.5 * M_PI * 0.99), max_distance, voxel_gi_instances.data[index].bias);
2234 | 	if (voxel_gi_instances.data[index].blend_ambient) {
2235 | 		irr_light.rgb = mix(environment, irr_light.rgb, min(1.0, irr_light.a / 0.95));
2236 | 	}
2237 | 	irr_light.rgb *= voxel_gi_instances.data[index].dynamic_range * voxel_gi_instances.data[index].exposure_normalization;
2238 | 	
2239 | 
2240 | 	out_spec += vec4(irr_light.rgb * blend, blend);
2241 | }
