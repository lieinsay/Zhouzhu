1390 | float sample_directional_pcf_shadow(texture2D shadow, vec2 shadow_pixel_size, vec4 coord, float taa_frame_count) {
1391 | 	vec2 pos = coord.xy;
1392 | 	float depth = coord.z;
1393 | 
1394 | 	
1395 | 	if (sc_directional_soft_shadow_samples() == 0) {
1396 | 		return textureProj(sampler2DShadow(shadow, shadow_sampler), vec4(pos, depth, 1.0));
1397 | 	}
1398 | 
1399 | 	mat2 disk_rotation;
1400 | 	{
1401 | 		float r = quick_hash(gl_FragCoord.xy + vec2(taa_frame_count * 5.588238)) * 2.0 * M_PI;
1402 | 		float sr = sin(r);
1403 | 		float cr = cos(r);
1404 | 		disk_rotation = mat2(vec2(cr, -sr), vec2(sr, cr));
1405 | 	}
1406 | 
1407 | 	float avg = 0.0;
1408 | 
1409 | 	SPEC_CONSTANT_LOOP_ANNOTATION
1410 | 	for (uint i = 0; i < sc_directional_soft_shadow_samples(); i++) {
1411 | 		avg += textureProj(sampler2DShadow(shadow, shadow_sampler), vec4(pos + shadow_pixel_size * (disk_rotation * scene_data_block.data.directional_soft_shadow_kernel[i].xy), depth, 1.0));
1412 | 	}
1413 | 
1414 | 	return avg * (1.0 / float(sc_directional_soft_shadow_samples()));
1415 | }
