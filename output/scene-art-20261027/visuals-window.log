1130 | #if !defined(MODE_RENDER_DEPTH) && !defined(MODE_UNSHADED)
1131 | 
1132 | 
1133 | #if !defined(SPECULAR_DISABLED) && !defined(SPECULAR_SCHLICK_GGX) && !defined(SPECULAR_TOON)
