 765 | 	float g1x = g1(fuv.x);
 766 | 	float h0x = h0(fuv.x);
 767 | 	float h1x = h1(fuv.x);
 768 | 	float h0y = h0(fuv.y);
 769 | 	float h1y = h1(fuv.y);
