1532 | float get_omni_attenuation(float distance, float inv_range, float decay) {
1533 | 	float nd = distance * inv_range;
1534 | 	nd *= nd;
1535 | 	nd *= nd; 
1536 | 	nd = max(1.0 - nd, 0.0);
1537 | 	nd *= nd; 
1538 | 	return nd * pow(max(distance, 0.0001), -decay);
1539 | }
