2388 | 
2389 | 	if (scene_data_block.data.fog_aerial_perspective > 0.0) {
2390 | 		vec3 sky_fog_color = vec3(0.0);
2391 | 		vec3 cube_view = scene_data_block.data.radiance_inverse_xform * vertex;
2392 | 		
2393 | 		float mip_level = mix(1.0 / MAX_ROUGHNESS_LOD, 1.0, 1.0 - (abs(vertex.z) - scene_data_block.data.z_near) / (scene_data_block.data.z_far - scene_data_block.data.z_near));
2394 | #ifdef USE_RADIANCE_CUBEMAP_ARRAY
2395 | 		float lod, blend;
2396 | 		blend = modf(mip_level * MAX_ROUGHNESS_LOD, lod);
2397 | 		sky_fog_color = texture(samplerCubeArray(radiance_cubemap, DEFAULT_SAMPLER_LINEAR_WITH_MIPMAPS_CLAMP), vec4(cube_view, lod)).rgb;
2398 | 		sky_fog_color = mix(sky_fog_color, texture(samplerCubeArray(radiance_cubemap, DEFAULT_SAMPLER_LINEAR_WITH_MIPMAPS_CLAMP), vec4(cube_view, lod + 1)).rgb, blend);
