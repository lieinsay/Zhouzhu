1317 | #else
1318 | 			
1319 | 			diffuse_brdf_NL = cNdotL * (1.0 / M_PI);
1320 | #endif
1321 | 
1322 | 			diffuse_light += light_color * diffuse_brdf_NL * attenuation;
1323 | 
1324 | #if defined(LIGHT_BACKLIGHT_USED)
