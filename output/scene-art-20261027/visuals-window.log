1152 | #endif
1153 | 
1154 | float D_GGX(float cos_theta_m, float alpha) {
1155 | 	float a = cos_theta_m * alpha;
1156 | 	float k = alpha / (1.0 - cos_theta_m * cos_theta_m + a * a);
1157 | 	return k * k * (1.0 / M_PI);
1158 | }
1159 | 
1160 | 
1161 | float V_GGX(float NdotL, float NdotV, float alpha) {
1162 | 	return 0.5 / mix(2.0 * NdotL * NdotV, NdotL + NdotV, alpha);
1163 | }
1164 | 
1165 | float D_GGX_anisotropic(float cos_theta_m, float alpha_x, float alpha_y, float cos_phi, float sin_phi) {
1166 | 	float alpha2 = alpha_x * alpha_y;
1167 | 	highp vec3 v = vec3(alpha_y * cos_phi, alpha_x * sin_phi, alpha2 * cos_theta_m);
1168 | 	highp float v2 = dot(v, v);
1169 | 	float w2 = alpha2 / v2;
1170 | 	float D = alpha2 * w2 * w2 * (1.0 / M_PI);
1171 | 	return D;
1172 | }
1173 | 
1174 | float V_GGX_anisotropic(float alpha_x, float alpha_y, float TdotV, float TdotL, float BdotV, float BdotL, float NdotV, float NdotL) {
1175 | 	float Lambda_V = NdotL * length(vec3(alpha_x * TdotV, alpha_y * BdotV, NdotV));
1176 | 	float Lambda_L = NdotV * length(vec3(alpha_x * TdotL, alpha_y * BdotL, NdotL));
1177 | 	return 0.5 / (Lambda_V + Lambda_L);
1178 | }
1179 | 
1180 | float SchlickFresnel(float u) {
1181 | 	float m = 1.0 - u;
1182 | 	float m2 = m * m;
1183 | 	return m2 * m2 * m; 
1184 | }
1185 | 
1186 | vec3 F0(float metallic, float specular, vec3 albedo) {
1187 | 	float dielectric = 0.16 * specular * specular;
1188 | 	
1189 | 	
1190 | 	return mix(vec3(dielectric), albedo, vec3(metallic));
1191 | }
