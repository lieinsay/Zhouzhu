2390 | vec4 fog_process(vec3 vertex) {
2391 | 	vec3 fog_color = scene_data_block.data.fog_light_color;
2392 | 
2393 | 	if (scene_data_block.data.fog_aerial_perspective > 0.0) {
2394 | 		vec3 sky_fog_color = vec3(0.0);
2395 | 		vec3 cube_view = scene_data_block.data.radiance_inverse_xform * vertex;
2396 | 		
2397 | 		float mip_level = mix(1.0 / MAX_ROUGHNESS_LOD, 1.0, 1.0 - (abs(vertex.z) - scene_data_block.data.z_near) / (scene_data_block.data.z_far - scene_data_block.data.z_near));
2398 | #ifdef USE_RADIANCE_CUBEMAP_ARRAY
2399 | 		float lod, blend;
2400 | 		blend = modf(mip_level * MAX_ROUGHNESS_LOD, lod);
2401 | 		sky_fog_color = texture(samplerCubeArray(radiance_cubemap, DEFAULT_SAMPLER_LINEAR_WITH_MIPMAPS_CLAMP), vec4(cube_view, lod)).rgb;
2402 | 		sky_fog_color = mix(sky_fog_color, texture(samplerCubeArray(radiance_cubemap, DEFAULT_SAMPLER_LINEAR_WITH_MIPMAPS_CLAMP), vec4(cube_view, lod + 1)).rgb, blend);
2403 | #else
2404 | 		sky_fog_color = textureLod(samplerCube(radiance_cubemap, DEFAULT_SAMPLER_LINEAR_WITH_MIPMAPS_CLAMP), cube_view, mip_level * MAX_ROUGHNESS_LOD).rgb;
2405 | #endif 
2406 | 		fog_color = mix(fog_color, sky_fog_color, scene_data_block.data.fog_aerial_perspective);
2407 | 	}
2408 | 
2409 | 	if (scene_data_block.data.fog_sun_scatter > 0.001) {
2410 | 		vec4 sun_scatter = vec4(0.0);
2411 | 		float sun_total = 0.0;
2412 | 		vec3 view = normalize(vertex);
2413 | 
2414 | 		for (uint i = 0; i < scene_data_block.data.directional_light_count; i++) {
2415 | 			vec3 light_color = directional_lights.data[i].color * directional_lights.data[i].energy;
2416 | 			float light_amount = pow(max(dot(view, directional_lights.data[i].direction), 0.0), 8.0);
2417 | 			fog_color += light_color * light_amount * scene_data_block.data.fog_sun_scatter;
2418 | 		}
2419 | 	}
2420 | 
2421 | 	float fog_amount = 0.0;
2422 | 
2423 | 	if (sc_use_depth_fog()) {
2424 | 		float fog_z = smoothstep(scene_data_block.data.fog_depth_begin, scene_data_block.data.fog_depth_end, length(vertex));
2425 | 		float fog_quad_amount = pow(fog_z, scene_data_block.data.fog_depth_curve) * scene_data_block.data.fog_density;
2426 | 		fog_amount = fog_quad_amount;
2427 | 	} else {
2428 | 		fog_amount = 1 - exp(min(0.0, -length(vertex) * scene_data_block.data.fog_density));
2429 | 	}
2430 | 
2431 | 	if (abs(scene_data_block.data.fog_height_density) >= 0.0001) {
2432 | 		float y = (scene_data_block.data.inv_view_matrix * vec4(vertex, 1.0)).y;
2433 | 
2434 | 		float y_dist = y - scene_data_block.data.fog_height;
2435 | 
2436 | 		float vfog_amount = 1.0 - exp(min(0.0, y_dist * scene_data_block.data.fog_height_density));
2437 | 
2438 | 		fog_amount = max(vfog_amount, fog_amount);
2439 | 	}
2440 | 
2441 | 	return vec4(fog_color, fog_amount);
2442 | }
