2183 | void voxel_gi_compute(uint index, vec3 position, vec3 normal, vec3 ref_vec, mat3 normal_xform, float roughness, vec3 ambient, vec3 environment, inout vec4 out_spec, inout vec4 out_diff) {
2184 | 	position = (voxel_gi_instances.data[index].xform * vec4(position, 1.0)).xyz;
