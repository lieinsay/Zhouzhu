2256 | void sdfgi_process(uint cascade, vec3 cascade_pos, vec3 cam_pos, vec3 cam_normal, vec3 cam_specular_normal, bool use_specular, float roughness, out vec3 diffuse_light, out vec3 specular_light, out float blend) {
2257 | 	cascade_pos += cam_normal * sdfgi.normal_bias;
2258 | 
2259 | 	vec3 base_pos = floor(cascade_pos);
2260 | 	
2261 | 	ivec3 probe_base_pos = ivec3(base_pos);
2262 | 
2263 | 	vec4 diffuse_accum = vec4(0.0);
2264 | 	vec3 specular_accum;
2265 | 
2266 | 	ivec3 tex_pos = ivec3(probe_base_pos.xy, int(cascade));
2267 | 	tex_pos.x += probe_base_pos.z * sdfgi.probe_axis_size;
2268 | 	tex_pos.xy = tex_pos.xy * (SDFGI_OCT_SIZE + 2) + ivec2(1);
2269 | 
2270 | 	vec3 diffuse_posf = (vec3(tex_pos) + vec3(octahedron_encode(cam_normal) * float(SDFGI_OCT_SIZE), 0.0)) * sdfgi.lightprobe_tex_pixel_size;
2271 | 
2272 | 	vec3 specular_posf;
2273 | 
2274 | 	if (use_specular) {
2275 | 		specular_accum = vec3(0.0);
2276 | 		specular_posf = (vec3(tex_pos) + vec3(octahedron_encode(cam_specular_normal) * float(SDFGI_OCT_SIZE), 0.0)) * sdfgi.lightprobe_tex_pixel_size;
2277 | 	}
2278 | 
2279 | 	vec4 light_accum = vec4(0.0);
2280 | 	float weight_accum = 0.0;
2281 | 
2282 | 	for (uint j = 0; j < 8; j++) {
2283 | 		ivec3 offset = (ivec3(j) >> ivec3(0, 1, 2)) & ivec3(1, 1, 1);
2284 | 		ivec3 probe_posi = probe_base_pos;
2285 | 		probe_posi += offset;
2286 | 
2287 | 		
2288 | 
2289 | 		vec3 probe_pos = vec3(probe_posi);
2290 | 		vec3 probe_to_pos = cascade_pos - probe_pos;
2291 | 		vec3 probe_dir = normalize(-probe_to_pos);
2292 | 
2293 | 		vec3 trilinear = vec3(1.0) - abs(probe_to_pos);
2294 | 		float weight = trilinear.x * trilinear.y * trilinear.z * max(0.005, dot(cam_normal, probe_dir));
2295 | 
2296 | 		
2297 | 
2298 | 		if (sdfgi.use_occlusion) {
2299 | 			ivec3 occ_indexv = abs((sdfgi.cascades[cascade].probe_world_offset + probe_posi) & ivec3(1, 1, 1)) * ivec3(1, 2, 4);
2300 | 			vec4 occ_mask = mix(vec4(0.0), vec4(1.0), equal(ivec4(occ_indexv.x | occ_indexv.y), ivec4(0, 1, 2, 3)));
2301 | 
2302 | 			vec3 occ_pos = clamp(cascade_pos, probe_pos - sdfgi.occlusion_clamp, probe_pos + sdfgi.occlusion_clamp) * sdfgi.probe_to_uvw;
2303 | 			occ_pos.z += float(cascade);
2304 | 			if (occ_indexv.z != 0) { 
2305 | 				occ_pos.x += 1.0;
2306 | 			}
2307 | 
2308 | 			occ_pos *= sdfgi.occlusion_renormalize;
2309 | 			float occlusion = dot(textureLod(sampler3D(sdfgi_occlusion_cascades, SAMPLER_LINEAR_CLAMP), occ_pos, 0.0), occ_mask);
2310 | 
2311 | 			weight *= max(occlusion, 0.01);
2312 | 		}
2313 | 
2314 | 		
2315 | 
2316 | 		vec3 diffuse;
2317 | 		vec3 pos_uvw = diffuse_posf;
2318 | 		pos_uvw.xy += vec2(offset.xy) * sdfgi.lightprobe_uv_offset.xy;
2319 | 		pos_uvw.x += float(offset.z) * sdfgi.lightprobe_uv_offset.z;
2320 | 		diffuse = textureLod(sampler2DArray(sdfgi_lightprobe_texture, SAMPLER_LINEAR_CLAMP), pos_uvw, 0.0).rgb;
2321 | 
2322 | 		diffuse_accum += vec4(diffuse * weight * sdfgi.cascades[cascade].exposure_normalization, weight);
2323 | 
2324 | 		if (use_specular) {
2325 | 			vec3 specular = vec3(0.0);
2326 | 			vec3 pos_uvw = specular_posf;
2327 | 			pos_uvw.xy += vec2(offset.xy) * sdfgi.lightprobe_uv_offset.xy;
2328 | 			pos_uvw.x += float(offset.z) * sdfgi.lightprobe_uv_offset.z;
2329 | 			if (roughness < 0.99) {
2330 | 				specular = textureLod(sampler2DArray(sdfgi_lightprobe_texture, SAMPLER_LINEAR_CLAMP), pos_uvw + vec3(0, 0, float(sdfgi.max_cascades)), 0.0).rgb;
2331 | 			}
2332 | 			if (roughness > 0.5) {
2333 | 				specular = mix(specular, textureLod(sampler2DArray(sdfgi_lightprobe_texture, SAMPLER_LINEAR_CLAMP), pos_uvw, 0.0).rgb, (roughness - 0.5) * 2.0);
2334 | 			}
2335 | 
2336 | 			specular_accum += specular * weight * sdfgi.cascades[cascade].exposure_normalization;
2337 | 		}
2338 | 	}
2339 | 
2340 | 	if (diffuse_accum.a > 0.0) {
2341 | 		diffuse_accum.rgb /= diffuse_accum.a;
2342 | 	}
2343 | 
2344 | 	diffuse_light = diffuse_accum.rgb;
2345 | 
2346 | 	if (use_specular) {
2347 | 		if (diffuse_accum.a > 0.0) {
2348 | 			specular_accum /= diffuse_accum.a;
2349 | 		}
2350 | 
2351 | 		specular_light = specular_accum;
2352 | 	}
2353 | 
2354 | 	{
2355 | 		
2356 | 		float blend_from = (float(sdfgi.probe_axis_size - 1) / 2.0) - 2.5;
2357 | 		float blend_to = blend_from + 2.0;
2358 | 
2359 | 		vec3 inner_pos = cam_pos * sdfgi.cascades[cascade].to_probe;
2360 | 
2361 | 		float len = length(inner_pos);
2362 | 
2363 | 		inner_pos = abs(normalize(inner_pos));
2364 | 		len *= max(inner_pos.x, max(inner_pos.y, inner_pos.z));
2365 | 
2366 | 		if (len >= blend_from) {
2367 | 			blend = smoothstep(blend_from, blend_to, len);
2368 | 		} else {
2369 | 			blend = 0.0;
2370 | 		}
2371 | 	}
2372 | }
2373 | 
2374 | #endif 
