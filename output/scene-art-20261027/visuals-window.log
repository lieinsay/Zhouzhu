2155 | 	float radius = max(0.5, tan_half_angle * dist);
2156 | 	float lod_level = log2(radius * 2.0);
2157 | 
2158 | 	while (dist < max_distance && color.a < 0.95) {
2159 | 		vec3 uvw_pos = (pos + dist * direction) * cell_size;
2160 | 
2161 | 		
2162 | 		if (any(greaterThan(abs(uvw_pos - 0.5), vec3(0.5f + radius * cell_size)))) {
2163 | 			break;
2164 | 		}
2165 | 		vec4 scolor = textureLod(sampler3D(probe, DEFAULT_SAMPLER_LINEAR_WITH_MIPMAPS_CLAMP), uvw_pos, lod_level);
2166 | 		lod_level += 1.0;
2167 | 
2168 | 		float a = (1.0 - color.a);
2169 | 		scolor *= a;
2170 | 		color += scolor;
2171 | 		dist += radius;
2172 | 		radius = max(0.5, tan_half_angle * dist);
2173 | 	}
2174 | 
2175 | 	return color;
2176 | }
