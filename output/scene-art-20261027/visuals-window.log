1488 | float sample_directional_soft_shadow(texture2D shadow, vec3 pssm_coord, vec2 tex_scale, float taa_frame_count) {
1489 | 	
1490 | 	float blocker_count = 0.0;
1491 | 	float blocker_average = 0.0;
1492 | 
1493 | 	mat2 disk_rotation;
1494 | 	{
1495 | 		float r = quick_hash(gl_FragCoord.xy + vec2(taa_frame_count * 5.588238)) * 2.0 * M_PI;
1496 | 		float sr = sin(r);
1497 | 		float cr = cos(r);
1498 | 		disk_rotation = mat2(vec2(cr, -sr), vec2(sr, cr));
1499 | 	}
1500 | 
1501 | 	SPEC_CONSTANT_LOOP_ANNOTATION
1502 | 	for (uint i = 0; i < sc_directional_penumbra_shadow_samples(); i++) {
1503 | 		vec2 suv = pssm_coord.xy + (disk_rotation * scene_data_block.data.directional_penumbra_shadow_kernel[i].xy) * tex_scale;
1504 | 		float d = textureLod(sampler2D(shadow, SAMPLER_LINEAR_CLAMP), suv, 0.0).r;
1505 | 		if (d > pssm_coord.z) {
1506 | 			blocker_average += d;
1507 | 			blocker_count += 1.0;
1508 | 		}
1509 | 	}
1510 | 
1511 | 	if (blocker_count > 0.0) {
1512 | 		
1513 | 		blocker_average /= blocker_count;
1514 | 		float penumbra = (-pssm_coord.z + blocker_average) / (1.0 - blocker_average);
1515 | 		tex_scale *= penumbra;
1516 | 
1517 | 		float s = 0.0;
1518 | 
1519 | 		SPEC_CONSTANT_LOOP_ANNOTATION
1520 | 		for (uint i = 0; i < sc_directional_penumbra_shadow_samples(); i++) {
1521 | 			vec2 suv = pssm_coord.xy + (disk_rotation * scene_data_block.data.directional_penumbra_shadow_kernel[i].xy) * tex_scale;
1522 | 			s += textureProj(sampler2DShadow(shadow, shadow_sampler), vec4(suv, pssm_coord.z, 1.0));
1523 | 		}
1524 | 
1525 | 		return s / float(sc_directional_penumbra_shadow_samples());
1526 | 
1527 | 	} else {
1528 | 		
1529 | 		return 1.0;
1530 | 	}
1531 | }
1532 | 
1533 | #endif 
