1656 | 				z_norm += omni_lights.data[idx].inv_radius * omni_lights.data[idx].shadow_bias;
1657 | 
1658 | 				shadow = 0.0;
1659 | 
1660 | 				SPEC_CONSTANT_LOOP_ANNOTATION
1661 | 				for (uint i = 0; i < sc_penumbra_shadow_samples(); i++) {
1662 | 					vec2 disk = disk_rotation * scene_data_block.data.penumbra_shadow_kernel[i].xy;
1663 | 					vec3 pos = local_vert + tangent * disk.x + bitangent * disk.y;
1664 | 
1665 | 					pos = normalize(pos);
1666 | 					pos = normalize(pos + normal_bias);
1667 | 
1668 | 					vec4 uv_rect = base_uv_rect;
1669 | 
1670 | 					if (pos.z >= 0.0) {
1671 | 						uv_rect.xy += flip_offset;
1672 | 					}
1673 | 
1674 | 					pos.z = 1.0 + abs(pos.z);
1675 | 					pos.xy /= pos.z;
1676 | 
1677 | 					pos.xy = pos.xy * 0.5 + 0.5;
1678 | 					pos.xy = uv_rect.xy + pos.xy * uv_rect.zw;
