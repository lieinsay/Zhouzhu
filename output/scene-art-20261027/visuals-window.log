2258 | void sdfgi_process(uint cascade, vec3 cascade_pos, vec3 cam_pos, vec3 cam_normal, vec3 cam_specular_normal, bool use_specular, float roughness, out vec3 diffuse_light, out vec3 specular_light, out float blend) {
2259 | 	cascade_pos += cam_normal * sdfgi.normal_bias;
2260 | 
2261 | 	vec3 base_pos = floor(cascade_pos);
2262 | 	
2263 | 	ivec3 probe_base_pos = ivec3(base_pos);
2264 | 
2265 | 	vec4 diffuse_accum = vec4(0.0);
2266 | 	vec3 specular_accum;
2267 | 
2268 | 	ivec3 tex_pos = ivec3(probe_base_pos.xy, int(cascade));
2269 | 	tex_pos.x += probe_base_pos.z * sdfgi.probe_axis_size;
2270 | 	tex_pos.xy = tex_pos.xy * (SDFGI_OCT_SIZE + 2) + ivec2(1);
2271 | 
2272 | 	vec3 diffuse_posf = (vec3(tex_pos) + vec3(octahedron_encode(cam_normal) * float(SDFGI_OCT_SIZE), 0.0)) * sdfgi.lightprobe_tex_pixel_size;
2273 | 
2274 | 	vec3 specular_posf;
2275 | 
2276 | 	if (use_specular) {
2277 | 		specular_accum = vec3(0.0);
2278 | 		specular_posf = (vec3(tex_pos) + vec3(octahedron_encode(cam_specular_normal) * float(SDFGI_OCT_SIZE), 0.0)) * sdfgi.lightprobe_tex_pixel_size;
2279 | 	}
2280 | 
2281 | 	vec4 light_accum = vec4(0.0);
2282 | 	float weight_accum = 0.0;
2283 | 
2284 | 	for (uint j = 0; j < 8; j++) {
2285 | 		ivec3 offset = (ivec3(j) >> ivec3(0, 1, 2)) & ivec3(1, 1, 1);
2286 | 		ivec3 probe_posi = probe_base_pos;
2287 | 		probe_posi += offset;
2288 | 
2289 | 		
2290 | 
2291 | 		vec3 probe_pos = vec3(probe_posi);
2292 | 		vec3 probe_to_pos = cascade_pos - probe_pos;
2293 | 		vec3 probe_dir = normalize(-probe_to_pos);
2294 | 
2295 | 		vec3 trilinear = vec3(1.0) - abs(probe_to_pos);
2296 | 		float weight = trilinear.x * trilinear.y * trilinear.z * max(0.005, dot(cam_normal, probe_dir));
2297 | 
2298 | 		
2299 | 
2300 | 		if (sdfgi.use_occlusion) {
2301 | 			ivec3 occ_indexv = abs((sdfgi.cascades[cascade].probe_world_offset + probe_posi) & ivec3(1, 1, 1)) * ivec3(1, 2, 4);
2302 | 			vec4 occ_mask = mix(vec4(0.0), vec4(1.0), equal(ivec4(occ_indexv.x | occ_indexv.y), ivec4(0, 1, 2, 3)));
2303 | 
2304 | 			vec3 occ_pos = clamp(cascade_pos, probe_pos - sdfgi.occlusion_clamp, probe_pos + sdfgi.occlusion_clamp) * sdfgi.probe_to_uvw;
2305 | 			occ_pos.z += float(cascade);
2306 | 			if (occ_indexv.z != 0) { 
2307 | 				occ_pos.x += 1.0;
2308 | 			}
2309 | 
2310 | 			occ_pos *= sdfgi.occlusion_renormalize;
2311 | 			float occlusion = dot(textureLod(sampler3D(sdfgi_occlusion_cascades, SAMPLER_LINEAR_CLAMP), occ_pos, 0.0), occ_mask);
2312 | 
2313 | 			weight *= max(occlusion, 0.01);
2314 | 		}
2315 | 
2316 | 		
2317 | 
2318 | 		vec3 diffuse;
2319 | 		vec3 pos_uvw = diffuse_posf;
2320 | 		pos_uvw.xy += vec2(offset.xy) * sdfgi.lightprobe_uv_offset.xy;
2321 | 		pos_uvw.x += float(offset.z) * sdfgi.lightprobe_uv_offset.z;
2322 | 		diffuse = textureLod(sampler2DArray(sdfgi_lightprobe_texture, SAMPLER_LINEAR_CLAMP), pos_uvw, 0.0).rgb;
2323 | 
2324 | 		diffuse_accum += vec4(diffuse * weight * sdfgi.cascades[cascade].exposure_normalization, weight);
2325 | 
2326 | 		if (use_specular) {
2327 | 			vec3 specular = vec3(0.0);
2328 | 			vec3 pos_uvw = specular_posf;
2329 | 			pos_uvw.xy += vec2(offset.xy) * sdfgi.lightprobe_uv_offset.xy;
2330 | 			pos_uvw.x += float(offset.z) * sdfgi.lightprobe_uv_offset.z;
2331 | 			if (roughness < 0.99) {
2332 | 				specular = textureLod(sampler2DArray(sdfgi_lightprobe_texture, SAMPLER_LINEAR_CLAMP), pos_uvw + vec3(0, 0, float(sdfgi.max_cascades)), 0.0).rgb;
2333 | 			}
2334 | 			if (roughness > 0.5) {
2335 | 				specular = mix(specular, textureLod(sampler2DArray(sdfgi_lightprobe_texture, SAMPLER_LINEAR_CLAMP), pos_uvw, 0.0).rgb, (roughness - 0.5) * 2.0);
2336 | 			}
2337 | 
2338 | 			specular_accum += specular * weight * sdfgi.cascades[cascade].exposure_normalization;
2339 | 		}
2340 | 	}
2341 | 
2342 | 	if (diffuse_accum.a > 0.0) {
2343 | 		diffuse_accum.rgb /= diffuse_accum.a;
2344 | 	}
2345 | 
2346 | 	diffuse_light = diffuse_accum.rgb;
2347 | 
2348 | 	if (use_specular) {
2349 | 		if (diffuse_accum.a > 0.0) {
2350 | 			specular_accum /= diffuse_accum.a;
2351 | 		}
2352 | 
2353 | 		specular_light = specular_accum;
2354 | 	}
2355 | 
2356 | 	{
2357 | 		
2358 | 		float blend_from = (float(sdfgi.probe_axis_size - 1) / 2.0) - 2.5;
2359 | 		float blend_to = blend_from + 2.0;
2360 | 
2361 | 		vec3 inner_pos = cam_pos * sdfgi.cascades[cascade].to_probe;
2362 | 
2363 | 		float len = length(inner_pos);
2364 | 
2365 | 		inner_pos = abs(normalize(inner_pos));
2366 | 		len *= max(inner_pos.x, max(inner_pos.y, inner_pos.z));
2367 | 
2368 | 		if (len >= blend_from) {
2369 | 			blend = smoothstep(blend_from, blend_to, len);
2370 | 		} else {
2371 | 			blend = 0.0;
2372 | 		}
2373 | 	}
2374 | }
2375 | 
