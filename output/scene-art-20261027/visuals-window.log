1537 | float get_omni_attenuation(float distance, float inv_range, float decay) {
1538 | 	float nd = distance * inv_range;
1539 | 	nd *= nd;
1540 | 	nd *= nd; 
1541 | 	nd = max(1.0 - nd, 0.0);
1542 | 	nd *= nd; 
1543 | 	return nd * pow(max(distance, 0.0001), -decay);
1544 | }
