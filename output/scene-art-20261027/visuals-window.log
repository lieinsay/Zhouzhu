2032 | void reflection_process(uint ref_index, vec3 vertex, vec3 ref_vec, vec3 normal, float roughness, vec3 ambient_light, vec3 specular_light, inout vec4 ambient_accum, inout vec4 reflection_accum) {
2033 | 	vec3 box_extents = reflections.data[ref_index].box_extents;
2034 | 	vec3 local_pos = (reflections.data[ref_index].local_matrix * vec4(vertex, 1.0)).xyz;
2035 | 
2036 | 	if (any(greaterThan(abs(local_pos), box_extents))) { 
2037 | 		return;
2038 | 	}
2039 | 
2040 | 	float blend = 1.0;
2041 | 	if (reflections.data[ref_index].blend_distance != 0.0) {
2042 | 		vec3 axis_blend_distance = min(vec3(reflections.data[ref_index].blend_distance), box_extents);
2043 | 		vec3 blend_axes = abs(local_pos) - box_extents + axis_blend_distance;
2044 | 		blend_axes /= axis_blend_distance;
2045 | 		blend_axes = clamp(1.0 - blend_axes, vec3(0.0), vec3(1.0));
2046 | 
2047 | 		blend = pow(blend_axes.x * blend_axes.y * blend_axes.z, 2.0);
2048 | 	}
2049 | 
2050 | 	if (reflections.data[ref_index].intensity > 0.0 && reflection_accum.a < 1.0) { 
2051 | 
2052 | 		vec3 local_ref_vec = (reflections.data[ref_index].local_matrix * vec4(ref_vec, 0.0)).xyz;
2053 | 
2054 | 		if (reflections.data[ref_index].box_project) { 
2055 | 
2056 | 			vec3 nrdir = normalize(local_ref_vec);
2057 | 			vec3 rbmax = (box_extents - local_pos) / nrdir;
2058 | 			vec3 rbmin = (-box_extents - local_pos) / nrdir;
2059 | 
2060 | 			vec3 rbminmax = mix(rbmin, rbmax, greaterThan(nrdir, vec3(0.0, 0.0, 0.0)));
2061 | 
2062 | 			float fa = min(min(rbminmax.x, rbminmax.y), rbminmax.z);
2063 | 			vec3 posonbox = local_pos + nrdir * fa;
2064 | 			local_ref_vec = posonbox - reflections.data[ref_index].box_offset;
2065 | 		}
2066 | 
2067 | 		vec4 reflection;
2068 | 		float reflection_blend = max(0.0, blend - reflection_accum.a);
2069 | 
2070 | 		reflection.rgb = textureLod(samplerCubeArray(reflection_atlas, DEFAULT_SAMPLER_LINEAR_WITH_MIPMAPS_CLAMP), vec4(local_ref_vec, reflections.data[ref_index].index), sqrt(roughness) * MAX_ROUGHNESS_LOD).rgb * sc_luminance_multiplier();
2071 | 		reflection.rgb *= reflections.data[ref_index].exposure_normalization;
2072 | 		reflection.a = reflection_blend;
2073 | 
2074 | 		reflection.rgb *= reflections.data[ref_index].intensity;
2075 | 		reflection.rgb *= reflection.a;
2076 | 
2077 | 		reflection_accum += reflection;
2078 | 	}
2079 | 
2080 | 	if (ambient_accum.a >= 1.0) {
2081 | 		return;
2082 | 	}
2083 | 
2084 | 	switch (reflections.data[ref_index].ambient_mode) {
2085 | 		case REFLECTION_AMBIENT_DISABLED: {
2086 | 			
2087 | 		} break;
2088 | 		case REFLECTION_AMBIENT_ENVIRONMENT: {
2089 | 			vec3 local_amb_vec = (reflections.data[ref_index].local_matrix * vec4(normal, 0.0)).xyz;
2090 | 			vec4 ambient_out;
2091 | 			float ambient_blend = max(0.0, blend - ambient_accum.a);
2092 | 
2093 | 			ambient_out.rgb = textureLod(samplerCubeArray(reflection_atlas, DEFAULT_SAMPLER_LINEAR_WITH_MIPMAPS_CLAMP), vec4(local_amb_vec, reflections.data[ref_index].index), MAX_ROUGHNESS_LOD).rgb;
2094 | 			ambient_out.rgb *= reflections.data[ref_index].exposure_normalization;
2095 | 			ambient_out.a = ambient_blend;
2096 | 			ambient_out.rgb *= ambient_out.a;
2097 | 			ambient_accum += ambient_out;
2098 | 		} break;
2099 | 		case REFLECTION_AMBIENT_COLOR: {
2100 | 			vec4 ambient_out;
2101 | 			float ambient_blend = max(0.0, blend - ambient_accum.a);
2102 | 
2103 | 			ambient_out.rgb = reflections.data[ref_index].ambient;
2104 | 			ambient_out.a = ambient_blend;
2105 | 			ambient_out.rgb *= ambient_out.a;
2106 | 			ambient_accum += ambient_out;
2107 | 		} break;
2108 | 	}
2109 | }
