1485 | float sample_directional_soft_shadow(texture2D shadow, vec3 pssm_coord, vec2 tex_scale, float taa_frame_count) {
1486 | 	
1487 | 	float blocker_count = 0.0;
1488 | 	float blocker_average = 0.0;
1489 | 
1490 | 	mat2 disk_rotation;
1491 | 	{
1492 | 		float r = quick_hash(gl_FragCoord.xy + vec2(taa_frame_count * 5.588238)) * 2.0 * M_PI;
1493 | 		float sr = sin(r);
1494 | 		float cr = cos(r);
1495 | 		disk_rotation = mat2(vec2(cr, -sr), vec2(sr, cr));
1496 | 	}
1497 | 
1498 | 	SPEC_CONSTANT_LOOP_ANNOTATION
1499 | 	for (uint i = 0; i < sc_directional_penumbra_shadow_samples(); i++) {
1500 | 		vec2 suv = pssm_coord.xy + (disk_rotation * scene_data_block.data.directional_penumbra_shadow_kernel[i].xy) * tex_scale;
1501 | 		float d = textureLod(sampler2D(shadow, SAMPLER_LINEAR_CLAMP), suv, 0.0).r;
1502 | 		if (d > pssm_coord.z) {
1503 | 			blocker_average += d;
1504 | 			blocker_count += 1.0;
1505 | 		}
1506 | 	}
1507 | 
1508 | 	if (blocker_count > 0.0) {
1509 | 		
1510 | 		blocker_average /= blocker_count;
1511 | 		float penumbra = (-pssm_coord.z + blocker_average) / (1.0 - blocker_average);
1512 | 		tex_scale *= penumbra;
1513 | 
1514 | 		float s = 0.0;
1515 | 
1516 | 		SPEC_CONSTANT_LOOP_ANNOTATION
1517 | 		for (uint i = 0; i < sc_directional_penumbra_shadow_samples(); i++) {
1518 | 			vec2 suv = pssm_coord.xy + (disk_rotation * scene_data_block.data.directional_penumbra_shadow_kernel[i].xy) * tex_scale;
1519 | 			s += textureProj(sampler2DShadow(shadow, shadow_sampler), vec4(suv, pssm_coord.z, 1.0));
1520 | 		}
1521 | 
1522 | 		return s / float(sc_directional_penumbra_shadow_samples());
1523 | 
1524 | 	} else {
1525 | 		
1526 | 		return 1.0;
1527 | 	}
1528 | }
1529 | 
1530 | #endif 
