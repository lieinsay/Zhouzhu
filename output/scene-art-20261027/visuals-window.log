1568 | 
1569 | 	
1570 | 	float size = 0.0;
1571 | 	if (sc_use_light_soft_shadows() && omni_lights.data[idx].size > 0.0) {
1572 | 		float t = omni_lights.data[idx].size / max(0.001, light_length);
1573 | 		size = max(0.0, 1.0 - 1 / sqrt(1 + t * t));
1574 | 	}
1575 | 
1576 | 	float shadow = 1.0;
1577 | #ifndef SHADOWS_DISABLED
1578 | 	
1579 | 	if (omni_attenuation > EPSILON && omni_lights.data[idx].shadow_opacity > 0.001) {
1580 | 		
1581 | 		vec2 texel_size = scene_data_block.data.shadow_atlas_pixel_size;
1582 | 		vec4 base_uv_rect = omni_lights.data[idx].atlas_rect;
1583 | 		base_uv_rect.xy += texel_size;
1584 | 		base_uv_rect.zw -= texel_size * 2.0;
1585 | 
1586 | 		
1587 | 		vec2 flip_offset = omni_lights.data[idx].direction.xy;
1588 | 
