1326 | #if defined(LIGHT_BACKLIGHT_USED)
1327 | 			diffuse_light += light_color * (vec3(1.0 / M_PI) - diffuse_brdf_NL) * backlight * attenuation;
1328 | #endif
1329 | 		}
1330 | 
1331 | 		if (roughness > 0.0) {
1332 | #if defined(SPECULAR_SCHLICK_GGX)
