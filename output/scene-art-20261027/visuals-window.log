1073 | #ifdef ALPHA_HASH_USED
1074 | 
1075 | float hash_2d(vec2 p) {
1076 | 	return fract(1.0e4 * sin(17.0 * p.x + 0.1 * p.y) *
1077 | 			(0.1 + abs(sin(13.0 * p.y + p.x))));
1078 | }
1079 | 
1080 | float hash_3d(vec3 p) {
1081 | 	return hash_2d(vec2(hash_2d(p.xy), p.z));
1082 | }
1083 | 
1084 | float compute_alpha_hash_threshold(vec3 pos, float hash_scale) {
1085 | 	vec3 dx = dFdx(pos);
1086 | 	vec3 dy = dFdy(pos);
1087 | 
1088 | 	float delta_max_sqr = max(length(dx), length(dy));
1089 | 	float pix_scale = 1.0 / (hash_scale * delta_max_sqr);
1090 | 
1091 | 	vec2 pix_scales =
1092 | 			vec2(exp2(floor(log2(pix_scale))), exp2(ceil(log2(pix_scale))));
1093 | 
1094 | 	vec2 a_thresh = vec2(hash_3d(floor(pix_scales.x * pos.xyz)),
1095 | 			hash_3d(floor(pix_scales.y * pos.xyz)));
1096 | 
1097 | 	float lerp_factor = fract(log2(pix_scale));
1098 | 
1099 | 	float a_interp = (1.0 - lerp_factor) * a_thresh.x + lerp_factor * a_thresh.y;
1100 | 
1101 | 	float min_lerp = min(lerp_factor, 1.0 - lerp_factor);
1102 | 
1103 | 	vec3 cases = vec3(a_interp * a_interp / (2.0 * min_lerp * (1.0 - min_lerp)),
1104 | 			(a_interp - 0.5 * min_lerp) / (1.0 - min_lerp),
1105 | 			1.0 - ((1.0 - a_interp) * (1.0 - a_interp) / (2.0 * min_lerp * (1.0 - min_lerp))));
1106 | 
1107 | 	float alpha_hash_threshold =
1108 | 			(a_interp < (1.0 - min_lerp)) ? ((a_interp < min_lerp) ? cases.x : cases.y) : cases.z;
1109 | 
1110 | 	return clamp(alpha_hash_threshold, 0.00001, 1.0);
1111 | }
1112 | 
1113 | #endif 
