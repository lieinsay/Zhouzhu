2178 | void voxel_gi_compute(uint index, vec3 position, vec3 normal, vec3 ref_vec, mat3 normal_xform, float roughness, vec3 ambient, vec3 environment, inout vec4 out_spec, inout vec4 out_diff) {
2179 | 	position = (voxel_gi_instances.data[index].xform * vec4(position, 1.0)).xyz;
2180 | 	ref_vec = normalize((voxel_gi_instances.data[index].xform * vec4(ref_vec, 0.0)).xyz);
2181 | 	normal = normalize((voxel_gi_instances.data[index].xform * vec4(normal, 0.0)).xyz);
2182 | 
2183 | 	position += normal * voxel_gi_instances.data[index].normal_bias;
2184 | 
2185 | 	
2186 | 	if (any(bvec2(any(lessThan(position, vec3(0.0))), any(greaterThan(position, voxel_gi_instances.data[index].bounds))))) {
2187 | 		return;
2188 | 	}
2189 | 
2190 | 	vec3 blendv = abs(position / voxel_gi_instances.data[index].bounds * 2.0 - 1.0);
2191 | 	float blend = clamp(1.0 - max(blendv.x, max(blendv.y, blendv.z)), 0.0, 1.0);
2192 | 	
2193 | 
2194 | 	float max_distance = length(voxel_gi_instances.data[index].bounds);
2195 | 	vec3 cell_size = 1.0 / voxel_gi_instances.data[index].bounds;
2196 | 
2197 | 	
2198 | 
2199 | #define MAX_CONE_DIRS 4
2200 | 
2201 | 	vec3 cone_dirs[MAX_CONE_DIRS] = vec3[](
2202 | 			vec3(0.707107, 0.0, 0.707107),
2203 | 			vec3(0.0, 0.707107, 0.707107),
2204 | 			vec3(-0.707107, 0.0, 0.707107),
2205 | 			vec3(0.0, -0.707107, 0.707107));
2206 | 
2207 | 	float cone_weights[MAX_CONE_DIRS] = float[](0.25, 0.25, 0.25, 0.25);
2208 | 	float cone_angle_tan = 0.98269;
2209 | 
2210 | 	vec3 light = vec3(0.0);
2211 | 
2212 | 	for (int i = 0; i < MAX_CONE_DIRS; i++) {
2213 | 		vec3 dir = normalize((voxel_gi_instances.data[index].xform * vec4(normal_xform * cone_dirs[i], 0.0)).xyz);
2214 | 
2215 | 		vec4 cone_light = voxel_cone_trace_45_degrees(voxel_gi_textures[index], cell_size, position, dir, cone_angle_tan, max_distance, voxel_gi_instances.data[index].bias);
2216 | 
2217 | 		if (voxel_gi_instances.data[index].blend_ambient) {
2218 | 			cone_light.rgb = mix(ambient, cone_light.rgb, min(1.0, cone_light.a / 0.95));
2219 | 		}
2220 | 
2221 | 		light += cone_weights[i] * cone_light.rgb;
2222 | 	}
2223 | 
2224 | 	light *= voxel_gi_instances.data[index].dynamic_range * voxel_gi_instances.data[index].exposure_normalization;
2225 | 	out_diff += vec4(light * blend, blend);
2226 | 
2227 | 	
2228 | 	vec4 irr_light = voxel_cone_trace(voxel_gi_textures[index], cell_size, position, ref_vec, tan(roughness * 0.5 * M_PI * 0.99), max_distance, voxel_gi_instances.data[index].bias);
2229 | 	if (voxel_gi_instances.data[index].blend_ambient) {
2230 | 		irr_light.rgb = mix(environment, irr_light.rgb, min(1.0, irr_light.a / 0.95));
2231 | 	}
2232 | 	irr_light.rgb *= voxel_gi_instances.data[index].dynamic_range * voxel_gi_instances.data[index].exposure_normalization;
2233 | 	
2234 | 
2235 | 	out_spec += vec4(irr_light.rgb * blend, blend);
2236 | }
