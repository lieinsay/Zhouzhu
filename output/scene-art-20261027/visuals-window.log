1182 | vec3 F0(float metallic, float specular, vec3 albedo) {
1183 | 	float dielectric = 0.16 * specular * specular;
1184 | 	
1185 | 	
1186 | 	return mix(vec3(dielectric), albedo, vec3(metallic));
