1716 | #ifndef SHADOWS_DISABLED
1717 | 	if (omni_lights.data[idx].shadow_opacity > 0.001) {
1718 | 		
1719 | 		vec2 texel_size = scene_data_block.data.shadow_atlas_pixel_size;
1720 | 		vec4 uv_rect = omni_lights.data[idx].atlas_rect;
