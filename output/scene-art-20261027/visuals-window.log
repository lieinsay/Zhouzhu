1334 | #endif
1335 | 			
1336 | 			
1337 | #if defined(SPECULAR_TOON)
1338 | 			vec3 R = normalize(-reflect(L, N));
1339 | 			float RdotV = dot(R, V);
1340 | 			float mid = 1.0 - roughness;
1341 | 			mid *= mid;
1342 | 			float intensity = smoothstep(mid - roughness * 0.5, mid + roughness * 0.5, RdotV) * mid;
