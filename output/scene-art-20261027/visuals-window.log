1599 | 
1600 | 		if (sc_use_light_soft_shadows() && omni_lights.data[idx].soft_shadow_size > 0.0) {
1601 | 			
1602 | 
1603 | 			
1604 | 
1605 | 			float blocker_count = 0.0;
1606 | 			float blocker_average = 0.0;
1607 | 
1608 | 			mat2 disk_rotation;
1609 | 			{
1610 | 				float r = quick_hash(gl_FragCoord.xy + vec2(taa_frame_count * 5.588238)) * 2.0 * M_PI;
1611 | 				float sr = sin(r);
1612 | 				float cr = cos(r);
1613 | 				disk_rotation = mat2(vec2(cr, -sr), vec2(sr, cr));
