2257 | void sdfgi_process(uint cascade, vec3 cascade_pos, vec3 cam_pos, vec3 cam_normal, vec3 cam_specular_normal, bool use_specular, float roughness, out vec3 diffuse_light, out vec3 specular_light, out float blend) {
2258 | 	cascade_pos += cam_normal * sdfgi.normal_bias;
2259 | 
2260 | 	vec3 base_pos = floor(cascade_pos);
2261 | 	
2262 | 	ivec3 probe_base_pos = ivec3(base_pos);
2263 | 
2264 | 	vec4 diffuse_accum = vec4(0.0);
2265 | 	vec3 specular_accum;
2266 | 
2267 | 	ivec3 tex_pos = ivec3(probe_base_pos.xy, int(cascade));
2268 | 	tex_pos.x += probe_base_pos.z * sdfgi.probe_axis_size;
2269 | 	tex_pos.xy = tex_pos.xy * (SDFGI_OCT_SIZE + 2) + ivec2(1);
2270 | 
2271 | 	vec3 diffuse_posf = (vec3(tex_pos) + vec3(octahedron_encode(cam_normal) * float(SDFGI_OCT_SIZE), 0.0)) * sdfgi.lightprobe_tex_pixel_size;
2272 | 
2273 | 	vec3 specular_posf;
2274 | 
2275 | 	if (use_specular) {
2276 | 		specular_accum = vec3(0.0);
2277 | 		specular_posf = (vec3(tex_pos) + vec3(octahedron_encode(cam_specular_normal) * float(SDFGI_OCT_SIZE), 0.0)) * sdfgi.lightprobe_tex_pixel_size;
2278 | 	}
2279 | 
2280 | 	vec4 light_accum = vec4(0.0);
2281 | 	float weight_accum = 0.0;
2282 | 
2283 | 	for (uint j = 0; j < 8; j++) {
2284 | 		ivec3 offset = (ivec3(j) >> ivec3(0, 1, 2)) & ivec3(1, 1, 1);
2285 | 		ivec3 probe_posi = probe_base_pos;
2286 | 		probe_posi += offset;
2287 | 
2288 | 		
2289 | 
2290 | 		vec3 probe_pos = vec3(probe_posi);
2291 | 		vec3 probe_to_pos = cascade_pos - probe_pos;
2292 | 		vec3 probe_dir = normalize(-probe_to_pos);
2293 | 
2294 | 		vec3 trilinear = vec3(1.0) - abs(probe_to_pos);
2295 | 		float weight = trilinear.x * trilinear.y * trilinear.z * max(0.005, dot(cam_normal, probe_dir));
2296 | 
2297 | 		
2298 | 
2299 | 		if (sdfgi.use_occlusion) {
2300 | 			ivec3 occ_indexv = abs((sdfgi.cascades[cascade].probe_world_offset + probe_posi) & ivec3(1, 1, 1)) * ivec3(1, 2, 4);
2301 | 			vec4 occ_mask = mix(vec4(0.0), vec4(1.0), equal(ivec4(occ_indexv.x | occ_indexv.y), ivec4(0, 1, 2, 3)));
2302 | 
2303 | 			vec3 occ_pos = clamp(cascade_pos, probe_pos - sdfgi.occlusion_clamp, probe_pos + sdfgi.occlusion_clamp) * sdfgi.probe_to_uvw;
2304 | 			occ_pos.z += float(cascade);
2305 | 			if (occ_indexv.z != 0) { 
2306 | 				occ_pos.x += 1.0;
2307 | 			}
2308 | 
2309 | 			occ_pos *= sdfgi.occlusion_renormalize;
2310 | 			float occlusion = dot(textureLod(sampler3D(sdfgi_occlusion_cascades, SAMPLER_LINEAR_CLAMP), occ_pos, 0.0), occ_mask);
2311 | 
2312 | 			weight *= max(occlusion, 0.01);
2313 | 		}
2314 | 
2315 | 		
2316 | 
2317 | 		vec3 diffuse;
2318 | 		vec3 pos_uvw = diffuse_posf;
2319 | 		pos_uvw.xy += vec2(offset.xy) * sdfgi.lightprobe_uv_offset.xy;
2320 | 		pos_uvw.x += float(offset.z) * sdfgi.lightprobe_uv_offset.z;
2321 | 		diffuse = textureLod(sampler2DArray(sdfgi_lightprobe_texture, SAMPLER_LINEAR_CLAMP), pos_uvw, 0.0).rgb;
2322 | 
2323 | 		diffuse_accum += vec4(diffuse * weight * sdfgi.cascades[cascade].exposure_normalization, weight);
2324 | 
2325 | 		if (use_specular) {
2326 | 			vec3 specular = vec3(0.0);
2327 | 			vec3 pos_uvw = specular_posf;
2328 | 			pos_uvw.xy += vec2(offset.xy) * sdfgi.lightprobe_uv_offset.xy;
2329 | 			pos_uvw.x += float(offset.z) * sdfgi.lightprobe_uv_offset.z;
2330 | 			if (roughness < 0.99) {
2331 | 				specular = textureLod(sampler2DArray(sdfgi_lightprobe_texture, SAMPLER_LINEAR_CLAMP), pos_uvw + vec3(0, 0, float(sdfgi.max_cascades)), 0.0).rgb;
2332 | 			}
2333 | 			if (roughness > 0.5) {
2334 | 				specular = mix(specular, textureLod(sampler2DArray(sdfgi_lightprobe_texture, SAMPLER_LINEAR_CLAMP), pos_uvw, 0.0).rgb, (roughness - 0.5) * 2.0);
2335 | 			}
2336 | 
2337 | 			specular_accum += specular * weight * sdfgi.cascades[cascade].exposure_normalization;
2338 | 		}
2339 | 	}
2340 | 
2341 | 	if (diffuse_accum.a > 0.0) {
2342 | 		diffuse_accum.rgb /= diffuse_accum.a;
2343 | 	}
2344 | 
2345 | 	diffuse_light = diffuse_accum.rgb;
2346 | 
2347 | 	if (use_specular) {
2348 | 		if (diffuse_accum.a > 0.0) {
2349 | 			specular_accum /= diffuse_accum.a;
2350 | 		}
2351 | 
2352 | 		specular_light = specular_accum;
2353 | 	}
2354 | 
2355 | 	{
2356 | 		
2357 | 		float blend_from = (float(sdfgi.probe_axis_size - 1) / 2.0) - 2.5;
2358 | 		float blend_to = blend_from + 2.0;
2359 | 
2360 | 		vec3 inner_pos = cam_pos * sdfgi.cascades[cascade].to_probe;
2361 | 
2362 | 		float len = length(inner_pos);
2363 | 
2364 | 		inner_pos = abs(normalize(inner_pos));
2365 | 		len *= max(inner_pos.x, max(inner_pos.y, inner_pos.z));
2366 | 
2367 | 		if (len >= blend_from) {
2368 | 			blend = smoothstep(blend_from, blend_to, len);
2369 | 		} else {
2370 | 			blend = 0.0;
2371 | 		}
2372 | 	}
2373 | }
2374 | 
