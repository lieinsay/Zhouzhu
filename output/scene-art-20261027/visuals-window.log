2240 | vec2 octahedron_wrap(vec2 v) {
2241 | 	vec2 signVal;
2242 | 	signVal.x = v.x >= 0.0 ? 1.0 : -1.0;
2243 | 	signVal.y = v.y >= 0.0 ? 1.0 : -1.0;
2244 | 	return (1.0 - abs(v.yx)) * signVal;
2245 | }
2246 | 
2247 | vec2 octahedron_encode(vec3 n) {
2248 | 	
2249 | 	n /= (abs(n.x) + abs(n.y) + abs(n.z));
2250 | 	n.xy = n.z >= 0.0 ? n.xy : octahedron_wrap(n.xy);
2251 | 	n.xy = n.xy * 0.5 + 0.5;
2252 | 	return n.xy;
2253 | }
