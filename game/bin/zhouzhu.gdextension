[configuration]

entry_symbol = "zhouzhu_library_init"
compatibility_minimum = "4.4"
reloadable = true

[libraries]

windows.debug.x86_64   = "res://bin/zhouzhu.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/zhouzhu.windows.template_release.x86_64.dll"
linux.debug.x86_64     = "res://bin/zhouzhu.linux.template_debug.x86_64.so"
linux.release.x86_64   = "res://bin/zhouzhu.linux.template_release.x86_64.so"
